<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Báo cáo Booking (Quản lý Booking)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Tổng quan</div>
    <a href="/ManageBooking/Dashboard" class="nav-item"><i class="ti ti-layout-dashboard"></i>Dashboard</a>

    <div class="nav-section">Nghiệp vụ Booking</div>
    <a href="/Campaigns" class="nav-item"><i class="ti ti-speakerphone"></i>Quản lý chiến dịch</a>
    <a href="/ManageBooking/KOL_KOC" class="nav-item"><i class="ti ti-users-group"></i>Cơ sở dữ liệu KOL/KOC</a>
    <a href="/ManageBooking/Booking" class="nav-item"><i class="ti ti-star"></i>Quản lý Booking &amp; Thù lao</a>
    <a href="/ManageBooking/StaffHuman" class="nav-item"><i class="ti ti-checklist"></i>Nhân viên &amp; Giao việc</a>
    <a href="/ManageBooking/Reported" class="nav-item active"><i class="ti ti-report-analytics"></i>Báo cáo Booking</a>
    <partial name="_UserMenuPartial" />
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Báo cáo &amp; Thống kê doanh số Booking</div>
        <div class="page-sub">Biểu đồ phân tích tài chính phòng Booking, chi phí deal KOL và tỷ lệ hoàn thành KPI nhân sự</div>
      </div>
      <div class="topbar-actions">
        <button class="icon-btn" onclick="alert('Đã tải xuống báo cáo doanh số Booking!')"><i class="ti ti-download"></i></button>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-head">
          <div class="card-title">Doanh thu &amp; Chi phí Booking 6 tháng qua (VND)</div>
        </div>
        <div style="position:relative; height:220px;">
          <canvas id="financeChart"></canvas>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <div class="card-title">Hiệu suất hoàn thành chiến dịch phòng Booking (%)</div>
        </div>
        <div style="position:relative; height:220px;">
          <canvas id="efficiencyChart"></canvas>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top: 16px;">
      <div class="card-head">
        <div class="card-title">Bảng kê chi tiết tài chính theo chiến dịch</div>
      </div>
      <table>
        <thead>
          <tr>
            <th>Chiến dịch</th>
            <th>Doanh thu nhận từ Client</th>
            <th>Phí deal KOL (Chi phí)</th>
            <th>Lợi nhuận gộp</th>
            <th>Thực tế thù lao chia cho team</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Vinamilk — Tết Sum Vầy 2027</strong></td>
            <td>10,000,000 đ</td>
            <td>4,000,000 đ</td>
            <td style="color:var(--green); font-weight:600;">6,000,000 đ</td>
            <td>10,000,000 đ (Đã phân bổ)</td>
          </tr>
          <tr>
            <td><strong>Traveloka — Mùa Hè Rực Rỡ</strong></td>
            <td>25,000,000 đ</td>
            <td>11,000,000 đ</td>
            <td style="color:var(--green); font-weight:600;">14,000,000 đ</td>
            <td>25,000,000 đ (Đã phân bổ)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <footer>HanaMedia · Dashboard Quản lý Booking — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
const finCtx = document.getElementById('financeChart');
new Chart(finCtx, {
  type: 'line',
  data: {
    labels: ['T3','T4','T5','T6','T7','T8'],
    datasets: [
      { label:'Doanh thu (trđ)', data:[1200, 1500, 1800, 2000, 2200, 2400], borderColor:'#1CA36B', tension:0.3 },
      { label:'Chi phí (trđ)', data:[500, 620, 750, 800, 910, 980], borderColor:'#DC4E4E', tension:0.3 }
    ]
  },
  options: {
    responsive:true, maintainAspectRatio:false
  }
});

const effCtx = document.getElementById('efficiencyChart');
new Chart(effCtx, {
  type: 'bar',
  data: {
    labels: ['T3','T4','T5','T6','T7','T8'],
    datasets: [{
      label: 'Tỷ lệ hoàn thành (%)',
      data: [90, 93, 89, 94, 91, 92],
      backgroundColor: '#2F80ED', borderRadius: 4
    }]
  },
  options: {
    responsive:true, maintainAspectRatio:false,
    scales:{ y:{ max: 100 } }
  }
});
</script>
</body>
</html>
