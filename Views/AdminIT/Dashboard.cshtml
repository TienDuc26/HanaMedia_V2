<!DOCTYPE html>
@model HanaMedia.ViewModels.AdminITDashboardViewModel
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Dashboard AdminIT</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body>
<div class="layout">

  <partial name="_SidebarPartial" />


  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Hệ thống Giám sát Kỹ thuật</div>
        <div class="page-sub">Trạng thái hạ tầng, người dùng đang hoạt động và nỗ lực truy cập mạng nội bộ</div>
      </div>
      <div class="topbar-actions">
        <div class="period-tabs">
          <a href="/AdminIT/Dashboard?period=today" class="period-tab @(Model.Period == "today" ? "active" : null)">Hôm nay</a>
          <a href="/AdminIT/Dashboard?period=week" class="period-tab @(Model.Period == "week" ? "active" : null)">Tuần này</a>
        </div>
        <a href="/AdminIT/AuditLog" class="icon-btn" aria-label="Mở nhật ký hệ thống"><i class="ti ti-bell"></i>@if (Model.SecurityAlertCount > 0) {<span class="dot"></span>}</a>
      </div>
    </div>

    <!-- KPI GRID -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Lượt đăng nhập hôm nay</div>
          <div class="kpi-icon" style="background:var(--blue-100); color:var(--blue-700);"><i class="ti ti-login-2"></i></div>
        </div>
        <div class="kpi-value">@Model.LoginCount</div>
        <div class="kpi-delta @(Model.IsLoginComparisonUp ? "up" : "down")"><i class="ti @(Model.IsLoginComparisonUp ? "ti-arrow-up-right" : "ti-arrow-down-right")"></i>@Model.LoginComparisonText</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Người dùng hoạt động</div>
          <div class="kpi-icon" style="background:var(--green-bg); color:var(--green);"><i class="ti ti-users"></i></div>
        </div>
        <div class="kpi-value">@Model.ActiveUserCount</div>
        <div class="kpi-note">Có đăng nhập trong @Model.PeriodLabel.ToLowerInvariant()</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Truy cập ngoài bị chặn</div>
          <div class="kpi-icon" style="background:var(--red-bg); color:var(--red);"><i class="ti ti-wifi-off"></i></div>
        </div>
        <div class="kpi-value">@Model.BlockedNetworkCount</div>
        <div class="kpi-delta down"><i class="ti ti-alert-triangle"></i>Whitelist IP đang kích hoạt</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Cảnh báo bảo mật</div>
          <div class="kpi-icon" style="background:var(--amber-bg); color:var(--amber);"><i class="ti ti-shield-alert"></i></div>
        </div>
        <div class="kpi-value">@Model.SecurityAlertCount</div>
        <div class="kpi-note">Cần xem xét nhật ký</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Trạng thái server</div>
          <div class="kpi-icon" style="background:var(--green-bg); color:var(--green);"><i class="ti ti-server"></i></div>
        </div>
        <div class="kpi-value" style="font-size:24px;">Đang chạy</div>
        <div class="kpi-note">Ứng dụng và DB phản hồi ổn định</div>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-head">
          <div class="card-title">Cảnh báo bảo mật cần xem xét</div>
        </div>
        @if (Model.SecurityAlerts.Count == 0)
        {
          <div class="alert-box" style="margin-top:0; background:var(--green-bg); border-color:#B9DFC4;">
            <i class="ti ti-shield-check" style="color:var(--green);"></i>
            <div>
              <div class="alert-title" style="color:var(--green);">Chưa phát hiện cảnh báo bảo mật</div>
              <div class="alert-desc">Không có tài khoản bị khóa tạm hoặc truy cập ngoài mạng trong @Model.PeriodLabel.ToLowerInvariant().</div>
            </div>
          </div>
        }
        else
        {
          @for (var alertIndex = 0; alertIndex < Model.SecurityAlerts.Count; alertIndex++)
          {
            var alert = Model.SecurityAlerts[alertIndex];
            <div class="alert-box" style="@(alertIndex == 0 ? "margin-top:0;" : null) @(alert.IsCritical ? "background:var(--red-bg); border-color:#F5C6CB;" : null)">
              <i class="ti @alert.Icon" style="color:@alert.Color;"></i>
              <div>
                <div class="alert-title" style="@(alert.IsCritical ? "color:#721C24;" : null)">@alert.Title</div>
                <div class="alert-desc" style="@(alert.IsCritical ? "color:#721C24;" : null)">@alert.Description</div>
              </div>
            </div>
          }
        }
      </div>

      <div class="card">
        <div class="card-head">
          <div class="card-title">Phiên hoạt động gần đây</div>
        </div>
        <table>
          <thead>
            <tr>
              <th>Người dùng</th>
              <th>Role</th>
              <th>IP thiết bị</th>
              <th>Thời gian</th>
            </tr>
          </thead>
          <tbody>
            @if (Model.RecentSessions.Count == 0)
            {
              <tr>
                <td colspan="4" style="text-align:center; color:var(--muted); padding:24px;">Chưa có phiên đăng nhập nào.</td>
              </tr>
            }
            else
            {
              @foreach (var session in Model.RecentSessions)
              {
                <tr>
                  <td><strong>@session.DisplayName</strong></td>
                  <td>@session.RoleName</td>
                  <td>@session.IpAddress</td>
                  <td>@session.TimeLabel</td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    </div>

    <footer>HanaMedia · Dashboard AdminIT — dữ liệu cập nhật từ hệ thống</footer>
  </main>
</div>
</body>
</html>
