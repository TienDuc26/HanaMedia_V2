<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Kịch bản &amp; Ý tưởng (Nhân viên Ý tưởng)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/components/modals.css" asp-append-version="true">
  <style>
    .flex-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      gap: 16px;
      flex-wrap: wrap;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
    }
    .feedback-box-ql {
      background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
      border: 1px solid #2196F3;
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 12px;
    }
    .feedback-box-director {
      background: linear-gradient(135deg, #FFF9C4 0%, #FFF59D 100%);
      border: 1px solid #F9A825;
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 12px;
    }
    .feedback-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
      font-weight: 700;
      font-size: 12px;
    }
    .feedback-box-ql .feedback-header {
      color: #1565C0;
    }
    .feedback-box-director .feedback-header {
      color: #E65100;
    }
    .feedback-content {
      color: var(--ink-2);
      line-height: 1.5;
      font-size: 13px;
    }
    .feedback-time {
      margin-left: auto;
      font-size: 11px;
      color: var(--muted);
      font-weight: 400;
    }
    .resubmit-note {
      background: var(--blue-50);
      border: 1px dashed var(--blue-300);
      border-radius: 8px;
      padding: 10px 14px;
      margin-bottom: 12px;
      font-size: 12px;
      color: var(--blue-700);
    }
    .resubmit-note i {
      margin-right: 6px;
    }
  </style>
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Nghiệp vụ Sáng tạo</div>
    <a href="/IdeaStaff/Idea" class="nav-item active"><i class="ti ti-bulb"></i>Kịch bản &amp; Ý tưởng</a>
    <a href="/Tasks" class="nav-item"><i class="ti ti-checklist"></i>Công việc được giao</a>
    <a href="/IdeaStaff/Reported" class="nav-item"><i class="ti ti-report-analytics"></i>Báo cáo hiệu suất</a>
    <partial name="_UserMenuPartial" />
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Ý tưởng &amp; Kịch bản của tôi</div>
        <div class="page-sub">Sáng tạo nội dung tiếp thị, soạn thảo kịch bản chi tiết và gửi yêu cầu phê duyệt cho Quản lý</div>
      </div>
    </div>

    <div class="card">
      <div class="flex-bar">
        <div style="width: 300px;">
          <input type="text" class="form-control" placeholder="Tìm ý tưởng, chiến dịch...">
        </div>
        <button class="btn-mini approve" style="padding: 10px 18px;" onclick="openModal('addIdeaModal')"><i class="ti ti-plus"></i> Sáng tạo ý tưởng mới</button>
      </div>

      <table>
        <thead>
          <tr>
            <th>Tên ý tưởng</th>
            <th>Client &amp; Chiến dịch</th>
            <th>Hạn chót (Deadline)</th>
            <th>Người review</th>
            <th>Trạng thái kịch bản</th>
            <th>Feedback</th>
            <th style="text-align: right;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Hành trình Xanh cùng Cocoon</strong></td>
            <td>Cocoon — Glow Up Your Skin</td>
            <td>15/09/2026</td>
            <td>Trần Thanh Hải (QL)</td>
            <td><span class="status-chip status-warn">Review (Chờ duyệt)</span></td>
            <td>
              <span class="status-chip" style="background: #FFF9C4; color: #E65100;">Chờ Giám đốc duyệt</span>
            </td>
            <td style="text-align: right;">
              <button class="btn-mini" onclick="openEditModal('Hành trình Xanh cùng Cocoon', 'Cocoon', 'Glow Up Your Skin', 'Người dùng thích thuần chay', 'Tái chế vỏ chai mỹ phẩm', 'Video hướng dẫn unbox và đổi vỏ chai lấy quà', 'http://ref.cocoon.com', 'Tông màu xanh lá bảo vệ môi trường', 'Kịch bản video ngắn TikTok 60s', 'Review', '', '')">Xem chi tiết</button>
            </td>
          </tr>
          <tr>
            <td><strong>Sữa hạt Dinh Dưỡng Mỗi Ngày</strong></td>
            <td>Vinamilk — Tết Sum Vầy 2027</td>
            <td>30/12/2026</td>
            <td>Trần Thanh Hải (QL)</td>
            <td><span class="status-chip status-bad">Need Revision</span></td>
            <td>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <span style="font-size: 11px; color: #1565C0;"><i class="ti ti-user"></i> QL: Cần viết chi tiết hơn</span>
                <span style="font-size: 11px; color: #E65100;"><i class="ti ti-user-check"></i> GĐ: Concept chưa viral</span>
              </div>
            </td>
            <td style="text-align: right;">
              <button class="btn-mini approve" onclick="openEditModal('Sữa hạt Dinh Dưỡng Mỗi Ngày', 'Vinamilk', 'Tết Sum Vầy 2027', 'Gia đình quan tâm sức khỏe', 'Sữa hạt dinh dưỡng cho người già', 'Ý tưởng tặng quà tết ý nghĩa cho ông bà', 'http://ref.vinamilk.com', 'Màu xanh lục ấm cúng', 'Kịch bản clip ngắn 30s cho Facebook Reels', 'Need Revision', 'Phản hồi từ Trần Thanh Hải: Cần viết chi tiết hơn phần hội thoại của ông bà ở giây thứ 15.', 'Campaign rất tiềm năng, nhưng concept hiện tại chưa đủ viral. Hãy bổ sung thêm yếu tố bất ngờ/hài hước vào kịch bản.')">Chỉnh sửa &amp; Gửi lại</button>
            </td>
          </tr>
          <tr>
            <td><strong>Review Địa Điểm Du Lịch</strong></td>
            <td>Traveloka — Summer Vibes 2026</td>
            <td>01/07/2026</td>
            <td>Trần Thanh Hải (QL)</td>
            <td><span class="status-chip status-warn">Đã gửi lại</span></td>
            <td>
              <span style="font-size: 11px; color: #1565C0;"><i class="ti ti-user-check"></i> Đã chỉnh sửa theo feedback GĐ</span>
            </td>
            <td style="text-align: right;">
              <button class="btn-mini" onclick="openEditModal('Review Địa Điểm Du Lịch', 'Traveloka', 'Summer Vibes 2026', 'Giới trẻ thích du lịch', 'Review địa điểm du lịch hot', 'Kịch bản review địa điểm du lịch', 'http://ref.traveloka.com', 'Màu sắc tươi sáng', 'Kịch bản YouTube 10 phút', 'Đã gửi lại', '', '')">Xem chi tiết</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <footer>HanaMedia · Dashboard Nhân viên Ý tưởng — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<!-- MODAL SÁNG TẠO Ý TƯỞNG MỚI -->
<div class="modal-backdrop" id="addIdeaModal">
  <div class="modal-card" style="width:650px;">
    <div class="modal-header">
      <div class="modal-title">Sáng tạo ý tưởng &amp; Kịch bản mới</div>
      <button class="modal-close" onclick="closeModal('addIdeaModal')">&times;</button>
    </div>
    <div class="modal-body" style="padding-right: 8px;">
      <div class="form-grid">
        <div class="form-group">
          <label>Tên ý tưởng</label>
          <input type="text" class="form-control" placeholder="Tên ý tưởng sáng tạo...">
        </div>
        <div class="form-group">
          <label>Khách hàng (Client)</label>
          <input type="text" class="form-control" placeholder="Tên nhãn hàng...">
        </div>
        <div class="form-group">
          <label>Chiến dịch (Campaign)</label>
          <input type="text" class="form-control" placeholder="Chiến dịch truyền thông...">
        </div>
        <div class="form-group">
          <label>Hạn chót hoàn thành (Deadline)</label>
          <input type="date" class="form-control">
        </div>
      </div>
      <div class="form-group">
        <label>Insight khách hàng</label>
        <input type="text" class="form-control" placeholder="Insight cốt lõi của khách hàng mục tiêu...">
      </div>
      <div class="form-group">
        <label>Concept sáng tạo</label>
        <input type="text" class="form-control" placeholder="Concept chủ đạo...">
      </div>
      <div class="form-group">
        <label>Nội dung chi tiết</label>
        <textarea class="form-control" rows="2" placeholder="Tóm tắt nội dung ý tưởng truyền tải..."></textarea>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label>Reference Link (Liên kết tham khảo)</label>
          <input type="text" class="form-control" placeholder="http://...">
        </div>
        <div class="form-group">
          <label>Moodboard (Phong cách hình ảnh)</label>
          <input type="text" class="form-control" placeholder="Mô tả phong cách moodboard...">
        </div>
      </div>
      <div class="form-group">
        <label>Script (Kịch bản phân cảnh chi tiết)</label>
        <textarea class="form-control" rows="4" placeholder="Viết kịch bản lời thoại, hành động phân cảnh chi tiết tại đây..."></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('addIdeaModal')">Hủy</button>
      <button class="btn-mini approve" onclick="alert('Đã gửi ý tưởng mới lên hàng chờ Review của Quản lý!'); closeModal('addIdeaModal');">Gửi duyệt (Review)</button>
    </div>
  </div>
</div>

<!-- MODAL CHỈNH SỬA VÀ NỘP DUYỆT -->
<div class="modal-backdrop" id="editIdeaModal">
  <div class="modal-card" style="width: 700px; max-width: 98%;">
    <div class="modal-header">
      <div class="modal-title">Chỉnh sửa ý tưởng &amp; Kịch bản</div>
      <button class="modal-close" onclick="closeModal('editIdeaModal')">&times;</button>
    </div>
    <div class="modal-body" style="padding-right: 8px;">

      <!-- FEEDBACK FROM QUAN LY -->
      <div id="feedbackBoxQL" class="feedback-box-ql" style="display: none;">
        <div class="feedback-header">
          <i class="ti ti-user"></i> Phản hồi từ Quản lý Ý tưởng
          <span id="feedbackTimeQL" class="feedback-time">-</span>
        </div>
        <div id="feedbackTextQL" class="feedback-content">-</div>
      </div>

      <!-- FEEDBACK FROM GIAM DOC -->
      <div id="feedbackBoxDirector" class="feedback-box-director" style="display: none;">
        <div class="feedback-header">
          <i class="ti ti-user-check"></i> Phản hồi từ Giám đốc
          <span id="feedbackTimeDirector" class="feedback-time">-</span>
        </div>
        <div id="feedbackTextDirector" class="feedback-content">-</div>
      </div>

      <!-- RESUBMIT NOTE -->
      <div id="resubmitNote" class="resubmit-note" style="display: none;">
        <i class="ti ti-info-circle"></i>
        <span>Ý tưởng đã được chỉnh sửa theo feedback. Nhấn "Cập nhật &amp; Gửi lại" để gửi lại cho Giám đốc phê duyệt.</span>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label>Tên ý tưởng</label>
          <input type="text" id="editName" class="form-control">
        </div>
        <div class="form-group">
          <label>Khách hàng (Client)</label>
          <input type="text" id="editClient" class="form-control" readonly style="background: var(--blue-50);">
        </div>
        <div class="form-group">
          <label>Chiến dịch (Campaign)</label>
          <input type="text" id="editCampaign" class="form-control" readonly style="background: var(--blue-50);">
        </div>
        <div class="form-group">
          <label>Trạng thái kịch bản</label>
          <select class="form-control" id="editStatus">
            <option value="To do">To do</option>
            <option value="In Progress">In Progress</option>
            <option value="Review">Review (Gửi duyệt)</option>
            <option value="Need Revision" disabled>Need Revision (Yêu cầu sửa - Quản lý/Giám đốc đổi)</option>
            <option value="Da gui lai">Đã gửi lại (sau feedback Giám đốc)</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Insight khách hàng</label>
        <input type="text" id="editInsight" class="form-control">
      </div>
      <div class="form-group">
        <label>Concept</label>
        <input type="text" id="editConcept" class="form-control">
      </div>
      <div class="form-group">
        <label>Nội dung chi tiết</label>
        <textarea id="editContent" class="form-control" rows="2"></textarea>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label>Reference Link</label>
          <input type="text" id="editRef" class="form-control">
        </div>
        <div class="form-group">
          <label>Moodboard</label>
          <input type="text" id="editMoodboard" class="form-control">
        </div>
      </div>
      <div class="form-group">
        <label>Script (Kịch bản phân cảnh chi tiết)</label>
        <textarea id="editScript" class="form-control" rows="4"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('editIdeaModal')">Hủy</button>
      <button class="btn-mini" id="btnSaveOnly" onclick="saveOnly()">
        <i class="ti ti-device-floppy"></i> Lưu tạm
      </button>
      <button class="btn-mini approve" id="btnResubmit" onclick="submitResubmit()">
        <i class="ti ti-send"></i> Cập nhật &amp; Gửi lại
      </button>
    </div>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).classList.add('active');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }

  function openEditModal(name, client, campaign, insight, concept, content, ref, moodboard, script, status, feedbackQL, feedbackDirector) {
    // Fill form fields
    document.getElementById('editName').value = name;
    document.getElementById('editClient').value = client;
    document.getElementById('editCampaign').value = campaign;
    document.getElementById('editInsight').value = insight;
    document.getElementById('editConcept').value = concept;
    document.getElementById('editContent').value = content;
    document.getElementById('editRef').value = ref;
    document.getElementById('editMoodboard').value = moodboard;
    document.getElementById('editScript').value = script;

    // Feedback from QL
    const feedBoxQL = document.getElementById('feedbackBoxQL');
    if (feedbackQL && feedbackQL.trim()) {
      feedBoxQL.style.display = 'block';
      document.getElementById('feedbackTextQL').innerText = feedbackQL;
      document.getElementById('feedbackTimeQL').innerText = '2 ngày trước';
    } else {
      feedBoxQL.style.display = 'none';
    }

    // Feedback from Director
    const feedBoxDir = document.getElementById('feedbackBoxDirector');
    if (feedbackDirector && feedbackDirector.trim()) {
      feedBoxDir.style.display = 'block';
      document.getElementById('feedbackTextDirector').innerText = feedbackDirector;
      document.getElementById('feedbackTimeDirector').innerText = '1 ngày trước';
    } else {
      feedBoxDir.style.display = 'none';
    }

    // Show resubmit note if has director feedback
    const resubmitNote = document.getElementById('resubmitNote');
    if (feedbackDirector && feedbackDirector.trim()) {
      resubmitNote.style.display = 'block';
    } else {
      resubmitNote.style.display = 'none';
    }

    // Status select
    const statusSelect = document.getElementById('editStatus');
    if (status === 'Need Revision' || status === 'Da gui lai') {
      statusSelect.value = 'Da gui lai';
    } else {
      statusSelect.value = status;
    }

    openModal('editIdeaModal');
  }

  function saveOnly() {
    alert('Đã lưu tạm thay đổi. Bạn có thể tiếp tục chỉnh sửa.');
  }

  function submitResubmit() {
    if (confirm('Gửi lại ý tưởng đã chỉnh sửa cho Giám đốc phê duyệt?\n\nTrạng thái sẽ chuyển thành "Đã gửi lại" và chờ Giám đốc xem xét.')) {
      alert('Đã gửi lại ý tưởng. Trạng thái: "Đã gửi lại (chờ Giám đốc duyệt)".');
      closeModal('editIdeaModal');
    }
  }
</script>
</body>
</html>
