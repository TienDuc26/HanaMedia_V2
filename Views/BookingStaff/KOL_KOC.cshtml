<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Tìm kiếm &amp; Liên hệ KOL (Nhân viên Booking)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
  <style>
    .flex-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      gap: 16px;
      flex-wrap: wrap;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
    }
  </style>
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Nghiệp vụ của tôi</div>
    <a href="/BookingStaff/KOL_KOC" class="nav-item active"><i class="ti ti-users-group"></i>Tìm KOL / KOC</a>
    <a href="/BookingStaff/Booking" class="nav-item"><i class="ti ti-star"></i>Nhiệm vụ Booking</a>
    <a href="/BookingStaff/Reported" class="nav-item"><i class="ti ti-report-analytics"></i>Báo cáo hiệu suất</a>

    <div class="sidebar-footer">
      <div class="role-pill">
        <div class="avatar">NV</div>
        <div>
          <div class="role-name">Phạm Thu Hà</div>
          <div class="role-title">Nhân viên Booking</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Tìm kiếm &amp; Liên hệ KOL/KOC</div>
        <div class="page-sub">Tìm kiếm đối tác mới, lưu trữ thông tin liên hệ và cập nhật vòng đời thương thảo hợp đồng</div>
      </div>
    </div>

    <div class="card">
      <div class="flex-bar">
        <div style="width: 300px;">
          <input type="text" class="form-control" placeholder="Tìm tên KOL, chủ đề/niche...">
        </div>
        <button class="btn-mini approve" style="padding: 10px 18px;" onclick="openModal('addKOLModal')"><i class="ti ti-plus"></i> Khai thác KOL mới</button>
      </div>

      <table>
        <thead>
          <tr>
            <th>KOL/KOC</th>
            <th>Nền tảng &amp; Link</th>
            <th>Theo dõi / Tương tác</th>
            <th>Chủ đề/Niche</th>
            <th>Giá Booking tham khảo</th>
            <th>Liên hệ (SĐT / Email)</th>
            <th>Trạng thái thương thảo</th>
            <th style="text-align: right;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Nguyễn Thị H</strong></td>
            <td>TikTok <a href="#" target="_blank" style="color:var(--blue-600); text-decoration:none;"><i class="ti ti-link"></i> @@nguyenthih</a></td>
            <td>500k · 8.5% tương tác</td>
            <td>Đời sống / Vlogs</td>
            <td>10,000,000 đ</td>
            <td>0912.xxx.xxx<br><span style="color:var(--muted); font-size:11.5px;">h@gmail.com</span></td>
            <td><span class="status-chip status-good">Đang chạy</span></td>
            <td style="text-align: right;">
              <button class="btn-mini approve" onclick="openStatusModal('Nguyễn Thị H', 'Đang chạy')">Cập nhật deal</button>
            </td>
          </tr>
          <tr>
            <td><strong>Lê Thị M</strong></td>
            <td>Instagram <a href="#" target="_blank" style="color:var(--blue-600); text-decoration:none;"><i class="ti ti-link"></i> @@lethim</a></td>
            <td>120k · 6.2% tương tác</td>
            <td>Làm đẹp / Fashion</td>
            <td>5,000,000 đ</td>
            <td>0905.xxx.xxx<br><span style="color:var(--muted); font-size:11.5px;">m@gmail.com</span></td>
            <td><span class="status-chip status-warn">Đang deal</span></td>
            <td style="text-align: right;">
              <button class="btn-mini approve" onclick="openStatusModal('Lê Thị M', 'Đang deal')">Cập nhật deal</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <footer>HanaMedia · Dashboard Nhân viên Booking — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<!-- MODAL THÊM KOL MỚI -->
<div class="modal-backdrop" id="addKOLModal">
  <div class="modal-card" style="width:650px;">
    <div class="modal-header">
      <div class="modal-title">Khai thác đối tác KOL/KOC mới</div>
      <button class="modal-close" onclick="closeModal('addKOLModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="form-group">
          <label>Nghệ danh (KOL/KOC)</label>
          <input type="text" class="form-control" placeholder="Tên tài khoản hoặc họ tên...">
        </div>
        <div class="form-group">
          <label>Nền tảng chính</label>
          <select class="form-control">
            <option>TikTok</option>
            <option>Instagram</option>
            <option>YouTube</option>
          </select>
        </div>
        <div class="form-group">
          <label>Link tài khoản</label>
          <input type="text" class="form-control" placeholder="http://...">
        </div>
        <div class="form-group">
          <label>Chủ đề / Niche</label>
          <input type="text" class="form-control" placeholder="Beauty, Food, Tech...">
        </div>
        <div class="form-group">
          <label>Số người theo dõi (Followers)</label>
          <input type="text" class="form-control" placeholder="Ví dụ: 300k...">
        </div>
        <div class="form-group">
          <label>Tương tác (%)</label>
          <input type="text" class="form-control" placeholder="Ví dụ: 5.5%...">
        </div>
        <div class="form-group">
          <label>Báo giá tham khảo (VND)</label>
          <input type="text" class="form-control" placeholder="Nhập số tiền...">
        </div>
        <div class="form-group">
          <label>Khu vực (Địa bàn)</label>
          <input type="text" class="form-control" placeholder="Hà Nội, TP.HCM...">
        </div>
      </div>
      <div class="form-group">
        <label>Thông tin liên hệ (Phone/Zalo/Email)</label>
        <input type="text" class="form-control" placeholder="Nhập số điện thoại hoặc email liên lạc...">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('addKOLModal')">Hủy</button>
      <button class="btn-mini approve" onclick="alert('Đã lưu thông tin KOL tiềm năng mới!'); closeModal('addKOLModal');">Khai thác</button>
    </div>
  </div>
</div>

<!-- MODAL CẬP NHẬT DEAL -->
<div class="modal-backdrop" id="statusModal">
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title">Cập nhật tiến độ thương lượng</div>
      <button class="modal-close" onclick="closeModal('statusModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>KOL / KOC</label>
        <input type="text" id="statusKOL" class="form-control" readonly style="background:var(--blue-50);">
      </div>
      <div class="form-group">
        <label>Mức giá deal chốt cuối cùng (VND)</label>
        <input type="number" class="form-control" placeholder="Nhập số tiền chốt...">
      </div>
      <div class="form-group">
        <label>Trạng thái deal</label>
        <select class="form-control" id="statusSelect">
          <option value="Tiềm năng">Tiềm năng</option>
          <option value="Đã liên hệ">Đã liên hệ</option>
          <option value="Đang deal">Đang deal</option>
          <option value="Đã chốt">Đã chốt</option>
        </select>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('statusModal')">Hủy</button>
      <button class="btn-mini approve" onclick="alert('Đã cập nhật trạng thái đàm phán!'); closeModal('statusModal');">Cập nhật</button>
    </div>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).classList.add('active');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }

  function openStatusModal(name, status) {
    document.getElementById('statusKOL').value = name;
    document.getElementById('statusSelect').value = status;
    openModal('statusModal');
  }
</script>
</body>
</html>
