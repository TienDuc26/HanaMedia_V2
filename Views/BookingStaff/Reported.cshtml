<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Báo cáo thù lao &amp; hiệu suất cá nhân</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Nghiệp vụ của tôi</div>
    <a href="/BookingStaff/KOL_KOC" class="nav-item"><i class="ti ti-users-group"></i>Tìm KOL / KOC</a>
    <a href="/BookingStaff/Booking" class="nav-item"><i class="ti ti-star"></i>Nhiệm vụ Booking</a>
    <a href="/BookingStaff/Reported" class="nav-item active"><i class="ti ti-report-analytics"></i>Báo cáo hiệu suất</a>

    <div class="sidebar-footer">
      <div class="role-pill">
        <div class="avatar">NV</div>
        <div>
          <div class="role-name">Phạm Thu Hà</div>
          <div class="role-title">Nhân viên Booking</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Báo cáo hiệu suất &amp; Thống kê Thù lao</div>
        <div class="page-sub">Xem phân tích doanh thu mang lại, thù lao thực lĩnh và tiến độ hoàn thành các chỉ tiêu KPI cá nhân</div>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-head">
          <div class="card-title">Thu nhập thù lao tích lũy 6 tháng (VND)</div>
        </div>
        <div style="position:relative; height:220px;">
          <canvas id="salaryHistoryChart"></canvas>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <div class="card-title">Tiến độ hoàn thành KPI (Tháng 8/2026)</div>
        </div>
        <div style="text-align:center; padding-top:20px;">
          <h2 style="font-size:36px; color:var(--green); font-weight:800; margin-bottom:10px;">92%</h2>
          <div class="status-chip status-good" style="font-size:14px; margin-bottom:20px;">Hoàn thành tốt mục tiêu tháng</div>
          <span class="bar-mini" style="width:70%; height:10px;"><span class="bar-mini-fill" style="width:92%; background:var(--green);"></span></span>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top: 16px;">
      <div class="card-head">
        <div class="card-title">Báo cáo chi tiết chiến dịch đã tham gia</div>
      </div>
      <table>
        <thead>
          <tr>
            <th>Client &amp; Chiến dịch</th>
            <th>KOL/KOC phụ trách</th>
            <th>Mức thù lao của tôi</th>
            <th>Kết quả tương tác bài đăng</th>
            <th>Ngày nghiệm thu</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Vinamilk — Tết Sum Vầy 2027</strong></td>
            <td>Nguyễn Thị H</td>
            <td>3,000,000 đ</td>
            <td>500k views, 42k likes</td>
            <td>Đang triển khai</td>
          </tr>
          <tr>
            <td><strong>Traveloka — Mùa Hè Rực Rỡ</strong></td>
            <td>Trần Văn K</td>
            <td>10,000,000 đ</td>
            <td>1.5M views, 110k likes</td>
            <td>05/08/2026</td>
          </tr>
        </tbody>
      </table>
    </div>

    <footer>HanaMedia · Dashboard Nhân viên Booking — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
const salCtx = document.getElementById('salaryHistoryChart');
new Chart(salCtx, {
  type: 'line',
  data: {
    labels: ['T3','T4','T5','T6','T7','T8'],
    datasets: [{
      label: 'Thù lao (triệu đ)',
      data: [5, 7.5, 6, 8, 12, 13],
      borderColor: '#2F80ED',
      backgroundColor: '#2F80ED',
      tension: 0.35,
      borderWidth: 2,
      pointRadius: 3
    }]
  },
  options: {
    responsive:true, maintainAspectRatio:false,
    plugins:{ legend:{ display:false } },
    scales:{
      y:{ min: 0, ticks:{ callback:v=>v+'tr' } }
    }
  }
});
</script>
</body>
</html>
