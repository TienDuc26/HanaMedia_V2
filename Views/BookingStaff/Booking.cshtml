<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Nhiệm vụ Booking của tôi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
  <style>
    .idea-grid-detail {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  </style>
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Nghiệp vụ của tôi</div>
    <a href="/Campaigns" class="nav-item"><i class="ti ti-speakerphone"></i>Chiến dịch</a>
    <a href="/BookingStaff/KOL_KOC" class="nav-item"><i class="ti ti-users-group"></i>Tìm KOL / KOC</a>
    <a href="/BookingStaff/Booking" class="nav-item active"><i class="ti ti-star"></i>Nhiệm vụ Booking</a>
    <a href="/Tasks" class="nav-item"><i class="ti ti-checklist"></i>Công việc được giao</a>
    <a href="/BookingStaff/Reported" class="nav-item"><i class="ti ti-report-analytics"></i>Báo cáo hiệu suất</a>
    <partial name="_UserMenuPartial" />
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Nhiệm vụ Booking &amp; Thù lao cá nhân</div>
        <div class="page-sub">Theo dõi deadline, cập nhật link nghiệm thu bài viết và kiểm tra thù lao được chia cho từng chiến dịch</div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <div class="card-title">Danh sách chiến dịch tham gia</div>
      </div>

      <table>
        <thead>
          <tr>
            <th>Client &amp; Campaign</th>
            <th>KOL/KOC phụ trách</th>
            <th>Thời hạn (Deadline)</th>
            <th>Thù lao của tôi (Read-only)</th>
            <th>Trạng thái Booking</th>
            <th>Trạng thái HĐ</th>
            <th style="text-align: right;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Vinamilk</strong><br><span style="color:var(--muted); font-size:12px;">Tết Sum Vầy 2027</span></td>
            <td>Nguyễn Thị H</td>
            <td>15/01/2027</td>
            <td style="color:var(--blue-700); font-weight:700;">3,000,000 đ</td>
            <td><span class="status-chip status-good">Đã ký (hiệu lực)</span></td>
            <td><span class="status-chip status-good">Đã ký</span></td>
            <td style="text-align: right;">
              <a href="#" target="_blank" style="color:var(--blue-600); margin-right: 8px;"><i class="ti ti-link"></i> Link</a>
              <button class="btn-mini" onclick="openUploadModal('Vinamilk — Tết Sum Vầy', '3,000,000 đ', 'http://link.tiktok.com/123')">Nghiệm thu</button>
            </td>
          </tr>
          <tr>
            <td><strong>Traveloka</strong><br><span style="color:var(--muted); font-size:12px;">Mùa Hè Rực Rỡ</span></td>
            <td>Trần Văn K</td>
            <td>05/08/2026</td>
            <td style="color:var(--blue-700); font-weight:700;">10,000,000 đ</td>
            <td><span class="status-chip status-good">Hoàn thành</span></td>
            <td><span class="status-chip status-good">Đã ký</span></td>
            <td style="text-align: right;">
              <a href="#" target="_blank" style="color:var(--blue-600); margin-right: 8px;"><i class="ti ti-link"></i> Link</a>
              <button class="btn-mini" onclick="openUploadModal('Traveloka — Mùa Hè Rực Rỡ', '10,000,000 đ', 'http://insta.com/p/456')">Nghiệm thu</button>
            </td>
          </tr>
          <tr>
            <td><strong>Cocoon</strong><br><span style="color:var(--muted); font-size:12px;">Glow Up Your Skin</span></td>
            <td>Lê Thị M</td>
            <td>25/09/2026</td>
            <td style="color:var(--blue-700); font-weight:700;">4,500,000 đ</td>
            <td><span class="status-chip status-info">Chờ Giám đốc ký</span></td>
            <td><span class="status-chip status-warn">Chờ ký</span></td>
            <td style="text-align: right;">
              <button class="btn-mini approve" onclick="alert('Hợp đồng đã được gửi cho Giám đốc ký.')">
                <i class="ti ti-send"></i> Đã gửi HĐ
              </button>
            </td>
          </tr>
          <tr>
            <td><strong>Vinamilk</strong><br><span style="color:var(--muted); font-size:12px;">Tết Sum Vầy 2027 (KOL lớn)</span></td>
            <td>Đặng Ngọc L</td>
            <td>30/12/2026</td>
            <td style="color:var(--blue-700); font-weight:700;">12,000,000 đ</td>
            <td><span class="status-chip status-info">Đã duyệt (chờ soạn HĐ)</span></td>
            <td><span class="status-chip status-warn">Chờ soạn</span></td>
            <td style="text-align: right;">
              <button class="btn-mini approve" onclick="openContractDraftModal('Vinamilk — Tết Sum Vầy 2027', 'Đặng Ngọc L', 480000000, 'Nguyễn Anh Tuấn')">
                <i class="ti ti-file-text"></i> Soạn Hợp đồng
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <footer>HanaMedia · Dashboard Nhân viên Booking — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<!-- MODAL NGHIỆM THU / UPLOAD BẰNG CHỨNG -->
<div class="modal-backdrop" id="uploadModal">
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title">Nghiệm thu &amp; Báo cáo kết quả</div>
      <button class="modal-close" onclick="closeModal('uploadModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>Chiến dịch</label>
        <input type="text" id="upCampaign" class="form-control" readonly style="background:var(--blue-50);">
      </div>
      <div class="form-group">
        <label>Thù lao của tôi (Cố định do quản lý phân bổ)</label>
        <input type="text" id="upSalary" class="form-control" readonly style="background:var(--blue-50); font-weight:700; color:var(--blue-700);">
      </div>
      <div class="form-group">
        <label>Đường dẫn bài đăng (Link bài đăng)</label>
        <input type="text" id="upLink" class="form-control" placeholder="Dán link bài viết, video nghiệm thu...">
      </div>
      <div class="form-group">
        <label>Tải lên ảnh chụp màn hình / Bằng chứng (.jpg, .png, .pdf)</label>
        <input type="file" class="form-control">
      </div>
      <div class="form-group">
        <label>Báo cáo kết quả số liệu chiến dịch (Views, Likes, Comments...)</label>
        <textarea class="form-control" rows="3" placeholder="Nhập tóm tắt kết quả tương tác của bài viết..."></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('uploadModal')">Hủy</button>
      <button class="btn-mini approve" onclick="alert('Đã gửi báo cáo nghiệm thu và tải lên bằng chứng thành công!'); closeModal('uploadModal');">Báo cáo hoàn thành</button>
    </div>
  </div>
</div>

<!-- MODAL SOẠN HỢP ĐỒNG -->
<div class="modal-backdrop" id="contractModal">
  <div class="modal-card" style="width: 700px; max-width: 95%;">
    <div class="modal-header">
      <div class="modal-title"><i class="ti ti-file-text" style="color: var(--blue-500);"></i> Soạn hợp đồng Booking</div>
      <button class="modal-close" onclick="closeModal('contractModal')">&times;</button>
    </div>
    <div class="modal-body" style="max-height: 500px; overflow-y: auto;">
      <div style="background: var(--blue-50); border: 1px solid var(--blue-100); padding: 14px; border-radius: 10px; margin-bottom: 16px;">
        <div class="idea-grid-detail">
          <div>
            <div class="info-label">Chiến dịch</div>
            <div id="cdCampaign" class="info-val" style="font-weight: 700;">-</div>
          </div>
          <div>
            <div class="info-label">KOL/KOC</div>
            <div id="cdKOL" class="info-val" style="font-weight: 700;">-</div>
          </div>
          <div>
            <div class="info-label">Giá trị Booking</div>
            <div id="cdValue" class="info-val" style="font-weight: 700; color: var(--blue-700);">-</div>
          </div>
          <div>
            <div class="info-label">NV phụ trách</div>
            <div id="cdStaff" class="info-val" style="font-weight: 700;">-</div>
          </div>
        </div>
      </div>

      <div class="form-group">
        <label>Tiêu đề hợp đồng</label>
        <input type="text" id="cdTitle" class="form-control" placeholder="VD: Hợp đồng dịch vụ quảng cáo TikTok...">
      </div>
      <div class="form-group">
        <label>Nội dung hợp đồng</label>
        <textarea id="cdContent" class="form-control" rows="6" placeholder="Nhập nội dung hợp đồng chi tiết..."></textarea>
      </div>
      <div class="idea-grid-detail">
        <div class="form-group">
          <label>Ngày bắt đầu</label>
          <input type="date" id="cdStartDate" class="form-control">
        </div>
        <div class="form-group">
          <label>Ngày kết thúc</label>
          <input type="date" id="cdEndDate" class="form-control">
        </div>
      </div>
      <div class="form-group">
        <label>Đính kèm file hợp đồng (.pdf, .docx)</label>
        <input type="file" class="form-control">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('contractModal')">Hủy</button>
      <button class="btn-mini approve" onclick="submitContract()">
        <i class="ti ti-send"></i> Gửi Giám đốc ký
      </button>
    </div>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).classList.add('active');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }

  function openUploadModal(campaign, salary, link) {
    document.getElementById('upCampaign').value = campaign;
    document.getElementById('upSalary').value = salary;
    document.getElementById('upLink').value = link;
    openModal('uploadModal');
  }

  function openContractDraftModal(campaign, kol, value, staff) {
    document.getElementById('cdCampaign').innerText = campaign;
    document.getElementById('cdKOL').innerText = kol;
    document.getElementById('cdValue').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value);
    document.getElementById('cdStaff').innerText = staff;

    // Pre-fill title
    document.getElementById('cdTitle').value = `Hợp đồng dịch vụ - ${campaign}`;
    document.getElementById('cdContent').value = `HỢP ĐỒNG DỊCH VỤ\n\nCông ty: HanaMedia\nChiến dịch: ${campaign}\nKOL/KOC: ${kol}\nGiá trị: ${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value)}\n\nNỘI DUNG HỢP ĐỒNG:\n[Soạn chi tiết nội dung hợp đồng tại đây...]`;

    openModal('contractModal');
  }

  function submitContract() {
    const title = document.getElementById('cdTitle').value;
    if (!title.trim()) {
      alert('Vui lòng nhập tiêu đề hợp đồng.');
      return;
    }
    if (confirm('Hợp đồng sẽ được gửi cho Giám đốc ký. Tiếp tục?')) {
      alert('Đã gửi hợp đồng cho Giám đốc ký. Trạng thái booking chuyển thành "Chờ Giám đốc ký hợp đồng".');
      closeModal('contractModal');
    }
  }
</script>
</body>
</html>
