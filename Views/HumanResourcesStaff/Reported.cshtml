<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Báo cáo nhân sự (Nhân viên HCNS)</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body>
<div class="layout">

  <partial name="_SidebarPartial" />


  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Báo cáo nhân sự tổng hợp</div>
        <div class="page-sub">Xem thống kê cơ cấu tổ chức và biến động lao động toàn công ty dạng chỉ đọc (Read-only)</div>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-head">
          <div class="card-title">Cơ cấu lao động theo hợp đồng (Nhân sự)</div>
        </div>
        <div style="position:relative; height:220px;">
          <canvas id="contractsChart"></canvas>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <div class="card-title">Tình hình biến động nhân lực (T8/2026)</div>
        </div>
        <div style="text-align:center; padding-top:30px;">
          <h2 style="font-size:32px; color:var(--green); font-weight:800; margin-bottom:10px;">+4 nhân viên</h2>
          <div class="status-chip status-good" style="font-size:13.5px; margin-bottom:16px;">Tuyển mới: 6 · Nghỉ việc: 2</div>
          <span style="font-size:12px; color:var(--muted);">Tỷ lệ giữ chân nhân sự đạt 98.4%</span>
        </div>
      </div>
    </div>

    <footer>HanaMedia · Dashboard Nhân viên HCNS — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
const conCtx = document.getElementById('contractsChart');
new Chart(conCtx, {
  type: 'doughnut',
  data: {
    labels: ['Vô thời hạn','1-3 Năm','Thử việc'],
    datasets: [{
      data: [42, 68, 18],
      backgroundColor: ['#2F80ED','#8AB8F2','#FCF0DC'],
      borderColor:'#fff', borderWidth:2
    }]
  },
  options: {
    responsive:true, maintainAspectRatio:false, cutout:'68%',
    plugins:{ legend:{ display:true, position: 'bottom' } }
  }
});
</script>
</body>
</html>
