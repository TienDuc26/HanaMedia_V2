<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Hồ sơ &amp; Hợp đồng (Nhân viên HCNS)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
  <style>
    .flex-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      gap: 16px;
      flex-wrap: wrap;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
    }
  </style>
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Vận hành nhân sự</div>
    <a href="/HumanResourcesStaff/HumanResources" class="nav-item active"><i class="ti ti-users"></i>Hồ sơ &amp; Hợp đồng</a>
    <a href="/HumanResourcesStaff/Reported" class="nav-item"><i class="ti ti-report-analytics"></i>Báo cáo nhân sự</a>
    <partial name="_UserMenuPartial" />
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Quản lý Hồ sơ &amp; Theo dõi hợp đồng</div>
        <div class="page-sub">Xem danh sách nhân sự, cập nhật giấy tờ cá nhân và theo dõi hạn hợp đồng lao động</div>
      </div>
    </div>

    <div class="card">
      <div class="flex-bar">
        <div style="width: 300px;">
          <input type="text" class="form-control" placeholder="Tìm tên nhân viên, phòng ban...">
        </div>
        <button class="btn-mini approve" style="padding: 10px 18px;" onclick="openModal('addEmpModal')"><i class="ti ti-plus"></i> Tạo hồ sơ mới</button>
      </div>

      <table>
        <thead>
          <tr>
            <th>Họ và tên</th>
            <th>Phòng ban</th>
            <th>Chức vụ</th>
            <th>Loại hợp đồng</th>
            <th>Liên hệ (SĐT / Email)</th>
            <th>Hồ sơ giấy tờ</th>
            <th>Ngày vào</th>
            <th>Trạng thái</th>
            <th style="text-align: right;">Cập nhật hồ sơ</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Phạm Thu Hà</strong></td>
            <td><span class="dept-chip">Booking</span></td>
            <td>Nhân viên</td>
            <td>Hợp đồng chính thức (1 năm)</td>
            <td>0912.xxx.xxx<br><span style="color:var(--muted); font-size:11.5px;">ha@hanamedia.vn</span></td>
            <td><span class="badge badge-success">Đủ giấy tờ</span></td>
            <td>05/08/2026</td>
            <td><span class="status-chip status-good">Đang làm việc</span></td>
            <td style="text-align: right;">
              <button class="btn-mini approve" onclick="openEditModal('Phạm Thu Hà', '1998-05-12', '0912.xxx.xxx', 'ha@hanamedia.vn', 'Hà Nội', '05/08/2026', 'Booking', 'Nhân viên', 'Nguyễn Anh Tuấn', 'Hợp đồng chính thức', 'Đang làm việc', 'CCCD_Ha.pdf, HopDong_signed.pdf')">Cập nhật</button>
            </td>
          </tr>
          <tr>
            <td><strong>Nguyễn Anh Tuấn</strong></td>
            <td><span class="dept-chip">Booking</span></td>
            <td>Quản lý</td>
            <td>Hợp đồng vô thời hạn</td>
            <td>0988.xxx.xxx<br><span style="color:var(--muted); font-size:11.5px;">tuan@hanamedia.vn</span></td>
            <td><span class="badge badge-warning">Thiếu bằng cấp</span></td>
            <td>15/03/2023</td>
            <td><span class="status-chip status-warn">Đang hoạt động</span></td>
            <td style="text-align: right;">
              <button class="btn-mini approve" onclick="openEditModal('Nguyễn Anh Tuấn', '1990-09-20', '0988.xxx.xxx', 'tuan@hanamedia.vn', 'Hà Nội', '15/03/2023', 'Booking', 'Quản lý', 'Giám đốc Nguyễn Văn A', 'Hợp đồng vô thời hạn', 'Đang hoạt động', 'CCCD_Tuan.pdf')">Cập nhật</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <footer>HanaMedia · Dashboard Nhân viên HCNS — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<!-- MODAL THÊM HỒ SƠ MỚI (KHÔNG CÓ LƯƠNG) -->
<div class="modal-backdrop" id="addEmpModal">
  <div class="modal-card" style="width:650px;">
    <div class="modal-header">
      <div class="modal-title">Tạo hồ sơ nhân viên mới</div>
      <button class="modal-close" onclick="closeModal('addEmpModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="form-group">
          <label>Họ và tên</label>
          <input type="text" class="form-control" placeholder="Họ tên đầy đủ...">
        </div>
        <div class="form-group">
          <label>Ngày sinh</label>
          <input type="date" class="form-control">
        </div>
        <div class="form-group">
          <label>Số điện thoại</label>
          <input type="text" class="form-control" placeholder="SĐT cá nhân...">
        </div>
        <div class="form-group">
          <label>Email cá nhân</label>
          <input type="email" class="form-control" placeholder="Địa chỉ email...">
        </div>
        <div class="form-group">
          <label>Địa chỉ</label>
          <input type="text" class="form-control" placeholder="Địa chỉ thường trú...">
        </div>
        <div class="form-group">
          <label>Ngày vào công ty</label>
          <input type="date" class="form-control">
        </div>
        <div class="form-group">
          <label>Phòng ban</label>
          <select class="form-control">
            <option>Booking</option>
            <option>Ý tưởng</option>
            <option>HCNS</option>
            <option>IT</option>
          </select>
        </div>
        <div class="form-group">
          <label>Chức vụ</label>
          <input type="text" class="form-control" placeholder="Ví dụ: Nhân viên...">
        </div>
        <div class="form-group">
          <label>Người quản lý trực tiếp</label>
          <input type="text" class="form-control" placeholder="Tên sếp trực tiếp...">
        </div>
        <div class="form-group">
          <label>Loại hợp đồng lao động</label>
          <select class="form-control">
            <option>Thử việc</option>
            <option>Hợp đồng chính thức</option>
            <option>Hợp đồng vô thời hạn</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Tải lên hồ sơ/Giấy tờ đính kèm (CCCD, Bằng cấp...)</label>
        <input type="file" class="form-control">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('addEmpModal')">Hủy</button>
      <button class="btn-mini approve" onclick="alert('Đã tạo hồ sơ nhân viên mới thành công!'); closeModal('addEmpModal');">Tạo hồ sơ</button>
    </div>
  </div>
</div>

<!-- MODAL CẬP NHẬT HỒ SƠ & GIẤY TỜ (KHÔNG CÓ LƯƠNG) -->
<div class="modal-backdrop" id="editEmpModal">
  <div class="modal-card" style="width:650px;">
    <div class="modal-header">
      <div class="modal-title">Cập nhật hồ sơ &amp; Giấy tờ nhân viên</div>
      <button class="modal-close" onclick="closeModal('editEmpModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="form-group">
          <label>Họ và tên</label>
          <input type="text" id="editName" class="form-control">
        </div>
        <div class="form-group">
          <label>Ngày sinh</label>
          <input type="date" id="editDob" class="form-control">
        </div>
        <div class="form-group">
          <label>Số điện thoại</label>
          <input type="text" id="editPhone" class="form-control">
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="editEmail" class="form-control">
        </div>
        <div class="form-group">
          <label>Địa chỉ</label>
          <input type="text" id="editAddress" class="form-control">
        </div>
        <div class="form-group">
          <label>Ngày vào công ty</label>
          <input type="date" id="editJoined" class="form-control" readonly style="background:var(--blue-50);">
        </div>
        <div class="form-group">
          <label>Phòng ban</label>
          <input type="text" id="editDept" class="form-control" readonly style="background:var(--blue-50);">
        </div>
        <div class="form-group">
          <label>Chức vụ</label>
          <input type="text" id="editTitle" class="form-control" readonly style="background:var(--blue-50);">
        </div>
        <div class="form-group">
          <label>Người quản lý</label>
          <input type="text" id="editManager" class="form-control" readonly style="background:var(--blue-50);">
        </div>
        <div class="form-group">
          <label>Loại hợp đồng</label>
          <select class="form-control" id="editContract">
            <option value="Thử việc">Thử việc</option>
            <option value="Hợp đồng chính thức">Hợp đồng chính thức</option>
            <option value="Hợp đồng vô thời hạn">Hợp đồng vô thời hạn</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Danh sách giấy tờ hiện tại</label>
        <input type="text" id="editFiles" class="form-control" readonly style="background:var(--blue-50);">
      </div>
      <div class="form-group">
        <label>Tải lên bổ sung giấy tờ/Hợp đồng mới (.pdf, .jpg, .png)</label>
        <input type="file" class="form-control">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('editEmpModal')">Hủy</button>
      <button class="btn-mini approve" onclick="alert('Đã cập nhật hồ sơ và lưu trữ giấy tờ bổ sung thành công!'); closeModal('editEmpModal');">Lưu cập nhật</button>
    </div>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).classList.add('active');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }

  function openEditModal(name, dob, phone, email, address, joined, dept, title, manager, contract, status, files) {
    document.getElementById('editName').value = name;
    document.getElementById('editDob').value = dob;
    document.getElementById('editPhone').value = phone;
    document.getElementById('editEmail').value = email;
    document.getElementById('editAddress').value = address;
    document.getElementById('editJoined').value = joined;
    document.getElementById('editDept').value = dept;
    document.getElementById('editTitle').value = title;
    document.getElementById('editManager').value = manager;
    document.getElementById('editContract').value = contract;
    document.getElementById('editFiles').value = files;
    openModal('editEmpModal');
  }
</script>
</body>
</html>
