<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Vận hành Nhân sự (Quản lý HCNS)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
  <style>
    .flex-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      gap: 16px;
      flex-wrap: wrap;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
    }
  </style>
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Vận hành nhân sự</div>
    <a href="/ManageHuman/HumanResources" class="nav-item active"><i class="ti ti-users"></i>Hồ sơ nhân sự</a>
    <a href="/ManageHuman/AssignTasks" class="nav-item"><i class="ti ti-checklist"></i>Giao việc &amp; Phân công</a>
    <a href="/ManageHuman/Repoted" class="nav-item"><i class="ti ti-report-analytics"></i>Báo cáo nhân sự</a>

    <div class="sidebar-footer">
      <div class="role-pill">
        <div class="avatar">HR</div>
        <div>
          <div class="role-name">Vũ Ngọc Lan</div>
          <div class="role-title">Quản lý HCNS</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Hồ sơ &amp; Hồ sơ nhân viên</div>
        <div class="page-sub">Quản lý cơ sở dữ liệu nhân sự toàn công ty, cập nhật hồ sơ, điều chuyển phòng ban và chức vụ</div>
      </div>
    </div>

    <div class="card">
      <div class="flex-bar">
        <div style="width: 300px;">
          <input type="text" class="form-control" placeholder="Tìm tên nhân viên, phòng ban...">
        </div>
        <button class="btn-mini approve" style="padding: 10px 18px;" onclick="openModal('addEmpModal')"><i class="ti ti-plus"></i> Thêm nhân viên mới</button>
      </div>

      <table>
        <thead>
          <tr>
            <th>Họ và tên</th>
            <th>Phòng ban</th>
            <th>Chức vụ</th>
            <th>Loại hợp đồng</th>
            <th>Liên hệ (SĐT / Email)</th>
            <th>Ngày vào</th>
            <th>Trạng thái</th>
            <th style="text-align: right;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Phạm Thu Hà</strong></td>
            <td><span class="dept-chip">Booking</span></td>
            <td>Nhân viên</td>
            <td>Hợp đồng chính thức</td>
            <td>0912.xxx.xxx<br><span style="color:var(--muted); font-size:11.5px;">ha@hanamedia.vn</span></td>
            <td>05/08/2026</td>
            <td><span class="status-chip status-good">Đang làm việc</span></td>
            <td style="text-align: right;">
              <button class="btn-mini approve" onclick="openEditModal('Phạm Thu Hà', '1998-05-12', '0912.xxx.xxx', 'ha@hanamedia.vn', 'Hà Nội', '05/08/2026', 'Booking', 'Nhân viên', 'Nguyễn Anh Tuấn', 'Hợp đồng chính thức', 'Đang làm việc')">Sửa</button>
              <button class="btn-mini reject" onclick="alert('Đã ngừng hoạt động nhân viên!')">Ngừng việc</button>
            </td>
          </tr>
          <tr>
            <td><strong>Nguyễn Anh Tuấn</strong></td>
            <td><span class="dept-chip">Booking</span></td>
            <td>Quản lý</td>
            <td>Hợp đồng vô thời hạn</td>
            <td>0988.xxx.xxx<br><span style="color:var(--muted); font-size:11.5px;">tuan@hanamedia.vn</span></td>
            <td>15/03/2023</td>
            <td><span class="status-chip status-warn">Đang chờ duyệt lương</span></td>
            <td style="text-align: right;">
              <button class="btn-mini approve" onclick="openEditModal('Nguyễn Anh Tuấn', '1990-09-20', '0988.xxx.xxx', 'tuan@hanamedia.vn', 'Hà Nội', '15/03/2023', 'Booking', 'Quản lý', 'Giám đốc Nguyễn Văn A', 'Hợp đồng vô thời hạn', 'Đang chờ duyệt lương')">Sửa</button>
              <button class="btn-mini reject" onclick="alert('Đã ngừng hoạt động nhân viên!')">Ngừng việc</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <footer>HanaMedia · Dashboard Quản lý HCNS — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<!-- MODAL THÊM NHÂN VIÊN MỚI -->
<div class="modal-backdrop" id="addEmpModal">
  <div class="modal-card" style="width:650px;">
    <div class="modal-header">
      <div class="modal-title">Thêm hồ sơ nhân viên mới</div>
      <button class="modal-close" onclick="closeModal('addEmpModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="form-group">
          <label>Họ và tên</label>
          <input type="text" class="form-control" placeholder="Họ tên đầy đủ...">
        </div>
        <div class="form-group">
          <label>Ngày sinh</label>
          <input type="date" class="form-control">
        </div>
        <div class="form-group">
          <label>Số điện thoại</label>
          <input type="text" class="form-control" placeholder="Số điện thoại cá nhân...">
        </div>
        <div class="form-group">
          <label>Email cá nhân</label>
          <input type="email" class="form-control" placeholder="Địa chỉ email...">
        </div>
        <div class="form-group">
          <label>Địa chỉ</label>
          <input type="text" class="form-control" placeholder="Địa chỉ thường trú...">
        </div>
        <div class="form-group">
          <label>Ngày vào công ty</label>
          <input type="date" class="form-control">
        </div>
        <div class="form-group">
          <label>Phòng ban</label>
          <select class="form-control">
            <option>Booking</option>
            <option>Ý tưởng</option>
            <option>HCNS</option>
            <option>IT</option>
          </select>
        </div>
        <div class="form-group">
          <label>Chức vụ</label>
          <input type="text" class="form-control" placeholder="Ví dụ: Nhân viên, Quản lý...">
        </div>
        <div class="form-group">
          <label>Người quản lý trực tiếp</label>
          <input type="text" class="form-control" placeholder="Tên sếp trực tiếp...">
        </div>
        <div class="form-group">
          <label>Loại hợp đồng</label>
          <select class="form-control">
            <option>Thử việc</option>
            <option>Hợp đồng chính thức</option>
            <option>Hợp đồng vô thời hạn</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Trạng thái ban đầu</label>
        <select class="form-control">
          <option>Đang làm việc</option>
          <option>Thử việc</option>
        </select>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('addEmpModal')">Hủy</button>
      <button class="btn-mini approve" onclick="alert('Thêm nhân sự mới thành công!'); closeModal('addEmpModal');">Thêm nhân viên</button>
    </div>
  </div>
</div>

<!-- MODAL SỬA NHÂN VIÊN -->
<div class="modal-backdrop" id="editEmpModal">
  <div class="modal-card" style="width:650px;">
    <div class="modal-header">
      <div class="modal-title">Cập nhật hồ sơ nhân sự</div>
      <button class="modal-close" onclick="closeModal('editEmpModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="form-group">
          <label>Họ và tên</label>
          <input type="text" id="editName" class="form-control">
        </div>
        <div class="form-group">
          <label>Ngày sinh</label>
          <input type="date" id="editDob" class="form-control">
        </div>
        <div class="form-group">
          <label>Số điện thoại</label>
          <input type="text" id="editPhone" class="form-control">
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="editEmail" class="form-control">
        </div>
        <div class="form-group">
          <label>Địa chỉ</label>
          <input type="text" id="editAddress" class="form-control">
        </div>
        <div class="form-group">
          <label>Ngày vào công ty</label>
          <input type="date" id="editJoined" class="form-control">
        </div>
        <div class="form-group">
          <label>Phòng ban</label>
          <select class="form-control" id="editDept">
            <option value="Booking">Booking</option>
            <option value="Ý tưởng">Ý tưởng</option>
            <option value="HCNS">HCNS</option>
            <option value="IT">IT</option>
          </select>
        </div>
        <div class="form-group">
          <label>Chức vụ</label>
          <input type="text" id="editTitle" class="form-control">
        </div>
        <div class="form-group">
          <label>Người quản lý</label>
          <input type="text" id="editManager" class="form-control">
        </div>
        <div class="form-group">
          <label>Loại hợp đồng</label>
          <select class="form-control" id="editContract">
            <option value="Thử việc">Thử việc</option>
            <option value="Hợp đồng chính thức">Hợp đồng chính thức</option>
            <option value="Hợp đồng vô thời hạn">Hợp đồng vô thời hạn</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Trạng thái hoạt động</label>
        <select class="form-control" id="editStatus">
          <option value="Đang làm việc">Đang làm việc</option>
          <option value="Đang chờ duyệt lương">Đang chờ duyệt lương</option>
          <option value="Chờ duyệt nghỉ việc">Chờ duyệt nghỉ việc</option>
        </select>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('editEmpModal')">Hủy</button>
      <button class="btn-mini approve" onclick="alert('Đã cập nhật thay đổi thông tin nhân viên!'); closeModal('editEmpModal');">Lưu thay đổi</button>
    </div>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).classList.add('active');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }

  function openEditModal(name, dob, phone, email, address, joined, dept, title, manager, contract, status) {
    document.getElementById('editName').value = name;
    document.getElementById('editDob').value = dob;
    document.getElementById('editPhone').value = phone;
    document.getElementById('editEmail').value = email;
    document.getElementById('editAddress').value = address;
    document.getElementById('editJoined').value = joined;
    document.getElementById('editDept').value = dept;
    document.getElementById('editTitle').value = title;
    document.getElementById('editManager').value = manager;
    document.getElementById('editContract').value = contract;
    document.getElementById('editStatus').value = status;
    openModal('editEmpModal');
  }
</script>
</body>
</html>
