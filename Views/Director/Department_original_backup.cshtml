<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Cơ cấu Phòng ban (Giám đốc)</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body>
<div class="layout">

  <partial name="_SidebarPartial" />


  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Cơ cấu &amp; Hiệu suất Phòng ban</div>
        <div class="page-sub">Xem danh sách các phòng ban và hiệu suất hoàn thành mục tiêu công việc</div>
      </div>
    </div>

    <div class="grid-3" style="margin-bottom: 22px;">
      <div class="card">
        <div class="card-head">
          <div class="card-title">Booking</div>
          <span class="dept-chip">46 nhân sự</span>
        </div>
        <div style="margin-bottom: 12px;">
          <div style="font-size: 12px; color: var(--muted); font-weight: 700;">TRƯỞNG PHÒNG</div>
          <div style="font-size: 14px; font-weight: 600; color: var(--navy); margin-top: 2px;">Nguyễn Anh Tuấn</div>
        </div>
        <div>
          <div style="font-size: 12px; color: var(--muted); font-weight: 700; margin-bottom: 4px;">HIỆU SUẤT THÁNG 8</div>
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span class="bar-mini" style="width: 80%;"><span class="bar-mini-fill" style="width: 92%;"></span></span>
            <span style="font-size: 13px; font-weight: 700;">92%</span>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <div class="card-title">Ý tưởng &amp; Sáng tạo</div>
          <span class="dept-chip">38 nhân sự</span>
        </div>
        <div style="margin-bottom: 12px;">
          <div style="font-size: 12px; color: var(--muted); font-weight: 700;">TRƯỞNG PHÒNG</div>
          <div style="font-size: 14px; font-weight: 600; color: var(--navy); margin-top: 2px;">Trần Thanh Hải</div>
        </div>
        <div>
          <div style="font-size: 12px; color: var(--muted); font-weight: 700; margin-bottom: 4px;">HIỆU SUẤT THÁNG 8</div>
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span class="bar-mini" style="width: 80%;"><span class="bar-mini-fill" style="width: 87%;"></span></span>
            <span style="font-size: 13px; font-weight: 700;">87%</span>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <div class="card-title">Hành chính - Nhân sự</div>
          <span class="dept-chip">14 nhân sự</span>
        </div>
        <div style="margin-bottom: 12px;">
          <div style="font-size: 12px; color: var(--muted); font-weight: 700;">TRƯỞNG PHÒNG</div>
          <div style="font-size: 14px; font-weight: 600; color: var(--navy); margin-top: 2px;">Vũ Ngọc Lan</div>
        </div>
        <div>
          <div style="font-size: 12px; color: var(--muted); font-weight: 700; margin-bottom: 4px;">HIỆU SUẤT THÁNG 8</div>
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span class="bar-mini" style="width: 80%;"><span class="bar-mini-fill" style="width: 95%;"></span></span>
            <span style="font-size: 13px; font-weight: 700;">95%</span>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <div class="card-title">Danh sách phòng ban</div>
      </div>
      <table>
        <thead>
          <tr>
            <th>Phòng ban</th>
            <th>Trưởng phòng</th>
            <th>Số lượng nhân sự</th>
            <th>Hiệu suất trung bình (Tháng)</th>
            <th>Đánh giá chất lượng</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Hành chính - Nhân sự (HCNS)</strong></td>
            <td>Vũ Ngọc Lan</td>
            <td>14 nhân sự</td>
            <td><span class="bar-mini"><span class="bar-mini-fill" style="width:95%"></span></span>95%</td>
            <td><span class="status-chip status-good">Tốt</span></td>
          </tr>
          <tr>
            <td><strong>Booking (KOL/KOC)</strong></td>
            <td>Nguyễn Anh Tuấn</td>
            <td>46 nhân sự</td>
            <td><span class="bar-mini"><span class="bar-mini-fill" style="width:92%"></span></span>92%</td>
            <td><span class="status-chip status-good">Tốt</span></td>
          </tr>
          <tr>
            <td><strong>Ý tưởng &amp; Sáng tạo</strong></td>
            <td>Trần Thanh Hải</td>
            <td>38 nhân sự</td>
            <td><span class="bar-mini"><span class="bar-mini-fill" style="width:87%"></span></span>87%</td>
            <td><span class="status-chip status-good">Tốt</span></td>
          </tr>
          <tr>
            <td><strong>Kỹ thuật hệ thống (IT)</strong></td>
            <td>AdminIT (Phụ trách kỹ thuật)</td>
            <td>8 nhân sự</td>
            <td><span class="bar-mini"><span class="bar-mini-fill" style="width:90%"></span></span>90%</td>
            <td><span class="status-chip status-good">Tốt</span></td>
          </tr>
          <tr>
            <td><strong>Kế toán - Tài chính</strong></td>
            <td>Phan Thị Kim Anh</td>
            <td>12 nhân sự</td>
            <td><span class="bar-mini"><span class="bar-mini-fill" style="width:74%"></span></span>74%</td>
            <td><span class="status-chip status-warn">Theo dõi sát sao</span></td>
          </tr>
        </tbody>
      </table>
    </div>

  </main>
</div>
</body>
</html>
