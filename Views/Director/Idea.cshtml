@model HanaMedia.ViewModels.DirectorIdeaPageViewModel
@using HanaMedia.Constants
@using System.Text.Json
@{
  Layout = null;
  var ideasJson = JsonSerializer.Serialize(Model.Items, new JsonSerializerOptions { PropertyNamingPolicy = null });
  string PageUrl(int page) => Url.Action("Idea", "Director", new { search = Model.Search, status = Model.Status, directorStatus = Model.DirectorStatus, page }) ?? "#";
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Duyệt Ý tưởng</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css"><link rel="stylesheet" href="~/css/layout.css"><link rel="stylesheet" href="~/css/components.css">
  <style>
    .filter-grid{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:10px;align-items:end}.status-director{display:inline-flex;align-items:center;padding:4px 9px;border-radius:999px;font-size:11px;font-weight:700}.status-director.pending{background:#fff7ed;color:#c2410c}.status-director.revision_requested{background:#fef2f2;color:#dc2626}.status-director.approved{background:#ecfdf5;color:#047857}.status-director.rejected{background:#fef2f2;color:#b91c1c}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.detail-box{background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px}.detail-label{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);margin-bottom:5px}.detail-value{white-space:pre-wrap;line-height:1.5}.source-feedback{border-left:4px solid;padding:10px 12px;border-radius:6px;margin-top:10px}.source-feedback.manager{border-color:#2563eb;background:#eff6ff}.source-feedback.director{border-color:#f59e0b;background:#fffbeb}.action-section{border-top:1px solid var(--line);margin-top:16px;padding-top:16px}.action-row{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}.moodboard-grid{display:flex;gap:8px;flex-wrap:wrap}.moodboard-grid img{width:110px;height:80px;object-fit:cover;border-radius:7px;border:1px solid var(--line)}.pagination{display:flex;justify-content:center;gap:6px;margin-top:16px}.pagination a,.pagination span{padding:7px 11px;border:1px solid var(--line);border-radius:6px;text-decoration:none}.pagination .active{background:var(--blue-600);color:#fff}@@media(max-width:900px){.filter-grid,.detail-grid{grid-template-columns:1fr}}
  </style>
</head>
<body>
<div class="layout"><partial name="_SidebarPartial" /><main class="main">
  <div class="topbar"><div><div class="page-title">Ý tưởng — Duyệt của Giám đốc</div><div class="page-sub">Xem, chỉnh sửa, feedback và duyệt độc lập với luồng review của Quản lý Ý tưởng</div></div></div>
  @if (TempData["SuccessMessage"] is string success){<div class="message message-success" style="margin-bottom:14px">@success</div>}
  @if (TempData["ErrorMessage"] is string error){<div class="message message-error" style="margin-bottom:14px">@error</div>}
  <div class="card" style="margin-bottom:14px"><form method="get" asp-action="Idea" class="filter-grid">
    <div class="form-group"><label>Tìm kiếm</label><input class="form-control" name="search" value="@Model.Search" placeholder="Tên ý tưởng, client, chiến dịch..."></div>
    <div class="form-group"><label>Trạng thái ý tưởng</label><select class="form-control" name="status"><option value="">Tất cả</option>@foreach(var value in IdeaStatuses.All){<option value="@value" selected="@(Model.Status == value)">@IdeaStatuses.GetLabel(value)</option>}</select></div>
    <div class="form-group"><label>Duyệt của Giám đốc</label><select class="form-control" name="directorStatus"><option value="">Tất cả</option>@foreach(var value in DirectorIdeaReviewStatuses.All){<option value="@value" selected="@(Model.DirectorStatus == value)">@DirectorIdeaReviewStatuses.GetLabel(value)</option>}</select></div>
    <button class="btn-mini approve" type="submit"><i class="ti ti-search"></i> Lọc</button>
  </form></div>
  <div class="card"><div class="card-head"><div class="card-title">Danh sách ý tưởng (@Model.TotalItems)</div></div><div style="overflow-x:auto"><table>
    <thead><tr><th style="width:72px">ID</th><th>Ý tưởng</th><th>Người tạo</th><th>Client &amp; chiến dịch</th><th>Review QL Ý tưởng</th><th>Giám đốc</th><th style="text-align:right">Hành động</th></tr></thead><tbody>
    @if(Model.Items.Count==0){<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--muted)">Không có ý tưởng phù hợp.</td></tr>}
    @foreach(var item in Model.Items){<tr><td><strong>@item.Id</strong></td><td><strong>@item.Title</strong><div class="page-sub">Deadline @item.Deadline.ToString("dd/MM/yyyy")</div></td><td>@item.CreatorName<div class="page-sub">Phụ trách: @item.PrimaryStaffName</div></td><td>@item.ClientName<div class="page-sub">@item.CampaignName</div></td><td><span class="status-chip">@item.StatusLabel</span></td><td><span class="status-director @item.DirectorReviewStatus">@item.DirectorReviewStatusLabel</span></td><td style="text-align:right"><button class="btn-mini @(item.DirectorReviewStatus == DirectorIdeaReviewStatuses.Pending ? "approve" : "")" type="button" onclick="openIdea(@item.Id)">Chi tiết / Duyệt</button></td></tr>}
    </tbody></table></div>
    @if (Model.TotalPages > 1)
    {
      <div class="pagination">
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
        {
          if (pageNumber == Model.Page)
          {
            <span class="active">@pageNumber</span>
          }
          else
          {
            <a href="@PageUrl(pageNumber)">@pageNumber</a>
          }
        }
      </div>
    }
  </div>
</main></div>

<div class="modal-backdrop" id="ideaModal"><div class="modal-card" style="width:900px;max-width:96%"><div class="modal-header"><div class="modal-title"><i class="ti ti-bulb"></i> <span id="detailTitle">Chi tiết ý tưởng</span></div><button class="modal-close" type="button" onclick="closeIdea()">&times;</button></div><div class="modal-body" style="max-height:72vh;overflow:auto">
  <div class="detail-grid"><div class="detail-box"><div class="detail-label">Client — Chiến dịch</div><div id="detailCampaign" class="detail-value"></div></div><div class="detail-box"><div class="detail-label">Người thực hiện — Người review</div><div id="detailPeople" class="detail-value"></div></div><div class="detail-box"><div class="detail-label">Trạng thái QL Ý tưởng</div><div id="detailCoreStatus" class="detail-value"></div></div><div class="detail-box"><div class="detail-label">Trạng thái Giám đốc</div><div id="detailDirectorStatus" class="detail-value"></div></div></div>
  <div id="managerFeedback" class="source-feedback manager" style="display:none"></div><div id="directorFeedback" class="source-feedback director" style="display:none"></div>
  <form asp-action="EditIdea" method="post" class="action-section"><input type="hidden" name="Id" id="editId"><div class="card-title" style="margin-bottom:10px">Giám đốc chỉnh sửa trực tiếp</div><div class="form-group"><label>Insight</label><textarea class="form-control" name="Insight" id="editInsight" maxlength="2000" rows="3"></textarea></div><div class="form-group"><label>Concept</label><textarea class="form-control" name="Concept" id="editConcept" maxlength="4000" rows="3"></textarea></div><div class="form-group"><label>Nội dung</label><textarea class="form-control" name="ContentDetails" id="editContent" maxlength="8000" rows="4"></textarea></div><div class="form-group"><label>Script</label><textarea class="form-control" name="ScriptText" id="editScript" maxlength="12000" rows="5"></textarea></div><div id="referenceArea"></div><div id="moodboardArea" class="moodboard-grid" style="margin-top:10px"></div><div class="action-row"><button class="btn-mini" type="submit"><i class="ti ti-device-floppy"></i> Lưu chỉnh sửa</button></div></form>
  <form asp-action="SendIdeaFeedback" method="post" class="action-section"><input type="hidden" name="id" id="feedbackId"><div class="card-title" style="margin-bottom:10px">Yêu cầu nhân viên chỉnh sửa</div><textarea class="form-control" name="feedback" maxlength="2000" rows="3" required placeholder="Nhập feedback của Giám đốc..."></textarea><div class="action-row" style="margin-top:8px"><button class="btn-mini reject" type="submit"><i class="ti ti-message-circle"></i> Gửi feedback</button></div></form>
  <form asp-action="DecideIdea" method="post" class="action-section"><input type="hidden" name="id" id="decisionId"><div class="card-title" style="margin-bottom:10px">Quyết định độc lập của Giám đốc</div><textarea class="form-control" name="reason" maxlength="2000" rows="3" placeholder="Nhận xét khi duyệt; bắt buộc nếu từ chối..."></textarea><div class="action-row" style="margin-top:8px"><button class="btn-mini approve" name="decision" value="approve" type="submit"><i class="ti ti-check"></i> Duyệt</button><button class="btn-mini reject" name="decision" value="reject" type="submit"><i class="ti ti-x"></i> Từ chối</button></div></form>
  <div class="action-section"><div class="card-title">Lịch sử trao đổi</div><div id="commentsArea" style="margin-top:8px"></div></div>
</div><div class="modal-footer"><button class="btn-mini" type="button" onclick="closeIdea()">Đóng</button></div></div></div>

<script id="directorIdeaData" type="application/json">@Html.Raw(ideasJson)</script><script>
const ideas=JSON.parse(document.getElementById('directorIdeaData').textContent);function escapeHtml(value){const el=document.createElement('div');el.textContent=value??'';return el.innerHTML}function setValue(id,value){const el=document.getElementById(id);if(el)el.value=value??''}
function openIdea(id){const idea=ideas.find(item=>item.Id===id);if(!idea)return;document.getElementById('detailTitle').textContent=idea.Title;document.getElementById('detailCampaign').textContent=`${idea.ClientName} — ${idea.CampaignName}`;document.getElementById('detailPeople').textContent=`${idea.PrimaryStaffName} — review: ${idea.ReviewerName}`;document.getElementById('detailCoreStatus').textContent=idea.StatusLabel;document.getElementById('detailDirectorStatus').textContent=idea.DirectorReviewStatusLabel;const manager=document.getElementById('managerFeedback');manager.style.display=idea.ManagerFeedback?'block':'none';manager.textContent=idea.ManagerFeedback?`QL Ý tưởng: ${idea.ManagerFeedback}`:'';const director=document.getElementById('directorFeedback');director.style.display=idea.DirectorFeedback?'block':'none';director.textContent=idea.DirectorFeedback?`Giám đốc: ${idea.DirectorFeedback}`:'';setValue('editId',idea.Id);setValue('feedbackId',idea.Id);setValue('decisionId',idea.Id);setValue('editInsight',idea.Insight);setValue('editConcept',idea.Concept);setValue('editContent',idea.ContentDetails);setValue('editScript',idea.ScriptText);const reference=document.getElementById('referenceArea');reference.innerHTML=idea.ReferenceFileUrl?`<a class="btn-mini" href="${encodeURI(idea.ReferenceFileUrl)}" target="_blank"><i class="ti ti-paperclip"></i> Tệp reference</a>`:(idea.ReferenceLink?`<a class="btn-mini" href="${encodeURI(idea.ReferenceLink)}" target="_blank"><i class="ti ti-link"></i> Link reference</a>`:'');document.getElementById('moodboardArea').innerHTML=idea.MoodboardImages.length?idea.MoodboardImages.map(image=>`<a href="${encodeURI(image.FileUrl)}" target="_blank"><img src="${encodeURI(image.FileUrl)}" alt="Moodboard"></a>`).join(''):(idea.MoodboardDescription?`<div class="detail-value">${escapeHtml(idea.MoodboardDescription)}</div>`:'');document.getElementById('commentsArea').innerHTML=idea.Comments.length?idea.Comments.map(comment=>`<div class="detail-box" style="margin-bottom:7px"><strong>${escapeHtml(comment.AuthorName)}</strong> · ${escapeHtml(comment.AuthorRole)} · ${new Date(comment.CreatedAt).toLocaleString('vi-VN')}<div style="margin-top:4px">${escapeHtml(comment.Content)}</div></div>`).join(''):'<div class="page-sub">Chưa có trao đổi.</div>';document.getElementById('ideaModal').classList.add('active')}
function closeIdea(){document.getElementById('ideaModal').classList.remove('active')}document.addEventListener('DOMContentLoaded',()=>{const focus=Number(new URLSearchParams(location.search).get('focus'));if(focus)openIdea(focus)});
</script></body></html>
