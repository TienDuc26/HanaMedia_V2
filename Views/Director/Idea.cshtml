@model HanaMedia.ViewModels.DirectorIdeaPageViewModel
@using HanaMedia.Constants
@using System.Text.Json
@{
  Layout = null;
  var ideasJson = JsonSerializer.Serialize(Model.Items, new JsonSerializerOptions { PropertyNamingPolicy = null });
  string PageUrl(int page) => Url.Action("Idea", "Director", new { search = Model.Search, status = Model.Status, directorStatus = Model.DirectorStatus, page }) ?? "#";
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Duyệt Ý tưởng</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css"><link rel="stylesheet" href="~/css/layout.css"><link rel="stylesheet" href="~/css/components.css">
  <style>
    .filter-grid{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:10px;align-items:end}.status-director{display:inline-flex;align-items:center;padding:4px 9px;border-radius:999px;font-size:11px;font-weight:700}.status-director.pending{background:#fff7ed;color:#c2410c}.status-director.revision_requested{background:#fef2f2;color:#dc2626}.status-director.approved{background:#ecfdf5;color:#047857}.status-director.rejected{background:#fef2f2;color:#b91c1c}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.detail-box{background:#f8fafc;border:1px solid var(--line);border-radius:8px;padding:12px}.detail-label{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--muted);margin-bottom:5px}.detail-value{white-space:pre-wrap;line-height:1.5}.source-feedback{border-left:4px solid;padding:10px 12px;border-radius:6px;margin-top:10px}.source-feedback.manager{border-color:#2563eb;background:#eff6ff}.source-feedback.director{border-color:#f59e0b;background:#fffbeb}.action-row{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}.moodboard-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}.moodboard-grid img{width:100%;height:110px;object-fit:cover;border-radius:8px;border:1px solid var(--line)}.pagination{display:flex;justify-content:center;gap:6px;margin-top:16px}.pagination a,.pagination span{padding:7px 11px;border:1px solid var(--line);border-radius:6px;text-decoration:none}.pagination .active{background:var(--blue-600);color:#fff}
    .director-idea-modal{width:min(1240px,96vw);max-width:96vw;max-height:94vh;border-radius:14px;overflow:hidden}.director-idea-modal .modal-header{padding:14px 22px;background:#fff;border-bottom:1px solid var(--line)}.director-idea-modal .modal-body{max-height:calc(94vh - 116px);overflow:auto;padding:22px;background:#f5f8fc}.director-idea-modal .modal-footer{padding:12px 22px;background:#fff;border-top:1px solid var(--line)}.director-idea-hero{padding:20px 24px;margin-bottom:18px;background:#fff;border:1px solid var(--line);border-radius:12px}.director-idea-heading{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.director-idea-heading h2{margin:0;font-size:25px;color:var(--navy)}.director-idea-id{padding:6px 10px;border:1px solid #bfdbfe;border-radius:7px;background:#eff6ff;color:#0b63ce;font-size:13px;font-weight:800}.director-idea-meta{display:flex;gap:18px;flex-wrap:wrap;margin-top:12px;color:var(--muted);font-size:13px}.director-idea-meta span{display:inline-flex;align-items:center;gap:6px}.director-idea-columns{display:grid;grid-template-columns:minmax(0,2fr) minmax(300px,.9fr);gap:18px;align-items:start}.director-idea-column{display:grid;gap:18px}.director-idea-card{padding:20px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 4px 14px rgba(15,42,74,.035)}.director-idea-card-title{display:flex;align-items:center;gap:8px;margin:0 0 5px;color:var(--navy);font-size:15px;font-weight:800;text-transform:uppercase}.director-idea-card-title i{color:var(--blue-600);font-size:18px}.director-idea-card-sub{margin-bottom:16px;color:var(--muted);font-size:12px}.director-idea-card .form-group label{font-size:11px;letter-spacing:.035em;text-transform:uppercase;color:#7385a0}.director-idea-card textarea{line-height:1.5}.director-detail-item{padding:12px 0;border-bottom:1px solid var(--line)}.director-detail-item:last-child{border-bottom:0}.director-detail-value{margin-top:5px;color:var(--navy);font-weight:650}.director-action-card{padding-top:18px;border-top:1px solid var(--line);margin-top:18px}.director-action-card:first-of-type{padding-top:0;border-top:0;margin-top:0}.director-progress{display:grid;grid-template-columns:repeat(6,minmax(68px,1fr));margin-top:14px}.director-progress-step{position:relative;text-align:center;padding:0 3px;color:#8796aa;font-size:11px}.director-progress-step:not(:last-child)::after{content:"";position:absolute;top:15px;left:calc(50% + 17px);right:calc(-50% + 17px);height:2px;background:#dce4ef}.director-progress-step span:first-child{position:relative;z-index:1;display:grid;place-items:center;width:32px;height:32px;margin:0 auto 7px;border:2px solid #cbd7e6;border-radius:50%;background:#fff;font-weight:800}.director-progress-step.complete,.director-progress-step.current{color:#0b63ce;font-weight:700}.director-progress-step.complete span:first-child{border-color:#15945c;background:#15945c;color:#fff}.director-progress-step.complete:not(:last-child)::after{background:#15945c}.director-progress-step.current span:first-child{border-color:#0b63ce;background:#eaf3ff}.director-doc-empty{color:var(--muted);font-size:13px}
    @@media(max-width:1000px){.director-idea-columns{grid-template-columns:1fr}.director-progress{overflow-x:auto;grid-template-columns:repeat(6,110px);padding-bottom:6px}}@@media(max-width:900px){.filter-grid,.detail-grid{grid-template-columns:1fr}.director-idea-modal .modal-body{padding:14px}.director-idea-heading h2{font-size:20px}}
  </style>
</head>
<body>
<div class="layout"><partial name="_SidebarPartial" /><main class="main">
  <div class="topbar"><div><div class="page-title">Ý tưởng — Duyệt của Giám đốc</div><div class="page-sub">Xem, chỉnh sửa, feedback và duyệt độc lập với luồng review của Quản lý Ý tưởng</div></div></div>
  @if (TempData["SuccessMessage"] is string success){<div class="message message-success" style="margin-bottom:14px">@success</div>}
  @if (TempData["ErrorMessage"] is string error){<div class="message message-error" style="margin-bottom:14px">@error</div>}
  <div class="card" style="margin-bottom:14px"><form method="get" asp-action="Idea" class="filter-grid">
    <div class="form-group"><label>Tìm kiếm</label><input class="form-control" name="search" value="@Model.Search" placeholder="Tên ý tưởng, client, chiến dịch..."></div>
    <div class="form-group"><label>Trạng thái ý tưởng</label><select class="form-control" name="status"><option value="">Tất cả</option>@foreach(var value in IdeaStatuses.All){<option value="@value" selected="@(Model.Status == value)">@IdeaStatuses.GetLabel(value)</option>}</select></div>
    <div class="form-group"><label>Duyệt của Giám đốc</label><select class="form-control" name="directorStatus"><option value="">Tất cả</option>@foreach(var value in DirectorIdeaReviewStatuses.All){<option value="@value" selected="@(Model.DirectorStatus == value)">@DirectorIdeaReviewStatuses.GetLabel(value)</option>}</select></div>
    <button class="btn-mini approve" type="submit"><i class="ti ti-search"></i> Lọc</button>
  </form></div>
  <div class="card"><div class="card-head"><div class="card-title">Danh sách ý tưởng (@Model.TotalItems)</div></div><div style="overflow-x:auto"><table>
    <thead><tr><th style="width:72px">ID</th><th>Ý tưởng</th><th>Người tạo</th><th>Client &amp; chiến dịch</th><th>Review QL Ý tưởng</th><th>Giám đốc</th><th style="text-align:right">Hành động</th></tr></thead><tbody>
    @if(Model.Items.Count==0){<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--muted)">Không có ý tưởng phù hợp.</td></tr>}
    @foreach(var item in Model.Items){<tr><td><strong>@item.Id</strong></td><td><strong>@item.Title</strong><div class="page-sub">Deadline @item.Deadline.ToString("dd/MM/yyyy")</div></td><td>@item.CreatorName<div class="page-sub">Phụ trách: @item.PrimaryStaffName</div></td><td>@item.ClientName<div class="page-sub">@item.CampaignName</div></td><td><span class="status-chip">@item.StatusLabel</span></td><td><span class="status-director @item.DirectorReviewStatus">@item.DirectorReviewStatusLabel</span></td><td style="text-align:right"><button class="btn-mini @(item.DirectorReviewStatus == DirectorIdeaReviewStatuses.Pending ? "approve" : "")" type="button" onclick="openIdea(@item.Id)">Chi tiết / Duyệt</button></td></tr>}
    </tbody></table></div>
    @if (Model.TotalPages > 1)
    {
      <div class="pagination">
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
        {
          if (pageNumber == Model.Page)
          {
            <span class="active">@pageNumber</span>
          }
          else
          {
            <a href="@PageUrl(pageNumber)">@pageNumber</a>
          }
        }
      </div>
    }
  </div>
</main></div>

<div class="modal-backdrop" id="ideaModal"><div class="modal-card director-idea-modal">
  <div class="modal-header"><div class="modal-title"><i class="ti ti-bulb"></i> Chi tiết &amp; duyệt ý tưởng</div><button class="modal-close" type="button" onclick="closeIdea()">&times;</button></div>
  <div class="modal-body">
    <div class="director-idea-hero">
      <div class="director-idea-heading"><span class="director-idea-id">Ý TƯỞNG #<span id="detailIdeaId">0</span></span><h2 id="detailTitle">Chi tiết ý tưởng</h2><span class="status-director" id="detailDirectorBadge">Trạng thái</span></div>
      <div class="director-idea-meta"><span><i class="ti ti-building"></i> <strong id="detailClient">—</strong></span><span><i class="ti ti-rocket"></i> <strong id="detailCampaign">—</strong></span></div>
    </div>

    <div class="director-idea-columns">
      <div class="director-idea-column">
        <section class="director-idea-card">
          <h3 class="director-idea-card-title"><i class="ti ti-edit"></i> Nội dung ý tưởng</h3><div class="director-idea-card-sub">Giám đốc có thể chỉnh sửa trực tiếp mà không thay đổi luồng duyệt</div>
          <form asp-action="EditIdea" method="post"><input type="hidden" name="Id" id="editId"><div class="form-group"><label>Insight</label><textarea class="form-control" name="Insight" id="editInsight" maxlength="2000" rows="3"></textarea></div><div class="form-group"><label>Concept</label><textarea class="form-control" name="Concept" id="editConcept" maxlength="4000" rows="3"></textarea></div><div class="form-group"><label>Nội dung triển khai</label><textarea class="form-control" name="ContentDetails" id="editContent" maxlength="8000" rows="5"></textarea></div><div class="form-group"><label>Kịch bản</label><textarea class="form-control" name="ScriptText" id="editScript" maxlength="12000" rows="7"></textarea></div><div class="action-row"><button class="btn-mini" type="submit"><i class="ti ti-device-floppy"></i> Lưu chỉnh sửa</button></div></form>
        </section>

        <section class="director-idea-card">
          <h3 class="director-idea-card-title"><i class="ti ti-route"></i> Quy trình ý tưởng</h3><div class="director-idea-card-sub">Tiến độ từ ý tưởng ban đầu đến hoàn thành</div>
          <div class="director-progress" id="directorIdeaProgress"><div class="director-progress-step"><span>1</span><span>Ý tưởng</span></div><div class="director-progress-step"><span>2</span><span>Review</span></div><div class="director-progress-step"><span>3</span><span>Chỉnh sửa</span></div><div class="director-progress-step"><span>4</span><span>Đã duyệt</span></div><div class="director-progress-step"><span>5</span><span>Triển khai</span></div><div class="director-progress-step"><span>6</span><span>Hoàn thành</span></div></div>
        </section>

        <section class="director-idea-card"><h3 class="director-idea-card-title"><i class="ti ti-messages"></i> Lịch sử trao đổi</h3><div class="director-idea-card-sub">Bình luận và phản hồi trong quá trình xử lý</div><div id="commentsArea"></div></section>
      </div>

      <aside class="director-idea-column">
        <section class="director-idea-card">
          <h3 class="director-idea-card-title"><i class="ti ti-users"></i> Phụ trách &amp; trạng thái</h3>
          <div class="director-detail-item"><div class="detail-label">Người thực hiện — Người review</div><div id="detailPeople" class="director-detail-value"></div></div><div class="director-detail-item"><div class="detail-label">Trạng thái QL Ý tưởng</div><div id="detailCoreStatus" class="director-detail-value"></div></div><div class="director-detail-item"><div class="detail-label">Trạng thái Giám đốc</div><div id="detailDirectorStatus" class="director-detail-value"></div></div>
          <div id="managerFeedback" class="source-feedback manager" style="display:none"></div><div id="directorFeedback" class="source-feedback director" style="display:none"></div>
        </section>

        <section class="director-idea-card"><h3 class="director-idea-card-title"><i class="ti ti-files"></i> Tài liệu &amp; moodboard</h3><div class="director-idea-card-sub">Tệp tham khảo và định hướng hình ảnh</div><div id="referenceArea" class="director-doc-empty">Chưa có tài liệu tham khảo.</div><div id="moodboardArea" class="moodboard-grid" style="margin-top:12px"></div></section>

        <section class="director-idea-card">
          <form asp-action="SendIdeaFeedback" method="post" class="director-action-card"><input type="hidden" name="id" id="feedbackId"><h3 class="director-idea-card-title"><i class="ti ti-message-circle"></i> Yêu cầu chỉnh sửa</h3><div class="director-idea-card-sub">Gửi phản hồi để nhân viên cập nhật nội dung</div><textarea class="form-control" name="feedback" maxlength="2000" rows="3" required placeholder="Nhập feedback của Giám đốc..."></textarea><div class="action-row" style="margin-top:8px"><button class="btn-mini reject" type="submit"><i class="ti ti-message-circle"></i> Gửi feedback</button></div></form>
          <form asp-action="DecideIdea" method="post" class="director-action-card"><input type="hidden" name="id" id="decisionId"><h3 class="director-idea-card-title"><i class="ti ti-gavel"></i> Quyết định của Giám đốc</h3><div class="director-idea-card-sub">Duyệt hoặc từ chối độc lập với review quản lý</div><textarea class="form-control" name="reason" maxlength="2000" rows="3" placeholder="Nhận xét khi duyệt; bắt buộc nếu từ chối..."></textarea><div class="action-row" style="margin-top:8px"><button class="btn-mini approve" name="decision" value="approve" type="submit"><i class="ti ti-check"></i> Duyệt</button><button class="btn-mini reject" name="decision" value="reject" type="submit"><i class="ti ti-x"></i> Từ chối</button></div></form>
        </section>
      </aside>
    </div>
  </div>
  <div class="modal-footer"><button class="btn-mini" type="button" onclick="closeIdea()">Đóng</button></div>
</div></div>

<script id="directorIdeaData" type="application/json">@Html.Raw(ideasJson)</script>
<script>
const ideas = JSON.parse(document.getElementById('directorIdeaData').textContent);
const ideaStatusOrder = ['y_tuong', 'review', 'need_revision', 'approved', 'in_production', 'done'];
function escapeHtml(value) { const element = document.createElement('div'); element.textContent = value ?? ''; return element.innerHTML; }
function setValue(id, value) { const element = document.getElementById(id); if (element) element.value = value ?? ''; }
function setText(id, value) { const element = document.getElementById(id); if (element) element.textContent = value || '—'; }
function updateProgress(status) {
  const currentIndex = ideaStatusOrder.indexOf(status);
  document.querySelectorAll('#directorIdeaProgress .director-progress-step').forEach((step, index) => {
    step.classList.toggle('complete', currentIndex >= 0 && index < currentIndex);
    step.classList.toggle('current', index === currentIndex);
  });
}
function openIdea(id) {
  const idea = ideas.find(item => item.Id === id);
  if (!idea) return;
  setText('detailIdeaId', idea.Id);
  setText('detailTitle', idea.Title);
  setText('detailClient', idea.ClientName);
  setText('detailCampaign', idea.CampaignName);
  setText('detailPeople', `${idea.PrimaryStaffName} — review: ${idea.ReviewerName}`);
  setText('detailCoreStatus', idea.StatusLabel);
  setText('detailDirectorStatus', idea.DirectorReviewStatusLabel);
  const directorBadge = document.getElementById('detailDirectorBadge');
  directorBadge.textContent = idea.DirectorReviewStatusLabel;
  directorBadge.className = `status-director ${idea.DirectorReviewStatus}`;
  updateProgress(idea.Status);
  const manager = document.getElementById('managerFeedback');
  manager.style.display = idea.ManagerFeedback ? 'block' : 'none';
  manager.textContent = idea.ManagerFeedback ? `QL Ý tưởng: ${idea.ManagerFeedback}` : '';
  const director = document.getElementById('directorFeedback');
  director.style.display = idea.DirectorFeedback ? 'block' : 'none';
  director.textContent = idea.DirectorFeedback ? `Giám đốc: ${idea.DirectorFeedback}` : '';
  setValue('editId', idea.Id);
  setValue('feedbackId', idea.Id);
  setValue('decisionId', idea.Id);
  setValue('editInsight', idea.Insight);
  setValue('editConcept', idea.Concept);
  setValue('editContent', idea.ContentDetails);
  setValue('editScript', idea.ScriptText);
  const reference = document.getElementById('referenceArea');
  reference.innerHTML = idea.ReferenceFileUrl
    ? `<a class="btn-mini" href="${encodeURI(idea.ReferenceFileUrl)}" target="_blank"><i class="ti ti-paperclip"></i> Tệp reference</a>`
    : (idea.ReferenceLink ? `<a class="btn-mini" href="${encodeURI(idea.ReferenceLink)}" target="_blank"><i class="ti ti-link"></i> Link reference</a>` : '<span class="director-doc-empty">Chưa có tài liệu tham khảo.</span>');
  document.getElementById('moodboardArea').innerHTML = idea.MoodboardImages.length
    ? idea.MoodboardImages.map(image => `<a href="${encodeURI(image.FileUrl)}" target="_blank"><img src="${encodeURI(image.FileUrl)}" alt="Moodboard"></a>`).join('')
    : (idea.MoodboardDescription ? `<div class="detail-value">${escapeHtml(idea.MoodboardDescription)}</div>` : '<div class="director-doc-empty">Chưa có ảnh moodboard.</div>');
  document.getElementById('commentsArea').innerHTML = idea.Comments.length
    ? idea.Comments.map(comment => `<div class="detail-box" style="margin-bottom:7px"><strong>${escapeHtml(comment.AuthorName)}</strong> · ${escapeHtml(comment.AuthorRole)} · ${new Date(comment.CreatedAt).toLocaleString('vi-VN')}<div style="margin-top:4px">${escapeHtml(comment.Content)}</div></div>`).join('')
    : '<div class="page-sub">Chưa có trao đổi.</div>';
  document.getElementById('ideaModal').classList.add('active');
}
function closeIdea() { document.getElementById('ideaModal').classList.remove('active'); }
document.addEventListener('DOMContentLoaded', () => { const focus = Number(new URLSearchParams(location.search).get('focus')); if (focus) openIdea(focus); });
</script></body></html>
