<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Giám sát Booking &amp; Thù lao (Giám đốc)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/tabler-icons/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
  <style>
    .tab-headers {
      display: flex;
      gap: 16px;
      border-bottom: 1px solid var(--line);
      padding-bottom: 8px;
      margin-bottom: 18px;
    }
    .tab-header {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--muted);
      cursor: pointer;
      padding: 6px 14px;
      position: relative;
    }
    .tab-header:hover {
      color: var(--blue-500);
    }
    .tab-header.active {
      color: var(--blue-500);
      font-weight: 700;
    }
    .tab-header.active::after {
      content: '';
      position: absolute;
      bottom: -9px;
      left: 0; right: 0;
      height: 3px;
      background: var(--blue-500);
      border-radius: 2px 2px 0 0;
    }
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }
  </style>
</head>
<body>
<div class="layout">

  <partial name="_SidebarPartial" />

  
<main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Giám sát Booking &amp; Thù lao</div>
        <div class="page-sub">Giám sát trạng thái booking KOL và tình hình phân bổ thù lao</div>
      </div>
      <div class="topbar-actions">
        <a href="/Campaigns" class="btn-primary-blue" style="text-decoration:none;"><i class="ti ti-rocket"></i> Xem quản lý Chiến dịch &rarr;</a>
      </div>
    </div>

    <!-- TAB NAVIGATION -->
    <div class="card" style="padding: 16px 20px 0 20px; margin-bottom: 0;">
      <div class="tab-headers">
        <div class="tab-header active" onclick="switchTab(event, 'bookings')">
          <i class="ti ti-star"></i> Booking KOL
        </div>
        <div class="tab-header" onclick="switchTab(event, 'wage-overview')">
          <i class="ti ti-cash"></i> Tổng quan thù lao
        </div>
      </div>
    </div>

    <!-- TAB 2: Booking KOL (chi tiết) -->
    <div id="tab-bookings" class="tab-content active">
      <div class="card">
        <div class="card-head">
          <div class="card-title">Danh sách Booking KOL/KOC — Chi tiết</div>
          <div style="font-size: 13px; color: var(--muted);">Xem chi tiết từng booking và trạng thái phê duyệt</div>
        </div>
        <table>
          <thead>
            <tr>
              <th>Client &amp; Chiến dịch</th>
              <th>KOL/KOC</th>
              <th>Giá Booking</th>
              <th>Chi phí</th>
              <th>Lợi nhuận</th>
              <th>Trạng thái</th>
              <th>Phê duyệt</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Vinamilk — Tết Sum Vầy 2027</strong></td>
              <td>Nguyễn Thị H</td>
              <td style="color: var(--blue-700); font-weight: 600;">10,000,000 đ</td>
              <td>4,000,000 đ</td>
              <td style="color: var(--green); font-weight: 600;">6,000,000 đ</td>
              <td><span class="status-chip status-good">Đang triển khai</span></td>
              <td><span class="status-chip status-good">Đã ký</span></td>
            </tr>
            <tr>
              <td><strong>Traveloka — Mùa Hè Rực Rỡ</strong></td>
              <td>Trần Văn K</td>
              <td style="color: var(--blue-700); font-weight: 600;">25,000,000 đ</td>
              <td>11,000,000 đ</td>
              <td style="color: var(--green); font-weight: 600;">14,000,000 đ</td>
              <td><span class="status-chip status-good">Hoàn thành</span></td>
              <td><span class="status-chip status-good">Đã ký</span></td>
            </tr>
            <tr>
              <td><strong>Vinamilk — Tết Sum Vầy 2027</strong></td>
              <td>Đặng Ngọc L</td>
              <td style="color: var(--blue-700); font-weight: 600;">480,000,000 đ</td>
              <td>220,000,000 đ</td>
              <td style="color: var(--green); font-weight: 600;">260,000,000 đ</td>
              <td><span class="status-chip status-warn">Chờ ký hợp đồng</span></td>
              <td><span class="status-chip status-info">Chờ ký</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- TAB 3: Tổng quan thù lao (READ-ONLY) -->
    <div id="tab-wage-overview" class="tab-content">
      <div class="card" style="margin-bottom: 22px;">
        <div class="card-head">
          <div class="card-title">
            <i class="ti ti-cash" style="color: var(--green);"></i> Tổng quan phân bổ thù lao — Read Only
          </div>
          <div style="font-size: 13px; color: var(--muted);">
            <i class="ti ti-info-circle"></i> Giám đốc chỉ có quyền xem tổng quan. Việc phân bổ thù lao do QL Booking thực hiện.
          </div>
        </div>
        <table>
          <thead>
            <tr>
              <th>STT</th>
              <th>Client &amp; Chiến dịch</th>
              <th>KOL/KOC</th>
              <th style="text-align: right;">Giá trị Booking</th>
              <th style="text-align: right;">Tổng thù lao đã phân bổ</th>
              <th>Còn lại</th>
              <th>QL Booking phụ trách</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1</td>
              <td><strong>Vinamilk — Tết Sum Vầy 2027</strong></td>
              <td>Nguyễn Thị H</td>
              <td style="text-align: right; font-weight: 600;">10,000,000 đ</td>
              <td style="text-align: right; color: var(--green); font-weight: 600;">10,000,000 đ</td>
              <td><span class="status-chip status-good">Đủ</span></td>
              <td>Nguyễn Anh Tuấn</td>
            </tr>
            <tr>
              <td>2</td>
              <td><strong>Traveloka — Mùa Hè Rực Rỡ</strong></td>
              <td>Trần Văn K</td>
              <td style="text-align: right; font-weight: 600;">25,000,000 đ</td>
              <td style="text-align: right; color: var(--green); font-weight: 600;">25,000,000 đ</td>
              <td><span class="status-chip status-good">Đủ</span></td>
              <td>Nguyễn Anh Tuấn</td>
            </tr>
            <tr>
              <td>3</td>
              <td><strong>Vinamilk — Tết Sum Vầy 2027</strong></td>
              <td>Đặng Ngọc L</td>
              <td style="text-align: right; font-weight: 600;">480,000,000 đ</td>
              <td style="text-align: right; color: var(--amber); font-weight: 600;">480,000,000 đ</td>
              <td><span class="status-chip status-good">Đủ</span></td>
              <td>Nguyễn Anh Tuấn</td>
            </tr>
            <tr>
              <td>4</td>
              <td><strong>Cocoon — Glow Up Your Skin</strong></td>
              <td>Lê Thị M</td>
              <td style="text-align: right; font-weight: 600;">150,000,000 đ</td>
              <td style="text-align: right; color: var(--green); font-weight: 600;">140,000,000 đ</td>
              <td><span class="status-chip status-warn">Còn 10,000,000 đ</span></td>
              <td>Phạm Thu Hà</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- KPI Summary -->
      <div class="grid-3">
        <div class="card">
          <div class="card-head">
            <div class="card-title">Tổng giá trị Booking</div>
          </div>
          <div style="font-size: 28px; font-weight: 800; color: var(--blue-700); margin: 12px 0;">665,000,000 đ</div>
          <div style="font-size: 12px; color: var(--muted);">4 booking đang theo dõi</div>
        </div>
        <div class="card">
          <div class="card-head">
            <div class="card-title">Tổng thù lao đã phân bổ</div>
          </div>
          <div style="font-size: 28px; font-weight: 800; color: var(--green); margin: 12px 0;">655,000,000 đ</div>
          <div style="font-size: 12px; color: var(--muted);">Đã phân bổ cho nhân viên</div>
        </div>
        <div class="card">
          <div class="card-head">
            <div class="card-title">Còn lại chưa phân bổ</div>
          </div>
          <div style="font-size: 28px; font-weight: 800; color: var(--amber); margin: 12px 0;">10,000,000 đ</div>
          <div style="font-size: 12px; color: var(--muted);">Chờ QL Booking cập nhật</div>
        </div>
      </div>
    </div>

    <footer>HanaMedia · Dashboard Giám đốc — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<!-- MODAL XEM CHI TIẾT PHÂN BỔ THÙ LAO -->
<div class="modal-backdrop" id="salaryModal">
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title">Phân bổ thù lao theo Booking</div>
      <button class="modal-close" onclick="closeModal('salaryModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div style="background: var(--blue-50); border: 1px solid var(--blue-100); border-radius: 10px; padding: 12px 14px; margin-bottom: 20px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span style="font-size: 13px; font-weight: 600; color: var(--ink-2);">KOL/KOC:</span>
          <span id="salKOL" style="font-size: 13px; font-weight: 700; color: var(--navy);">Nguyễn Thị H</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="font-size: 13px; font-weight: 600; color: var(--ink-2);">Giá trị Booking:</span>
          <span id="salBookingValue" style="font-size: 13px; font-weight: 700; color: var(--blue-700);">10,000,000 đ</span>
        </div>
      </div>

      <div style="margin-bottom: 12px; font-weight: 700; font-size: 12px; color: var(--muted); text-transform: uppercase;">Danh sách nhân sự tham gia &amp; thù lao nhận được</div>
      <table id="salTable" style="margin-bottom: 16px;">
        <thead>
          <tr>
            <th>Nhân viên</th>
            <th style="text-align: right;">Thù lao nhận được</th>
          </tr>
        </thead>
        <tbody>
          <!-- Dynamic contents -->
        </tbody>
      </table>

      <div id="salWarningBox" class="alert-box" style="display:none; margin-top: 0; background: var(--red-bg); border-color: #F8D7DA;">
        <i class="ti ti-alert-triangle" style="color: var(--red);"></i>
        <div>
          <div class="alert-title" style="color: #721C24;">Cảnh báo phân bổ vượt định mức</div>
          <div class="alert-desc" style="color: #721C24;">Tổng tiền thù lao đã phân bổ vượt mức giá trị booking hiện tại.</div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini approve" onclick="closeModal('salaryModal')">Xác nhận đã xem</button>
    </div>
  </div>
</div>

<script>
  function switchTab(event, tabId) {
    // Update tab headers
    const headers = document.querySelectorAll('.tab-header');
    headers.forEach(h => h.classList.remove('active'));
    event.target.closest('.tab-header').classList.add('active');

    // Update tab contents
    const contents = document.querySelectorAll('.tab-content');
    contents.forEach(c => c.classList.remove('active'));
    document.getElementById('tab-' + tabId).classList.add('active');
  }

  function openSalaryModal(kolName, totalValue, staffList) {
    document.getElementById('salKOL').innerText = kolName;
    document.getElementById('salBookingValue').innerText = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(totalValue);
    
    let totalAllocated = 0;
    const tableBody = document.getElementById('salTable').getElementsByTagName('tbody')[0];
    tableBody.innerHTML = '';
    
    staffList.forEach(item => {
      totalAllocated += item.val;
      let row = tableBody.insertRow();
      let cell1 = row.insertCell(0);
      let cell2 = row.insertCell(1);
      
      cell1.innerHTML = `<strong>${item.name}</strong>`;
      cell2.style.textAlign = 'right';
      cell2.innerHTML = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.val);
    });

    const warnBox = document.getElementById('salWarningBox');
    if (totalAllocated > totalValue) {
      warnBox.style.display = 'flex';
    } else {
      warnBox.style.display = 'none';
    }

    document.getElementById('salaryModal').classList.add('active');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }
</script>
</body>
</html>
