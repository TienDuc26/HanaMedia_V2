@model HanaMedia.ViewModels.DirectorApprovalViewModel
@using HanaMedia.Constants
@{
    string Money(decimal value) => $"{value:N0} đ";
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yêu cầu phê duyệt — HanaMedia</title>
  <link rel="stylesheet" href="~/css/design-system.css"><link rel="stylesheet" href="~/css/layout.css"><link rel="stylesheet" href="~/css/components.css">
  <link rel="stylesheet" href="~/css/tabler-icons/tabler-icons.min.css">
</head>
<body><div class="layout"><partial name="_SidebarPartial" /><main class="main">
  <div class="topbar"><div><div class="page-title">Yêu cầu phê duyệt</div><div class="page-sub">Dữ liệu chờ duyệt thực tế từ Booking và công việc theo phòng ban</div></div></div>
  @if (TempData["SuccessMessage"] is string success) { <div class="approval-alert success"><i class="ti ti-circle-check"></i>@success</div> }
  @if (TempData["ErrorMessage"] is string error) { <div class="approval-alert error"><i class="ti ti-alert-triangle"></i>@error</div> }

  <nav class="approval-tabs card" aria-label="Nhóm phê duyệt">
    <button type="button" class="approval-tab active" data-filter="all"><i class="ti ti-layout-grid"></i>Tất cả <span>@Model.TotalCount</span></button>
    <button type="button" class="approval-tab" data-filter="booking"><i class="ti ti-star"></i>Booking <span>@Model.BookingCount</span></button>
    <button type="button" class="approval-tab" data-filter="hcns"><i class="ti ti-users"></i>Hành chính nhân sự <span>@Model.HumanResourcesCount</span></button>
  </nav>

  <section class="card approval-card">
    <div class="card-head"><div><div class="card-title" id="approvalTitle">Tất cả yêu cầu đang chờ duyệt</div><div class="card-sub">Chỉ hiển thị bản ghi còn ở trạng thái chờ duyệt trong database</div></div></div>
    <div class="table-scroll"><table id="approvalTable"><thead><tr><th>Phân loại</th><th>Nội dung</th><th>Đối tượng / phòng ban</th><th>Giá trị / deadline</th><th>Người phụ trách</th><th>Gửi duyệt</th><th>Hành động</th></tr></thead><tbody>
    @foreach (var booking in Model.BookingApprovals)
    {
      <tr data-group="booking">
        <td><span class="approval-tag booking"><i class="ti ti-star"></i>Booking</span></td>
        <td><strong>@booking.ClientName</strong><small>Chiến dịch: @(booking.Campaign?.Name ?? booking.CampaignName)</small></td>
        <td>@(booking.Kol?.Name ?? "Chưa chọn KOL/KOC")<small>Phòng Booking</small></td>
        <td><strong class="money">@Money(booking.BookingPrice)</strong><small>Chi phí: @Money(booking.ActualCost)</small></td>
        <td>@(booking.PrimaryManager?.FullName ?? "Chưa phân công")</td>
        <td>@((booking.UpdatedAt ?? booking.CreatedAt)?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
        <td class="actions">
          <button type="button" class="btn-mini approve" data-booking-id="@booking.Id" data-action="approve"><i class="ti ti-check"></i>Duyệt</button>
          <button type="button" class="btn-mini reject" data-booking-id="@booking.Id" data-client="@booking.ClientName" data-action="reject"><i class="ti ti-x"></i>Từ chối</button>
          <a class="btn-mini" href="/Bookings/Details/@booking.Id"><i class="ti ti-eye"></i>Chi tiết</a>
        </td>
      </tr>
    }
    @foreach (var task in Model.TaskApprovals)
    {
      var group = task.Module == WorkTaskModules.HumanResources ? "hcns" : "booking";
      <tr data-group="@group">
        <td><span class="approval-tag @group"><i class="ti @(group == "hcns" ? "ti-users" : "ti-checklist")"></i>Công việc @(group == "hcns" ? "HCNS" : "Booking")</span></td>
        <td><strong>#@task.Id · @task.Title</strong><small>@(string.IsNullOrWhiteSpace(task.Description) ? "Không có mô tả" : task.Description)</small></td>
        <td>@task.EmployeeName<small>@task.DepartmentName</small></td>
        <td><strong>@task.Deadline.ToString("dd/MM/yyyy")</strong><small>@(task.Deadline < DateTime.Now ? "Đã quá hạn" : "Còn trong hạn")</small></td>
        <td>@task.CreatedByName</td>
        <td>@(task.SubmittedAt == default ? "—" : task.SubmittedAt.ToString("dd/MM/yyyy HH:mm"))</td>
        <td class="actions">
          <form method="post" action="/Tasks/Review" class="inline-form" onsubmit="return confirm('Duyệt công việc này?')">
            @Html.AntiForgeryToken()<input type="hidden" name="taskId" value="@task.Id"><input type="hidden" name="targetStatus" value="approved">
            <button type="submit" class="btn-mini approve"><i class="ti ti-check"></i>Duyệt</button>
          </form>
          <a class="btn-mini" href="/Tasks/Workspace/@task.Id"><i class="ti ti-eye"></i>Chi tiết / yêu cầu sửa</a>
        </td>
      </tr>
    }
    <tr id="emptyRow" hidden><td colspan="7" class="empty-cell">Không có yêu cầu nào đang chờ duyệt trong nhóm này.</td></tr>
    </tbody></table></div>
    <div class="pagination" id="approvalPagination"></div>
  </section>
</main></div>

<div class="modal-backdrop" id="rejectModal" hidden><div class="reject-dialog"><div class="dialog-head"><strong>Từ chối Booking</strong><button type="button" id="closeReject">×</button></div><p>Booking của client <strong id="rejectClient"></strong></p><label for="rejectReason">Lý do từ chối</label><textarea id="rejectReason" rows="4" placeholder="Nhập lý do để người phụ trách chỉnh sửa..."></textarea><div class="dialog-actions"><button type="button" class="btn-mini" id="cancelReject">Hủy</button><button type="button" class="btn-mini reject" id="confirmReject">Xác nhận từ chối</button></div></div></div>
<form id="antiForgery">@Html.AntiForgeryToken()</form>

<style>
.approval-tabs{display:flex;gap:8px;padding:10px;margin-bottom:16px}.approval-tab{border:0;background:transparent;color:var(--muted);font-weight:600;padding:10px 14px;border-radius:8px;cursor:pointer;display:flex;align-items:center;gap:7px}.approval-tab.active{background:var(--blue-100);color:var(--blue-700)}.approval-tab span{background:#e25454;color:#fff;border-radius:999px;min-width:21px;padding:2px 6px;font-size:11px}.approval-card{overflow:hidden}.approval-card td small{display:block;color:var(--muted);font-size:12px;margin-top:4px}.approval-tag{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:6px;font-size:12px;font-weight:700;white-space:nowrap}.approval-tag.booking{background:#eff6ff;color:#1d4ed8}.approval-tag.hcns{background:#ecfdf5;color:#047857}.money{color:var(--blue-700)}.actions{white-space:nowrap;text-align:right}.inline-form{display:inline}.btn-mini{display:inline-flex;align-items:center;gap:4px;text-decoration:none}.pagination{display:flex;justify-content:flex-end;align-items:center;gap:5px;padding:14px 18px;border-top:1px solid var(--border)}.pagination button{border:1px solid var(--border);background:#fff;border-radius:6px;padding:6px 10px;cursor:pointer}.pagination button.active{background:var(--blue-600);color:#fff;border-color:var(--blue-600)}.pagination button:disabled{opacity:.45}.empty-cell{text-align:center!important;color:var(--muted);padding:30px!important}.approval-alert{display:flex;align-items:center;gap:8px;padding:12px 15px;border-radius:8px;margin-bottom:14px}.approval-alert.success{background:var(--green-bg);color:var(--green)}.approval-alert.error{background:var(--red-bg);color:var(--red)}.modal-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:1000;display:flex;align-items:center;justify-content:center}.modal-backdrop[hidden]{display:none}.reject-dialog{background:#fff;border-radius:12px;padding:22px;width:min(460px,92vw);box-shadow:0 20px 45px rgba(15,23,42,.2)}.dialog-head,.dialog-actions{display:flex;align-items:center;justify-content:space-between;gap:10px}.dialog-head button{border:0;background:transparent;font-size:23px;cursor:pointer}.reject-dialog label{display:block;font-weight:600;margin:15px 0 6px}.reject-dialog textarea{width:100%;border:1px solid var(--border);border-radius:7px;padding:10px}.dialog-actions{justify-content:flex-end;margin-top:15px}@@media(max-width:900px){.approval-tabs{overflow-x:auto}.table-scroll{overflow-x:auto}.approval-card table{min-width:1000px}}
</style>
<script>
(() => {
  const pageSize = 20;
  const rows = Array.from(document.querySelectorAll('#approvalTable tbody tr[data-group]'));
  const tabs = Array.from(document.querySelectorAll('.approval-tab'));
  const pagination = document.getElementById('approvalPagination');
  const emptyRow = document.getElementById('emptyRow');
  const title = document.getElementById('approvalTitle');
  let filter = 'all';
  let page = 1;
  let rejectingId = 0;

  function render() {
    const visible = rows.filter(row => filter === 'all' || row.dataset.group === filter);
    const pages = Math.max(1, Math.ceil(visible.length / pageSize));
    page = Math.min(page, pages);
    rows.forEach(row => row.hidden = true);
    visible.slice((page - 1) * pageSize, page * pageSize).forEach(row => row.hidden = false);
    emptyRow.hidden = visible.length !== 0;
    pagination.innerHTML = '';
    if (pages <= 1) return;
    const makeButton = (text, target, active = false, disabled = false) => {
      const button = document.createElement('button'); button.type = 'button'; button.textContent = text;
      button.classList.toggle('active', active); button.disabled = disabled;
      button.addEventListener('click', () => { page = target; render(); }); return button;
    };
    pagination.append(makeButton('Trước', page - 1, false, page === 1));
    for (let i = 1; i <= pages; i++) pagination.append(makeButton(String(i), i, i === page));
    pagination.append(makeButton('Sau', page + 1, false, page === pages));
  }
  tabs.forEach(tab => tab.addEventListener('click', () => {
    tabs.forEach(item => item.classList.remove('active')); tab.classList.add('active');
    filter = tab.dataset.filter; page = 1;
    title.textContent = filter === 'booking' ? 'Yêu cầu của phòng Booking' : filter === 'hcns' ? 'Công việc Hành chính nhân sự chờ duyệt' : 'Tất cả yêu cầu đang chờ duyệt';
    render();
  }));

  const token = document.querySelector('#antiForgery input[name="__RequestVerificationToken"]').value;
  async function bookingAction(id, action, reason = '') {
    const body = new URLSearchParams({ __RequestVerificationToken: token });
    if (reason) body.append('rejectionReason', reason);
    const response = await fetch(`/Bookings/${action === 'approve' ? 'Approve' : 'Reject'}/${id}`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' }, body });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const result = await response.json();
    if (!result.success) throw new Error(result.message || 'Không thể cập nhật Booking.');
    location.reload();
  }
  document.querySelectorAll('[data-action="approve"]').forEach(button => button.addEventListener('click', async () => {
    if (!confirm('Duyệt Booking này?')) return;
    button.disabled = true;
    try { await bookingAction(button.dataset.bookingId, 'approve'); }
    catch (error) { alert(error.message); button.disabled = false; }
  }));
  const modal = document.getElementById('rejectModal');
  const closeModal = () => { modal.hidden = true; rejectingId = 0; };
  document.querySelectorAll('[data-action="reject"]').forEach(button => button.addEventListener('click', () => { rejectingId = button.dataset.bookingId; document.getElementById('rejectClient').textContent = button.dataset.client; document.getElementById('rejectReason').value = ''; modal.hidden = false; }));
  document.getElementById('closeReject').addEventListener('click', closeModal);
  document.getElementById('cancelReject').addEventListener('click', closeModal);
  document.getElementById('confirmReject').addEventListener('click', async event => {
    if (!rejectingId) return; event.currentTarget.disabled = true;
    try { await bookingAction(rejectingId, 'reject', document.getElementById('rejectReason').value.trim()); }
    catch (error) { alert(error.message); event.currentTarget.disabled = false; }
  });
  render();
})();
</script>
</body></html>
