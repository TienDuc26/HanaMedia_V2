<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Quản lý Nhân sự (Giám đốc)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
  <style>
    .filter-row {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .filter-item {
      flex: 1;
      min-width: 150px;
    }
    .search-input {
      min-width: 250px;
    }
    .modal-detail-grid {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }
    .modal-avatar {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: var(--blue-500);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      font-weight: 700;
    }
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
    }
    .info-label {
      font-size: 11px;
      color: var(--muted);
      font-weight: 700;
      text-transform: uppercase;
    }
    .info-val {
      font-size: 13.5px;
      color: var(--ink);
      font-weight: 500;
      margin-top: 2px;
    }
    .tab-container {
      margin-top: 20px;
      border-top: 1px solid var(--line);
      padding-top: 16px;
    }
    .tab-headers {
      display: flex;
      gap: 16px;
      border-bottom: 1px solid var(--line);
      padding-bottom: 8px;
      margin-bottom: 12px;
    }
    .tab-header {
      font-size: 13px;
      font-weight: 700;
      color: var(--muted);
      cursor: pointer;
      padding-bottom: 8px;
      position: relative;
    }
    .tab-header.active {
      color: var(--blue-500);
    }
    .tab-header.active::after {
      content: '';
      position: absolute;
      bottom: -9px;
      left: 0; right: 0;
      height: 2px;
      background: var(--blue-500);
    }
    .tab-content {
      display: none;
      font-size: 13px;
    }
    .tab-content.active {
      display: block;
    }
    .timeline-item {
      padding-left: 16px;
      border-left: 2px solid var(--blue-100);
      position: relative;
      padding-bottom: 14px;
    }
    .timeline-item::before {
      content: '';
      position: absolute;
      left: -6px;
      top: 4px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--blue-500);
      border: 2px solid #fff;
    }
    .timeline-date {
      font-size: 11px;
      color: var(--muted);
      font-weight: 600;
    }
    .timeline-title {
      font-weight: 600;
      color: var(--ink);
      margin-top: 2px;
    }
    .timeline-desc {
      color: var(--ink-2);
      margin-top: 2px;
    }
  </style>
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Tổng quan</div>
    <a href="/Director/Dashboard" class="nav-item"><i class="ti ti-layout-dashboard"></i>Dashboard</a>
    <a href="/Director/Report" class="nav-item"><i class="ti ti-report-analytics"></i>Báo cáo</a>

    <div class="nav-section">Nghiệp vụ</div>
    <a href="/Director/HumanResources" class="nav-item active"><i class="ti ti-users"></i>Nhân sự</a>
    <a href="/Director/Department" class="nav-item"><i class="ti ti-building-skyscraper"></i>Phòng ban</a>
    <a href="/Director/BookingCampaign" class="nav-item"><i class="ti ti-star"></i>Booking / KOL</a>
    <a href="/Director/Idea" class="nav-item"><i class="ti ti-bulb"></i>Ý tưởng &amp; Chiến dịch</a>
    <a href="/Director/Approve" class="nav-item"><i class="ti ti-checklist"></i>Phê duyệt</a>
    <a href="/Director/SignContract" class="nav-item"><i class="ti ti-pen"></i>Ký Hợp Đồng</a>

    <div class="nav-section">Quản trị</div>
    <a href="/Director/Config" class="nav-item"><i class="ti ti-settings"></i>Cấu hình nghiệp vụ</a>
    <a href="/Director/MonitoringSystem" class="nav-item"><i class="ti ti-shield-check"></i>Giám sát hệ thống</a>

    <div class="sidebar-footer">
      <div class="role-pill">
        <div class="avatar">NV</div>
        <div>
          <div class="role-name">Nguyễn Văn A</div>
          <div class="role-title">Giám đốc</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Hồ sơ nhân sự toàn công ty</div>
        <div class="page-sub">Xem chi tiết hồ sơ, lịch sử làm việc, thù lao, hiệu suất phòng ban và phân công công việc</div>
      </div>
      <div class="topbar-actions">
        <button class="icon-btn" onclick="alert('Đã tải xuống báo cáo nhân sự!')"><i class="ti ti-download"></i></button>
      </div>
    </div>

    <div class="card">
      <div class="filter-row">
        <div class="filter-item search-input">
          <input type="text" class="form-control" placeholder="Tìm tên nhân viên, chức vụ...">
        </div>
        <div class="filter-item">
          <select class="form-control">
            <option value="">Tất cả phòng ban</option>
            <option value="Booking">Booking</option>
            <option value="Idea">Ý tưởng</option>
            <option value="HCNS">HCNS</option>
            <option value="IT">IT</option>
          </select>
        </div>
        <div class="filter-item">
          <select class="form-control">
            <option value="">Tất cả trạng thái</option>
            <option value="active">Đang làm việc</option>
            <option value="pending">Chờ duyệt nghỉ</option>
          </select>
        </div>
      </div>

      <table>
        <thead>
          <tr>
            <th>Nhân viên</th>
            <th>Phòng ban</th>
            <th>Chức vụ</th>
            <th>Ngày vào</th>
            <th>Lương &amp; Phụ cấp</th>
            <th>Hiệu suất (T8)</th>
            <th>Trạng thái</th>
            <th style="text-align: right;">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Phạm Thu Hà</strong></td>
            <td><span class="dept-chip">Booking</span></td>
            <td>Nhân viên</td>
            <td>05/08/2026</td>
            <td>12,500,000 đ</td>
            <td><span class="bar-mini"><span class="bar-mini-fill" style="width:92%"></span></span> 92%</td>
            <td><span class="status-chip status-good">Đang làm việc</span></td>
            <td style="text-align: right;">
              <button class="btn-mini" onclick="openDetailModal('Phạm Thu Hà', 'Booking', 'Nhân viên', '05/08/2026', '12.5 tr + 1.5 tr xăng xe', '92% (Tốt)', 'Hồ sơ mới chuyển từ thử việc.')">Chi tiết</button>
              <button class="btn-mini approve" onclick="openTaskModal('Phạm Thu Hà')">Giao việc</button>
            </td>
          </tr>
          <tr>
            <td><strong>Đỗ Minh Khôi</strong></td>
            <td><span class="dept-chip">Ý tưởng</span></td>
            <td>Nhân viên</td>
            <td>03/08/2026</td>
            <td>14,000,000 đ</td>
            <td><span class="bar-mini"><span class="bar-mini-fill" style="width:87%"></span></span> 87%</td>
            <td><span class="status-chip status-good">Đang làm việc</span></td>
            <td style="text-align: right;">
              <button class="btn-mini" onclick="openDetailModal('Đỗ Minh Khôi', 'Ý tưởng', 'Nhân viên', '03/08/2026', '14 tr + 1 tr ăn trưa', '87% (Khá)', 'Ý tưởng sáng tạo tốt, hoàn thành đúng hạn.')">Chi tiết</button>
              <button class="btn-mini approve" onclick="openTaskModal('Đỗ Minh Khôi')">Giao việc</button>
            </td>
          </tr>
          <tr>
            <td><strong>Nguyễn Anh Tuấn</strong></td>
            <td><span class="dept-chip">Booking</span></td>
            <td>Quản lý</td>
            <td>15/03/2023</td>
            <td>28,000,000 đ</td>
            <td><span class="bar-mini"><span class="bar-mini-fill" style="width:95%"></span></span> 95%</td>
            <td><span class="status-chip status-warn">Chờ duyệt lương</span></td>
            <td style="text-align: right;">
              <button class="btn-mini" onclick="openDetailModal('Nguyễn Anh Tuấn', 'Booking', 'Quản lý', '15/03/2023', '28 tr + 3 tr trách nhiệm', '95% (Xuất sắc)', 'Quản lý tốt team Booking, mang về doanh thu vượt KPI.')">Chi tiết</button>
              <button class="btn-mini approve" onclick="openTaskModal('Nguyễn Anh Tuấn')">Giao việc</button>
            </td>
          </tr>
          <tr>
            <td><strong>Lê Văn C</strong></td>
            <td><span class="dept-chip">Ý tưởng</span></td>
            <td>Nhân viên</td>
            <td>10/01/2024</td>
            <td>15,000,000 đ</td>
            <td><span class="bar-mini"><span class="bar-mini-fill" style="width:60%"></span></span> 60%</td>
            <td><span class="status-chip status-bad">Chờ duyệt nghỉ</span></td>
            <td style="text-align: right;">
              <button class="btn-mini" onclick="openDetailModal('Lê Văn C', 'Ý tưởng', 'Nhân viên', '10/01/2024', '15 tr', '60% (Trung bình)', 'Đang làm thủ tục bàn giao bàn việc.')">Chi tiết</button>
              <button class="btn-mini approve" onclick="openTaskModal('Lê Văn C')">Giao việc</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <footer>HanaMedia · Dashboard Giám đốc — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<!-- MODAL CHI TIẾT NHÂN VIÊN -->
<div class="modal-backdrop" id="detailModal">
  <div class="modal-card" style="width: 650px;">
    <div class="modal-header">
      <div class="modal-title">Hồ sơ chi tiết nhân viên</div>
      <button class="modal-close" onclick="closeModal('detailModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="modal-detail-grid">
        <div class="modal-avatar" id="detAvatar">PH</div>
        <div>
          <h3 id="detName" style="font-size: 18px; color: var(--navy); margin-bottom: 4px;">Phạm Thu Hà</h3>
          <div class="status-chip status-good" id="detStatus" style="font-size: 13px;">Đang làm việc</div>
        </div>
      </div>

      <div class="info-grid">
        <div>
          <div class="info-label">Phòng ban</div>
          <div class="info-val" id="detDept">Booking</div>
        </div>
        <div>
          <div class="info-label">Chức vụ</div>
          <div class="info-val" id="detTitle">Nhân viên</div>
        </div>
        <div>
          <div class="info-label">Ngày vào công ty</div>
          <div class="info-val" id="detJoined">05/08/2026</div>
        </div>
        <div>
          <div class="info-label">Mức lương &amp; Phụ cấp</div>
          <div class="info-val" id="detSalary">12,500,000 đ</div>
        </div>
        <div>
          <div class="info-label">Đánh giá hiệu suất</div>
          <div class="info-val" id="detRating">92% (Tốt)</div>
        </div>
        <div>
          <div class="info-label">Người quản lý</div>
          <div class="info-val" id="detManager">Nguyễn Anh Tuấn (QL Booking)</div>
        </div>
      </div>

      <div class="tab-container">
        <div class="tab-headers">
          <div class="tab-header active" onclick="switchTab(event, 'tab-history')">Lịch sử làm việc</div>
          <div class="tab-header" onclick="switchTab(event, 'tab-rewards')">Khen thưởng &amp; Kỷ luật</div>
          <div class="tab-header" onclick="switchTab(event, 'tab-notes')">Ghi chú hiệu suất</div>
        </div>

        <div id="tab-history" class="tab-content active">
          <div class="timeline-item">
            <div class="timeline-date">05/08/2026</div>
            <div class="timeline-title">Bắt đầu làm việc chính thức</div>
            <div class="timeline-desc">Được nhận vào vị trí nhân viên Booking chính thức sau 2 tháng thử việc xuất sắc.</div>
          </div>
          <div class="timeline-item" style="padding-bottom: 0;">
            <div class="timeline-date">01/06/2026</div>
            <div class="timeline-title">Thử việc tại HanaMedia</div>
            <div class="timeline-desc">Thực tập và thử việc tại bộ phận Booking KOL/KOC.</div>
          </div>
        </div>

        <div id="tab-rewards" class="tab-content">
          <div class="timeline-item" style="padding-bottom: 0;">
            <div class="timeline-date">15/07/2026</div>
            <div class="timeline-title">Khen thưởng thử việc xuất sắc</div>
            <div class="timeline-desc">Được thưởng nóng 1,000,000đ vì chốt thành công hợp đồng KOL chiến dịch Vinamilk.</div>
          </div>
        </div>

        <div id="tab-notes" class="tab-content">
          <p id="detNotes" style="color: var(--ink-2); line-height: 1.6;">Hồ sơ mới chuyển từ thử việc.</p>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('detailModal')">Đóng</button>
    </div>
  </div>
</div>

<!-- MODAL GIAO VIỆC (PHÂN CÔNG CÔNG VIỆC) -->
<div class="modal-backdrop" id="taskModal">
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-title">Phân công công việc</div>
      <button class="modal-close" onclick="closeModal('taskModal')">&times;</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label>Nhân viên thực hiện</label>
        <input type="text" id="taskEmployee" class="form-control" readonly style="background: var(--blue-50);">
      </div>
      <div class="form-group">
        <label>Tiêu đề công việc</label>
        <input type="text" class="form-control" placeholder="Nhập tiêu đề công việc...">
      </div>
      <div class="form-group">
        <label>Mô tả công việc</label>
        <textarea class="form-control" rows="3" placeholder="Nhập chi tiết yêu cầu công việc..."></textarea>
      </div>
      <div class="form-group">
        <label>Hạn chót (Deadline)</label>
        <input type="date" class="form-control">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-mini" onclick="closeModal('taskModal')">Hủy</button>
      <button class="btn-mini approve" onclick="alert('Đã phân công công việc thành công!'); closeModal('taskModal');">Giao việc</button>
    </div>
  </div>
</div>

<script>
  function openDetailModal(name, dept, title, joined, salary, rating, notes) {
    document.getElementById('detName').innerText = name;
    document.getElementById('detDept').innerText = dept;
    document.getElementById('detTitle').innerText = title;
    document.getElementById('detJoined').innerText = joined;
    document.getElementById('detSalary').innerText = salary;
    document.getElementById('detRating').innerText = rating;
    document.getElementById('detNotes').innerText = notes;
    document.getElementById('detAvatar').innerText = name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
    
    // Status color logic
    const statusChip = document.getElementById('detStatus');
    if(notes.includes('nghỉ')) {
      statusChip.innerText = 'Chờ duyệt nghỉ';
      statusChip.className = 'status-chip status-bad';
    } else if(joined.includes('2023')) {
      statusChip.innerText = 'Chờ duyệt lương';
      statusChip.className = 'status-chip status-warn';
    } else {
      statusChip.innerText = 'Đang làm việc';
      statusChip.className = 'status-chip status-good';
    }

    document.getElementById('detailModal').classList.add('active');
  }

  function openTaskModal(name) {
    document.getElementById('taskEmployee').value = name;
    document.getElementById('taskModal').classList.add('active');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }

  function switchTab(e, tabId) {
    const tabHeaders = e.target.parentElement.children;
    for(let h of tabHeaders) {
      h.classList.remove('active');
    }
    e.target.classList.add('active');

    const tabContents = e.target.parentElement.parentElement.getElementsByClassName('tab-content');
    for(let c of tabContents) {
      c.classList.remove('active');
    }
    document.getElementById(tabId).classList.add('active');
  }
</script>
</body>
</html>
