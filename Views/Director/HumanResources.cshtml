@model HanaMedia.ViewModels.DirectorHumanResourcesViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi"><head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Hồ sơ nhân sự toàn công ty</title>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css"><link rel="stylesheet" href="~/css/layout.css"><link rel="stylesheet" href="~/css/components.css">
  <style>
    .filter-row{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:12px;margin-bottom:20px}.empty{text-align:center;padding:36px;color:#64748b}.account-ok{color:#15803d}.account-missing{color:#b45309}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.detail-item small{display:block;color:#64748b;font-weight:700;text-transform:uppercase;margin-bottom:4px}.notice{padding:12px 16px;background:#fff7d6;color:#854d0e;border-radius:8px;margin-bottom:16px}@@media(max-width:900px){.filter-row{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr}}
  </style>
</head><body><div class="layout">
<aside class="sidebar">
  <div class="brand"><div class="brand-mark">HM</div><div><div class="brand-name">HanaMedia</div><div class="brand-sub">Hệ thống Quản lý Nhân sự</div></div></div>
  <div class="nav-section">Tổng quan</div><a href="/Director/Dashboard" class="nav-item"><i class="ti ti-layout-dashboard"></i>Dashboard</a><a href="/Tasks" class="nav-item"><i class="ti ti-checklist"></i>Phân công &amp; Duyệt việc</a><a href="/Director/Report" class="nav-item"><i class="ti ti-report-analytics"></i>Báo cáo</a>
  <div class="nav-section">Nghiệp vụ</div><a href="/Director/HumanResources" class="nav-item active"><i class="ti ti-users"></i>Nhân sự</a><a href="/Director/Department" class="nav-item"><i class="ti ti-building-skyscraper"></i>Phòng ban</a><a href="/Director/BookingCampaign" class="nav-item"><i class="ti ti-star"></i>Booking / KOL</a><a href="/Director/Idea" class="nav-item"><i class="ti ti-bulb"></i>Ý tưởng &amp; Chiến dịch</a><a href="/Director/Approve" class="nav-item"><i class="ti ti-checklist"></i>Phê duyệt</a><a href="/Director/SignContract" class="nav-item"><i class="ti ti-pen"></i>Ký Hợp Đồng</a>
  <div class="nav-section">Quản trị</div><a href="/Director/Config" class="nav-item"><i class="ti ti-settings"></i>Cấu hình nghiệp vụ</a><a href="/Director/MonitoringSystem" class="nav-item"><i class="ti ti-shield-check"></i>Giám sát hệ thống</a><partial name="_UserMenuPartial" />
</aside><main class="main">
  <div class="topbar"><div><div class="page-title">Hồ sơ nhân sự toàn công ty</div><div class="page-sub">Dữ liệu thật từ Module 5; Giám đốc xem hồ sơ và giao việc qua task engine dùng chung</div></div></div>
  <div class="notice">Chỉ nhân sự đang hoạt động, thuộc HCNS/Booking/Ý tưởng và đã liên kết tài khoản mới có thể nhận task. Hồ sơ chưa có tài khoản vẫn được hiển thị để Giám đốc theo dõi.</div>
  <div class="card"><form class="filter-row" method="get" action="/Director/HumanResources">
    <input class="form-control" name="search" value="@Model.Search" placeholder="Tìm tên nhân viên, chức vụ, email...">
    <select class="form-control" name="department"><option value="">Tất cả phòng ban</option>@foreach(var item in Model.Departments){if(item.Code==Model.Department){<option value="@item.Code" selected>@item.Name</option>}else{<option value="@item.Code">@item.Name</option>}}</select>
    <select class="form-control" name="status"><option value="">Tất cả trạng thái</option>@foreach(var item in new[]{("dang_lam_viec","Đang làm việc"),("thu_viec","Thử việc"),("cho_duyet_nghi","Chờ duyệt nghỉ"),("ngung_hoat_dong","Ngừng hoạt động")}){if(item.Item1==Model.Status){<option value="@item.Item1" selected>@item.Item2</option>}else{<option value="@item.Item1">@item.Item2</option>}}</select>
    <button class="btn-mini" type="submit"><i class="ti ti-filter"></i> Lọc</button>
  </form><div style="overflow-x:auto"><table><thead><tr><th>Nhân viên</th><th>Phòng ban</th><th>Chức vụ</th><th>Ngày vào</th><th>Lương &amp; phụ cấp</th><th>Trạng thái</th><th>Tài khoản</th><th style="text-align:right">Hành động</th></tr></thead><tbody>
  @if(Model.Employees.Count==0){<tr><td colspan="8" class="empty">Chưa có hồ sơ nhân sự phù hợp trong Module 5.</td></tr>}
  @foreach(var employee in Model.Employees){var active=employee.Status is "dang_lam_viec" or "thu_viec";var canAssign=active&&employee.HasAccount&&employee.TaskModule is not null;<tr><td><strong>@employee.FullName</strong></td><td><span class="dept-chip">@employee.DepartmentName</span></td><td>@employee.Position</td><td>@employee.JoinedDate.ToString("dd/MM/yyyy")</td><td>@employee.SalaryAndAllowance.ToString("N0") đ</td><td><span class="status-chip @(active?"status-good":"status-warn")">@employee.StatusLabel</span></td><td class="@(employee.HasAccount?"account-ok":"account-missing")">@(employee.HasAccount?"Đã liên kết":"Chưa có tài khoản")</td><td style="text-align:right"><button type="button" class="btn-mini" data-name="@employee.FullName" data-department="@employee.DepartmentName" data-position="@employee.Position" data-joined="@employee.JoinedDate.ToString("dd/MM/yyyy")" data-salary="@employee.SalaryAndAllowance.ToString("N0") đ" data-status="@employee.StatusLabel" data-account="@(employee.HasAccount?"Đã liên kết":"Chưa có tài khoản")" onclick="showEmployee(this)">Chi tiết</button> @if(canAssign){<a class="btn-mini approve" href="/Tasks?module=@employee.TaskModule&employeeId=@employee.Id&create=true">Giao việc</a>}else{<button class="btn-mini" type="button" disabled title="Nhân sự phải đang hoạt động, thuộc HCNS/Booking/Ý tưởng và có tài khoản">Chưa thể giao</button>}</td></tr>}
  </tbody></table></div></div><footer>HanaMedia · Dashboard Giám đốc — dữ liệu nhân sự từ Module 5</footer>
</main></div>
<div class="modal-backdrop" id="employeeDetail"><div class="modal-card"><div class="modal-header"><div class="modal-title">Chi tiết nhân sự</div><button class="modal-close" type="button" onclick="closeModal('employeeDetail')">&times;</button></div><div class="modal-body"><div class="detail-grid"><div class="detail-item"><small>Họ và tên</small><span id="detailName"></span></div><div class="detail-item"><small>Phòng ban</small><span id="detailDepartment"></span></div><div class="detail-item"><small>Chức vụ</small><span id="detailPosition"></span></div><div class="detail-item"><small>Ngày vào</small><span id="detailJoined"></span></div><div class="detail-item"><small>Lương &amp; phụ cấp</small><span id="detailSalary"></span></div><div class="detail-item"><small>Trạng thái</small><span id="detailStatus"></span></div><div class="detail-item"><small>Tài khoản nhận việc</small><span id="detailAccount"></span></div></div></div><div class="modal-footer"><button class="btn-mini" type="button" onclick="closeModal('employeeDetail')">Đóng</button></div></div></div>
<script>function closeModal(id){document.getElementById(id)?.classList.remove('active')}function showEmployee(button){const d=button.dataset;document.getElementById('detailName').textContent=d.name;document.getElementById('detailDepartment').textContent=d.department;document.getElementById('detailPosition').textContent=d.position;document.getElementById('detailJoined').textContent=d.joined;document.getElementById('detailSalary').textContent=d.salary;document.getElementById('detailStatus').textContent=d.status;document.getElementById('detailAccount').textContent=d.account;document.getElementById('employeeDetail').classList.add('active')}</script>
</body></html>
