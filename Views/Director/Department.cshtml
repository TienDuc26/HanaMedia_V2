<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Cơ cấu Phòng ban (Giám đốc)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
  @Html.AntiForgeryToken()
  <style>
    /* ── Page header + nút thêm ── */
    .topbar { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
    .btn-add {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 14px; border-radius: 8px; background: var(--navy); color: #fff;
      font-size: 13px; font-weight: 600; border: 0; cursor: pointer;
    }
    .btn-add:hover { background: #1a2348; }

    /* ── 3 Card tổng quan ── */
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .dept-top-card {
      background: #fff; border-radius: 14px; padding: 20px;
      box-shadow: var(--shadow); border: 1px solid var(--line);
    }
    .dept-top-card .dtc-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px; }
    .dept-top-card .dtc-name { font-size: 14px; font-weight: 700; color: var(--navy); line-height: 1.4; flex: 1; padding-right: 8px; }
    .dept-top-card .dtc-icon { width: 34px; height: 34px; border-radius: 10px; background: var(--blue-50); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 16px; color: var(--blue-600); }
    .dept-top-card .dtc-badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 11.5px; font-weight: 600; background: var(--blue-100); color: var(--blue-700); margin-bottom: 12px; }
    .dept-top-card .dtc-section-label { font-size: 10px; text-transform: uppercase; letter-spacing: .5px; font-weight: 700; color: var(--muted); margin-bottom: 4px; }
    .dept-top-card .dtc-value { font-size: 13px; font-weight: 600; color: var(--navy); margin-bottom: 14px; }
    .dtc-placeholder { color: var(--muted) !important; font-style: italic; }

    /* Thanh hiệu suất trong card */
    .dtc-perf-label { font-size: 10px; text-transform: uppercase; letter-spacing: .5px; font-weight: 700; color: var(--muted); margin-bottom: 6px; }
    .dtc-perf-row { display: flex; align-items: center; gap: 8px; }
    .dtc-perf-bar { flex: 1; height: 6px; background: var(--blue-50); border-radius: 4px; overflow: hidden; }
    .dtc-perf-fill { height: 100%; background: var(--blue-500); border-radius: 4px; }
    .dtc-perf-val { font-size: 12px; font-weight: 700; color: var(--navy); flex-shrink: 0; min-width: 28px; text-align: right; }
    .dtc-perf-placeholder { font-size: 12px; color: var(--muted); font-style: italic; }

    /* ── Bảng dùng CSS Grid để kiểm soát hoàn toàn ── */
    .dept-table {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(180px, 1.5fr) minmax(130px, 1fr) minmax(110px, 0.8fr) minmax(160px, 1.2fr) minmax(130px, 1fr) 80px;
      border-collapse: collapse;
      font-size: 13px;
    }
    .dept-table thead { display: contents; }
    .dept-table tbody { display: contents; }
    .dept-table tr { display: contents; }
    .dept-table th {
      text-align: left;
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: .3px;
      color: var(--muted);
      font-weight: 700;
      padding: 0 12px 10px;
      border-bottom: 1px solid var(--line);
    }
    .dept-table th:last-child { text-align: center; }
    .dept-table td {
      padding: 12px;
      border-bottom: 1px solid var(--line);
      color: var(--ink-2);
      display: flex;
      align-items: center;
    }
    .dept-table td:last-child { justify-content: center; }
    .dept-table tr:last-child td { border-bottom: none; }

    /* Empty state */
    .dept-table-empty { grid-column: 1 / -1; text-align: center; padding: 40px 20px; color: var(--muted); font-size: 14px; }

    /* Hiệu suất bar trong bảng */
    .tbl-perf-cell { display: flex; align-items: center; gap: 8px; }
    .tbl-perf-bar { width: 70px; height: 6px; background: var(--blue-50); border-radius: 4px; overflow: hidden; flex-shrink: 0; }
    .tbl-perf-fill { height: 100%; background: var(--blue-500); border-radius: 4px; }
    .tbl-perf-val { font-size: 13px; font-weight: 700; color: var(--navy); }
    .tbl-perf-placeholder { font-size: 13px; color: var(--muted); font-style: italic; }
    .tbl-placeholder { font-size: 13px; color: var(--muted); font-style: italic; }

    /* Hành động */
    .row-actions { display: flex; gap: 6px; }
    .row-actions button { width: 30px; height: 30px; border-radius: 7px; border: 1px solid #e5e7eb; background: #fff; color: #475569; cursor: pointer; transition: all .15s; font-size: 0; line-height: 0; }
    .row-actions button svg { width: 15px; height: 15px; }
    .row-actions button:hover { background: #f1f5f9; }
    .row-actions .btn-del:hover { background: #fee2e2; color: #b91c1c; border-color: #fecaca; }

    /* Modal */
    .modal { position: fixed; inset: 0; background: rgba(15,23,42,.45); display: none; align-items: center; justify-content: center; z-index: 1000; }
    .modal.active { display: flex; }
    .modal-card { background: #fff; border-radius: 12px; width: 460px; max-width: 95%; padding: 22px; box-shadow: 0 10px 30px rgba(0,0,0,.2); }
    .modal-card h3 { margin: 0 0 16px; font-size: 18px; color: var(--navy); }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; color: #334155; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 8px 10px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px; font-family: inherit; box-sizing: border-box; }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: var(--navy); }
    .err-msg { font-size: 12px; color: #dc2626; margin-top: 4px; min-height: 14px; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
    .btn { padding: 8px 14px; border-radius: 8px; border: 1px solid #e5e7eb; background: #fff; color: #334155; cursor: pointer; font-size: 13px; font-weight: 600; }
    .btn-primary { background: var(--navy); color: #fff; border-color: var(--navy); }
    .btn-primary:hover { background: #1a2348; }

    /* Card */
    .card { display: block; overflow: hidden; }

    /* SVG icon */
    .icon-svg { width: 15px; height: 15px; flex-shrink: 0; }
    .icon-svg path { fill: currentColor; }
  </style>
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Tổng quan</div>
    <a href="/Director/Dashboard" class="nav-item"><i class="ti ti-layout-dashboard"></i>Dashboard</a>
    <a href="/Tasks" class="nav-item"><i class="ti ti-checklist"></i>Phân công &amp; Duyệt việc</a>
    <a href="/Director/Report" class="nav-item"><i class="ti ti-report-analytics"></i>Báo cáo</a>

    <div class="nav-section">Nghiệp vụ</div>
    <a href="/Director/HumanResources" class="nav-item"><i class="ti ti-users"></i>Nhân sự</a>
    <a href="/Director/Department" class="nav-item active"><i class="ti ti-building-skyscraper"></i>Phòng ban</a>
    <a href="/Director/BookingCampaign" class="nav-item"><i class="ti ti-star"></i>Booking / KOL</a>
    <a href="/Director/Idea" class="nav-item"><i class="ti ti-bulb"></i>Ý tưởng &amp; Chiến dịch</a>
    <a href="/Director/Approve" class="nav-item"><i class="ti ti-checklist"></i>Phê duyệt</a>
    <a href="/Director/SignContract" class="nav-item"><i class="ti ti-pen"></i>Ký Hợp Đồng</a>

    <div class="nav-section">Quản trị</div>
    <a href="/Director/Config" class="nav-item"><i class="ti ti-settings"></i>Cấu hình nghiệp vụ</a>
    <a href="/Director/MonitoringSystem" class="nav-item"><i class="ti ti-shield-check"></i>Giám sát hệ thống</a>
    <div class="sidebar-footer">
      <partial name="_UserMenuPartial" />
    </div>
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Cơ cấu &amp; Hiệu suất Phòng ban</div>
        <div class="page-sub">Xem danh sách các phòng ban và hiệu suất hoàn thành mục tiêu công việc</div>
      </div>
      <button class="btn-add" onclick="openAddModal()">
        <svg class="icon-svg" style="width:15px;height:15px;" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Thêm phòng ban
      </button>
    </div>

    <div class="grid-3" id="deptTopGrid" style="margin-bottom: 22px;"></div>

    <div class="card">
      <div class="card-head">
        <div class="card-title">Danh sách phòng ban</div>
      </div>
      <table class="dept-table">
        <thead>
          <tr>
            <th>Phòng ban</th>
            <th>Trưởng phòng</th>
            <th>Số lượng nhân sự</th>
            <th>Hiệu suất trung bình (Tháng)</th>
            <th>Đánh giá chất lượng</th>
            <th>Hành động</th>
          </tr>
        </thead>
        <tbody id="deptTbody"></tbody>
      </table>
    </div>

    <footer>HanaMedia · Dashboard Giám đốc — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<!-- Modal: Thêm / Sửa phòng ban -->
<div class="modal" id="deptModal">
  <div class="modal-card">
    <h3 id="modalTitle">Thêm phòng ban</h3>
    <form id="deptForm" onsubmit="return false;">
      <input type="hidden" id="deptId" />
      <div class="form-group">
        <label>Mã phòng ban *</label>
        <input type="text" id="deptCode" maxlength="20" placeholder="VD: HCNS, IT, BOOKING" />
        <div class="err-msg" id="errCode"></div>
      </div>
      <div class="form-group">
        <label>Tên phòng ban *</label>
        <input type="text" id="deptName" maxlength="100" placeholder="VD: Hành chính - Nhân sự" />
        <div class="err-msg" id="errName"></div>
      </div>
      <div class="form-group">
        <label>Mô tả</label>
        <textarea id="deptDesc" rows="2" placeholder="Mô tả ngắn về phòng ban"></textarea>
      </div>
      <div class="form-group">
        <label>Trạng thái</label>
        <select id="deptStatus">
          <option value="active">Đang hoạt động</option>
          <option value="inactive">Ngừng hoạt động</option>
        </select>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn" onclick="closeDeptModal()">Hủy</button>
        <button type="button" class="btn btn-primary" id="deptSaveBtn" onclick="saveDept()">Lưu</button>
      </div>
    </form>
  </div>
</div>

<script>
  const API_LIST   = '/Director/Department/ApiList';
  const API_GET    = '/Director/Department/ApiGet';
  const API_CREATE = '/Director/Department/ApiCreate';
  const API_UPDATE = '/Director/Department/ApiUpdate';
  const API_DELETE = '/Director/Department/ApiDelete';

  function getAntiForgeryToken() {
    const el = document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
  }

  function escapeHtml(s) {
    if (s == null) return '';
    return String(s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  /* ── Placeholder helpers ── */
  function fmtManager(v) {
    return (v && v !== 'Chưa bổ nhiệm') ? escapeHtml(v)
      : '<span class="dtc-placeholder">Chưa có dữ liệu</span>';
  }
  function fmtPerfCard(v) {
    if (!v || v === 0) return '<span class="dtc-perf-placeholder">—</span>';
    return `
      <div class="dtc-perf-bar"><div class="dtc-perf-fill" style="width:${v}%"></div></div>
      <span class="dtc-perf-val">${v}%</span>`;
  }
  function fmtPerfTbl(v) {
    if (!v || v === 0) return '<span class="tbl-placeholder">—</span>';
    return `<span class="bar-mini"><span class="bar-mini-fill" style="width:${v}%"></span></span> ${v}%`;
  }
  function fmtQuality(v) {
    if (v && v !== 'Cần cải thiện' && v !== 'Theo dõi sát sao' && v !== 'Tốt') {
      return '<span class="status-chip status-good">' + escapeHtml(v) + '</span>';
    }
    return '<span class="dtc-placeholder">Chưa có dữ liệu</span>';
  }

  /* ── Render 3 card tổng quan ── */
  function renderTopCards(top) {
    const grid = document.getElementById('deptTopGrid');
    if (!top || top.length === 0) {
      grid.innerHTML = '';
      return;
    }
    grid.innerHTML = top.slice(0, 3).map(d => `
      <div class="dept-top-card">
        <div class="dtc-head">
          <div class="dtc-name">${escapeHtml(d.name)}</div>
          <div class="dtc-icon">
            <svg class="icon-svg" style="width:18px;height:18px;" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 21h18M5 21V5l7-3 7 3v16M9 21v-4h6v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div class="dtc-badge">
          <svg class="icon-svg" style="width:12px;height:12px;" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          ${d.headcount || 0} nhân sự
        </div>
        <div class="dtc-section-label">Trưởng phòng</div>
        <div class="dtc-value">${fmtManager(d.manager)}</div>
        <div class="dtc-perf-label">Hiệu suất tháng</div>
        <div class="dtc-perf-row">${fmtPerfCard(d.performance)}</div>
      </div>
    `).join('');
  }

  /* ── Render bảng ── */
  function renderTable(list) {
    const tbody = document.getElementById('deptTbody');
    if (!list || list.length === 0) {
      tbody.innerHTML = '<tr><td class="dept-table-empty">Chưa có phòng ban nào. Bấm "Thêm phòng ban" để bắt đầu.</td></tr>';
      return;
    }
    tbody.innerHTML = list.map(d => {
      const statusBadge = d.status === 'active'
        ? '<span class="status-chip status-good">Đang hoạt động</span>'
        : '<span class="status-chip status-warn">Ngừng hoạt động</span>';
      return `
        <tr class="dept-row">
          <td>
            <strong style="color:var(--navy);font-size:14px;">${escapeHtml(d.name)}</strong>
            ${d.code ? '<br><span style="color:var(--muted);font-size:12px;">' + escapeHtml(d.code) + '</span>' : ''}
          </td>
          <td style="color:var(--ink-2);font-size:13px;">${fmtManager(d.manager)}</td>
          <td style="font-size:13px;"><span style="font-weight:700;color:var(--navy);">${d.headcount || 0}</span> nhân sự</td>
          <td>${fmtPerfTbl(d.performance)}</td>
          <td>${fmtQuality(d.quality)}</td>
          <td>
            <div class="row-actions">
              <button title="Sửa" onclick="openEditModal(${d.id})">
                <svg class="icon-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 21.7V5a2 2 0 0 1 2-2h12.8M12.56 6.59a1 1 0 0 1 1.42 0l2.91 2.91a1 1 0 0 1 0 1.42L9.41 18.4H5.21v-4.2l7.35-7.3zM17 3l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="btn-del" title="Xóa" onclick="deleteDept(${d.id}, '${escapeHtml(d.name)}')">
                <svg class="icon-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m3 0v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6h14z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </td>
        </tr>`;
    }).join('');
  }

  /* ── Load data ── */
  async function apiFetch(url, options = {}) {
    const headers = Object.assign(
      { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
      options.headers || {}
    );
    const res = await fetch(url, Object.assign({}, options, { headers, credentials: 'same-origin' }));
    let json;
    try { json = await res.json(); }
    catch { throw new Error(`Máy chủ trả phản hồi không hợp lệ (HTTP ${res.status}). Vui lòng thử tải lại trang.`); }
    return { ok: res.ok, status: res.status, json };
  }

  async function loadList() {
    try {
      const { ok, json } = await apiFetch(API_LIST);
      if (!ok) { alert(json.message || 'Không tải được danh sách phòng ban.'); return; }
      if (json.success) {
        renderTopCards(json.data.top || []);
        renderTable(json.data.list || []);
      } else {
        alert(json.message || 'Không tải được danh sách phòng ban.');
      }
    } catch (e) { alert(e.message); }
  }

  /* ── Modal ── */
  function openModal(id)  { document.getElementById(id).classList.add('active'); }
  function closeModal(id) { document.getElementById(id).classList.remove('active'); }

  function openAddModal() {
    document.getElementById('modalTitle').textContent = 'Thêm phòng ban';
    document.getElementById('deptId').value = '';
    document.getElementById('deptCode').value = '';
    document.getElementById('deptName').value = '';
    document.getElementById('deptDesc').value = '';
    document.getElementById('deptStatus').value = 'active';
    document.getElementById('errCode').textContent = '';
    document.getElementById('errName').textContent = '';
    document.getElementById('deptCode').disabled = false;
    openModal('deptModal');
  }

  async function openEditModal(id) {
    try {
      const { ok, json } = await apiFetch(API_GET + '/' + id);
      if (!ok) { alert(json.message || 'Không tải được dữ liệu.'); return; }
      if (!json.success) { alert(json.message || 'Không tải được dữ liệu.'); return; }
      const d = json.data;
      document.getElementById('modalTitle').textContent = 'Sửa phòng ban';
      document.getElementById('deptId').value = d.id;
      document.getElementById('deptCode').value = d.code;
      document.getElementById('deptName').value = d.name;
      document.getElementById('deptDesc').value = d.description || '';
      document.getElementById('deptStatus').value = d.status || 'active';
      document.getElementById('errCode').textContent = '';
      document.getElementById('errName').textContent = '';
      document.getElementById('deptCode').disabled = true;
      openModal('deptModal');
    } catch (e) { alert(e.message); }
  }

  function closeDeptModal() { closeModal('deptModal'); }

  async function saveDept() {
    const id = document.getElementById('deptId').value;
    const code = document.getElementById('deptCode').value.trim();
    const name = document.getElementById('deptName').value.trim();
    const desc = document.getElementById('deptDesc').value.trim();
    const status = document.getElementById('deptStatus').value;

    document.getElementById('errCode').textContent = '';
    document.getElementById('errName').textContent = '';

    const payload = { code, name, description: desc, status };
    const url = id ? API_UPDATE + '/' + id : API_CREATE;
    const method = id ? 'PUT' : 'POST';
    const headers = { 'Content-Type': 'application/json' };
    const token = getAntiForgeryToken();
    if (token) headers['RequestVerificationToken'] = token;

    try {
      const { ok, json } = await apiFetch(url, {
        method, headers, credentials: 'same-origin',
        body: JSON.stringify(payload)
      });
      if (!ok) { alert(json.message || 'Có lỗi xảy ra.'); return; }
      if (json.success) {
        closeDeptModal();
        await loadList();
        alert(json.message || 'Lưu thành công.');
      } else {
        const msg = (json.message || '').toLowerCase();
        if (msg.includes('mã')) document.getElementById('errCode').textContent = json.message;
        else if (msg.includes('tên')) document.getElementById('errName').textContent = json.message;
        else alert(json.message || 'Có lỗi xảy ra.');
      }
    } catch (e) { alert(e.message); }
  }

  async function deleteDept(id, name) {
    if (!confirm('Bạn có chắc muốn xóa phòng ban "' + name + '"?\n\nLưu ý: Không thể xóa nếu đang có nhân viên thuộc phòng ban này.')) return;
    const headers = { 'Content-Type': 'application/json' };
    const token = getAntiForgeryToken();
    if (token) headers['RequestVerificationToken'] = token;
    try {
      const { ok, json } = await apiFetch(API_DELETE + '/' + id, { method: 'POST', headers });
      if (!ok) { alert(json.message || 'Xóa thất bại.'); return; }
      if (json.success) { await loadList(); alert(json.message || 'Xóa thành công.'); }
      else alert(json.message || 'Xóa thất bại.');
    } catch (e) { alert(e.message); }
  }

  document.addEventListener('DOMContentLoaded', loadList);
</script>
</body>
</html>
