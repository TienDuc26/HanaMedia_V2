<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Dashboard Giám đốc</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body>
<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">HM</div>
      <div>
        <div class="brand-name">HanaMedia</div>
        <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
      </div>
    </div>

    <div class="nav-section">Tổng quan</div>
    <a href="/Director/Dashboard" class="nav-item active"><i class="fas fa-th-large"></i>Dashboard</a>
    <a href="/Tasks" class="nav-item"><i class="fas fa-list-check"></i>Phân công &amp; Duyệt việc</a>
    <a href="/Director/Report" class="nav-item"><i class="fas fa-chart-line"></i>Báo cáo</a>

    <div class="nav-section">Nghiệp vụ</div>
    <a href="/Director/HumanResources" class="nav-item"><i class="fas fa-users"></i>Nhân sự</a>
    <a href="/Director/Department" class="nav-item"><i class="fas fa-building"></i>Phòng ban</a>
    <a href="/Director/BookingCampaign" class="nav-item"><i class="fas fa-star"></i>Booking / KOL</a>
    <a href="/Director/Idea" class="nav-item"><i class="fas fa-lightbulb"></i>Ý tưởng &amp; Chiến dịch</a>
    <a href="/Director/Approve" class="nav-item"><i class="fas fa-clipboard-check"></i>Phê duyệt</a>
    <a href="/Director/SignContract" class="nav-item"><i class="fas fa-pen"></i>Ký Hợp Đồng</a>

    <div class="nav-section">Quản trị</div>
    <a href="/Director/Config" class="nav-item"><i class="fas fa-cog"></i>Cấu hình nghiệp vụ</a>
    <a href="/Director/MonitoringSystem" class="nav-item"><i class="fas fa-shield-alt"></i>Giám sát hệ thống</a>
    <partial name="_UserMenuPartial" />
  </aside>

  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Dashboard tổng quan</div>
        <div class="page-sub">Toàn cảnh nhân sự, booking, ý tưởng &amp; hệ thống — cập nhật 08:30, 12/08/2026</div>
      </div>
      <div class="topbar-actions">
        <div class="period-tabs">
          <div class="period-tab">Ngày</div>
          <div class="period-tab active">Tháng</div>
          <div class="period-tab">Quý</div>
        </div>
        <div class="icon-btn"><i class="fas fa-bell"></i><span class="dot"></span></div>
        <div class="icon-btn"><i class="fas fa-download"></i></div>
      </div>
    </div>

    <!-- KPI GRID -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Tổng nhân sự</div>
          <div class="kpi-icon" style="background:var(--blue-100); color:var(--blue-700);"><i class="fas fa-users"></i></div>
        </div>
        <div class="kpi-value">128</div>
        <div class="kpi-delta up"><i class="fas fa-arrow-up"></i>+6 nhân sự mới tháng này</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Biến động nhân sự</div>
          <div class="kpi-icon" style="background:var(--green-bg); color:var(--green);"><i class="fas fa-user-plus"></i></div>
        </div>
        <div class="kpi-value">+6 / -2</div>
        <div class="kpi-note">Vào mới 6 · Nghỉ việc 2 (tháng 8)</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Booking đang triển khai</div>
          <div class="kpi-icon" style="background:var(--blue-100); color:var(--blue-700);"><i class="fas fa-star"></i></div>
        </div>
        <div class="kpi-value">22</div>
        <div class="kpi-delta up"><i class="fas fa-arrow-up"></i>+4 so với tháng trước</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Doanh thu booking</div>
          <div class="kpi-icon" style="background:var(--green-bg); color:var(--green);"><i class="fas fa-money-bill-wave"></i></div>
        </div>
        <div class="kpi-value">2.4 tỷ</div>
        <div class="kpi-delta up"><i class="fas fa-arrow-up"></i>+12% so với tháng trước</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Công việc quá hạn</div>
          <div class="kpi-icon" style="background:var(--red-bg); color:var(--red);"><i class="fas fa-exclamation-triangle"></i></div>
        </div>
        <div class="kpi-value">7</div>
        <div class="kpi-delta down"><i class="fas fa-arrow-down"></i>Cần xử lý gấp</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Chiến dịch đang chạy</div>
          <div class="kpi-icon" style="background:var(--blue-100); color:var(--blue-700);"><i class="fas fa-rocket"></i></div>
        </div>
        <div class="kpi-value">9</div>
        <div class="kpi-note">3 client lớn, 6 client vừa &amp; nhỏ</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Ý tưởng chờ duyệt</div>
          <div class="kpi-icon" style="background:var(--amber-bg); color:var(--amber);"><i class="fas fa-lightbulb"></i></div>
        </div>
        <div class="kpi-value">14</div>
        <div class="kpi-note">5 ý tưởng ưu tiên cao</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Chi phí booking</div>
          <div class="kpi-icon" style="background:var(--blue-100); color:var(--blue-700);"><i class="fas fa-file-invoice-dollar"></i></div>
        </div>
        <div class="kpi-value">980 tr</div>
        <div class="kpi-note">Biên lợi nhuận ước tính 59%</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Hiệu suất trung bình</div>
          <div class="kpi-icon" style="background:var(--green-bg); color:var(--green);"><i class="fas fa-chart-bar"></i></div>
        </div>
        <div class="kpi-value">91%</div>
        <div class="kpi-delta up"><i class="fas fa-arrow-up"></i>+2 điểm so với quý trước</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Chờ Giám đốc phê duyệt</div>
          <div class="kpi-icon" style="background:var(--red-bg); color:var(--red);"><i class="fas fa-clipboard-list"></i></div>
        </div>
        <div class="kpi-value">6</div>
        <div class="kpi-note">2 lương · 1 nghỉ việc · 2 booking · 1 ý tưởng</div>
      </div>
    </div>

    <!-- ROW: Doanh thu chart + Booking pipeline -->
    <div class="grid-2">
      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">Doanh thu &amp; chi phí booking theo tháng</div>
            <div class="card-sub">6 tháng gần nhất, đơn vị: triệu đồng</div>
          </div>
          <a href="/Director/Report" class="link-btn">Xem báo cáo <i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="legend">
          <span><i style="background:#2F80ED"></i>Doanh thu</span>
          <span><i style="background:#B7D3FA"></i>Chi phí</span>
          <span><i style="background:#1CA36B"></i>Lợi nhuận</span>
        </div>
        <div style="position:relative; height:260px;">
          <canvas id="revenueChart" role="img" aria-label="Biểu đồ doanh thu, chi phí và lợi nhuận booking theo tháng từ tháng 3 đến tháng 8">Doanh thu theo tháng (triệu đồng): T3 1650, T4 1820, T5 1900, T6 2050, T7 2150, T8 2400.</canvas>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">Trạng thái booking</div>
            <div class="card-sub">Tổng 126 booking trong kỳ</div>
          </div>
        </div>
        <div style="position:relative; height:190px; margin-bottom:12px;">
          <canvas id="bookingChart" role="img" aria-label="Biểu đồ tròn phân bổ trạng thái booking: chờ 12, thương lượng 8, chốt 15, triển khai 22, hoàn thành 64, hủy 5">Booking: chờ 12, đang thương lượng 8, đã chốt 15, đang triển khai 22, hoàn thành 64, hủy 5.</canvas>
        </div>
        <div class="legend" style="justify-content:space-between; gap:10px 16px;">
          <span><i style="background:#8AB8F2"></i>Đang chờ (12)</span>
          <span><i style="background:#5B9BF0"></i>Thương lượng (8)</span>
          <span><i style="background:#2F80ED"></i>Đã chốt (15)</span>
          <span><i style="background:#185FA5"></i>Triển khai (22)</span>
          <span><i style="background:#1CA36B"></i>Hoàn thành (64)</span>
          <span><i style="background:#DC4E4E"></i>Hủy (5)</span>
        </div>
      </div>
    </div>

    <!-- ROW: Dept headcount + Dept performance + Approvals -->
    <div class="grid-3">
      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">Nhân sự theo phòng ban</div>
            <div class="card-sub">128 nhân sự hiện tại</div>
          </div>
        </div>
        <div class="dept-row"><div class="dept-name">Booking</div><div class="dept-bar-track"><div class="dept-bar-fill" style="width:36%"></div></div><div class="dept-count">46</div></div>
        <div class="dept-row"><div class="dept-name">Ý tưởng</div><div class="dept-bar-track"><div class="dept-bar-fill" style="width:30%"></div></div><div class="dept-count">38</div></div>
        <div class="dept-row"><div class="dept-name">HCNS</div><div class="dept-bar-track"><div class="dept-bar-fill" style="width:11%"></div></div><div class="dept-count">14</div></div>
        <div class="dept-row"><div class="dept-name">Kế toán</div><div class="dept-bar-track"><div class="dept-bar-fill" style="width:9%"></div></div><div class="dept-count">12</div></div>
        <div class="dept-row"><div class="dept-name">IT</div><div class="dept-bar-track"><div class="dept-bar-fill" style="width:6%"></div></div><div class="dept-count">8</div></div>
        <div class="dept-row" style="margin-bottom:0;"><div class="dept-name">Khác</div><div class="dept-bar-track"><div class="dept-bar-fill" style="width:8%"></div></div><div class="dept-count">10</div></div>
      </div>

      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">Hiệu suất phòng ban</div>
            <div class="card-sub">% hoàn thành mục tiêu tháng 8</div>
          </div>
        </div>
        <table>
          <thead><tr><th>Phòng ban</th><th>Hiệu suất</th><th>Đánh giá</th></tr></thead>
          <tbody>
            <tr><td>HCNS</td><td><span class="bar-mini"><span class="bar-mini-fill" style="width:95%"></span></span>95%</td><td><span class="status-chip status-good">Tốt</span></td></tr>
            <tr><td>Booking</td><td><span class="bar-mini"><span class="bar-mini-fill" style="width:92%"></span></span>92%</td><td><span class="status-chip status-good">Tốt</span></td></tr>
            <tr><td>Ý tưởng</td><td><span class="bar-mini"><span class="bar-mini-fill" style="width:87%"></span></span>87%</td><td><span class="status-chip status-good">Tốt</span></td></tr>
            <tr><td>IT</td><td><span class="bar-mini"><span class="bar-mini-fill" style="width:90%"></span></span>90%</td><td><span class="status-chip status-good">Tốt</span></td></tr>
            <tr><td>Kế toán</td><td><span class="bar-mini"><span class="bar-mini-fill" style="width:74%"></span></span>74%</td><td><span class="status-chip status-warn">Theo dõi</span></td></tr>
          </tbody>
        </table>
      </div>

      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">Chờ Giám đốc phê duyệt</div>
            <div class="card-sub">6 mục cần xử lý</div>
          </div>
          <a href="/Director/Approve" class="link-btn">Tất cả</a>
        </div>

        <div class="approval-item">
          <span class="approval-tag tag-salary">Lương</span>
          <div class="approval-body">
            <div class="approval-title">Đề xuất tăng lương — Trần Thị B (Booking)</div>
            <div class="approval-meta">Gửi bởi QL Booking · 2 giờ trước</div>
            <div class="approval-actions"><button class="btn-mini approve">Duyệt</button><button class="btn-mini">Xem chi tiết</button></div>
          </div>
        </div>

        <div class="approval-item">
          <span class="approval-tag tag-offboard">Nghỉ việc</span>
          <div class="approval-body">
            <div class="approval-title">Đơn nghỉ việc — Lê Văn C (Ý tưởng)</div>
            <div class="approval-meta">Gửi bởi QL Ý tưởng · Hôm qua</div>
            <div class="approval-actions"><button class="btn-mini approve">Duyệt</button><button class="btn-mini">Xem chi tiết</button></div>
          </div>
        </div>

        <div class="approval-item">
          <span class="approval-tag tag-booking">Booking</span>
          <div class="approval-body">
            <div class="approval-title">Booking KOL lớn — Client Vinamilk, 480 triệu</div>
            <div class="approval-meta">Gửi bởi QL Booking · Hôm qua</div>
            <div class="approval-actions"><button class="btn-mini approve">Duyệt</button><button class="btn-mini">Xem chi tiết</button></div>
          </div>
        </div>

        <div class="approval-item">
          <span class="approval-tag tag-idea">Ý tưởng</span>
          <div class="approval-body">
            <div class="approval-title">Campaign "Tết Sum Vầy" — chờ duyệt triển khai</div>
            <div class="approval-meta">Gửi bởi QL Ý tưởng · 2 ngày trước</div>
            <div class="approval-actions"><button class="btn-mini approve">Duyệt</button><button class="btn-mini">Xem chi tiết</button></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ROW: Employee list + System monitoring -->
    <div class="grid-2">
      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">Hồ sơ nhân sự nổi bật</div>
            <div class="card-sub">Nhân sự mới &amp; cần chú ý gần đây</div>
          </div>
          <a href="/Director/HumanResources" class="link-btn">Xem toàn bộ hồ sơ</a>
        </div>
        <table>
          <thead>
            <tr><th>Nhân viên</th><th>Phòng ban</th><th>Chức vụ</th><th>Ngày vào</th><th>Trạng thái</th></tr>
          </thead>
          <tbody>
            <tr><td>Phạm Thu Hà</td><td><span class="dept-chip">Booking</span></td><td>Nhân viên</td><td>05/08/2026</td><td><span class="status-chip status-good">Đang làm việc</span></td></tr>
            <tr><td>Đỗ Minh Khôi</td><td><span class="dept-chip">Ý tưởng</span></td><td>Nhân viên</td><td>03/08/2026</td><td><span class="status-chip status-good">Đang làm việc</span></td></tr>
            <tr><td>Vũ Ngọc Lan</td><td><span class="dept-chip">HCNS</span></td><td>Nhân viên</td><td>29/07/2026</td><td><span class="status-chip status-good">Đang làm việc</span></td></tr>
            <tr><td>Nguyễn Anh Tuấn</td><td><span class="dept-chip">Booking</span></td><td>Quản lý</td><td>15/03/2023</td><td><span class="status-chip status-warn">Đang chờ duyệt lương</span></td></tr>
            <tr><td>Lê Văn C</td><td><span class="dept-chip">Ý tưởng</span></td><td>Nhân viên</td><td>10/01/2024</td><td><span class="status-chip status-bad">Chờ duyệt nghỉ việc</span></td></tr>
          </tbody>
        </table>
      </div>

      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">Giám sát hệ thống</div>
            <div class="card-sub">Tổng quan do AdminIT cung cấp</div>
          </div>
          <a href="/Director/MonitoringSystem" class="link-btn">Xem chi tiết</a>
        </div>
        <div class="monitor-row">
          <div class="monitor-label"><i class="fas fa-sign-in-alt"></i>Lượt đăng nhập hôm nay</div>
          <div class="monitor-value">47</div>
        </div>
        <div class="monitor-row">
          <div class="monitor-label"><i class="fas fa-user-friends"></i>Người dùng đang hoạt động</div>
          <div class="monitor-value">31</div>
        </div>
        <div class="monitor-row">
          <div class="monitor-label"><i class="fas fa-wifi"></i>Truy cập ngoài mạng nội bộ bị chặn</div>
          <div class="monitor-value">3</div>
        </div>
        <div class="monitor-row">
          <div class="monitor-label"><i class="fas fa-shield-alt"></i>Cảnh báo bất thường</div>
          <div class="monitor-value">2</div>
        </div>
        <div class="alert-box">
          <i class="fas fa-exclamation-triangle"></i>
          <div>
            <div class="alert-title">2 cảnh báo cần AdminIT xem xét</div>
            <div class="alert-desc">Đăng nhập thất bại nhiều lần (1 tài khoản) · Truy cập từ ngoài mạng nội bộ bị từ chối (3 lần, cùng 1 IP)</div>
          </div>
        </div>
      </div>
    </div>

    <footer>HanaMedia · Dashboard Giám đốc — dữ liệu minh họa cho mục đích thiết kế giao diện</footer>
  </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
const revenueCtx = document.getElementById('revenueChart');
new Chart(revenueCtx, {
  type: 'bar',
  data: {
    labels: ['T3','T4','T5','T6','T7','T8'],
    datasets: [
      { label:'Doanh thu', data:[1650,1820,1900,2050,2150,2400], backgroundColor:'#2F80ED', borderRadius:4, barPercentage:0.6 },
      { label:'Chi phí', data:[720,780,810,860,900,980], backgroundColor:'#B7D3FA', borderRadius:4, barPercentage:0.6 },
      { label:'Lợi nhuận', data:[930,1040,1090,1190,1250,1420], type:'line', borderColor:'#1CA36B', backgroundColor:'#1CA36B', tension:0.35, borderWidth:2, pointRadius:3, pointBackgroundColor:'#1CA36B' }
    ]
  },
  options: {
    responsive:true, maintainAspectRatio:false,
    plugins:{ legend:{ display:false } },
    scales:{
      x:{ grid:{ display:false }, ticks:{ color:'#8494AC', font:{ size:11 } } },
      y:{ grid:{ color:'#EEF2FA' }, ticks:{ color:'#8494AC', font:{ size:11 }, callback:v=>v+'tr' } }
    }
  }
});

const bookingCtx = document.getElementById('bookingChart');
new Chart(bookingCtx, {
  type: 'doughnut',
  data: {
    labels: ['Đang chờ','Thương lượng','Đã chốt','Triển khai','Hoàn thành','Hủy'],
    datasets: [{
      data: [12,8,15,22,64,5],
      backgroundColor: ['#8AB8F2','#5B9BF0','#2F80ED','#185FA5','#1CA36B','#DC4E4E'],
      borderColor:'#fff', borderWidth:2
    }]
  },
  options: {
    responsive:true, maintainAspectRatio:false, cutout:'68%',
    plugins:{ legend:{ display:false } }
  }
});
</script>
</body>
</html>
