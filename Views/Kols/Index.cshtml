@model HanaMedia.ViewModels.KolPageViewModel
@using HanaMedia.Constants
@using System.Security.Claims
@{
  Layout = null;
  var role = User.FindFirstValue(ClaimTypes.Role) ?? string.Empty;
  var isDirector = role == AppRoles.Director;
}
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>HanaMedia — Database KOL/KOC</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
<link rel="stylesheet" href="~/css/design-system.css"><link rel="stylesheet" href="~/css/layout.css"><link rel="stylesheet" href="~/css/components.css">
<style>
.toolbar,.filters,.actions,.module-tabs{display:flex;align-items:center;gap:9px;flex-wrap:wrap}.toolbar{justify-content:space-between;margin-bottom:18px}.module-tabs{margin-bottom:18px}.module-tab{padding:8px 14px;border:1px solid #d9e2ef;border-radius:8px;color:#334155;text-decoration:none}.module-tab.active{background:#3182e8;color:white;border-color:#3182e8}.message{padding:12px 16px;border-radius:8px;margin-bottom:16px}.success{background:#e8f8ef;color:#18794e}.error{background:#fff0f0;color:#c53030}.empty{text-align:center;padding:40px;color:#64748b}.kol-name{min-width:155px}.kol-name small{display:block;color:#64748b;margin-top:4px}.status-tiem_nang{background:#e0f2fe;color:#0369a1}.status-da_lien_he{background:#ede9fe;color:#6d28d9}.status-dang_deal{background:#fff7d6;color:#9a6700}.status-da_chot,.status-dang_chay,.status-hoan_thanh{background:#dcfce7;color:#15803d}.pagination{display:flex;justify-content:center;gap:8px;margin-top:18px}.pagination a{padding:7px 12px;border:1px solid #d9e2ef;border-radius:7px;text-decoration:none;color:#334155}.pagination a.active{background:#3182e8;color:#fff}.modal-card{max-width:760px}.form-grid,.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 18px}.full{grid-column:1/-1}.profile-link{color:#2563eb;text-decoration:none}.stars{color:#f59e0b}.history-table{margin-top:8px}.readonly{font-size:12px;color:#64748b}@@media(max-width:700px){.form-grid,.detail-grid{grid-template-columns:1fr}.full{grid-column:auto}}
</style></head><body><div class="layout"><partial name="_KolSidebarPartial" /><main class="main">
<div class="topbar"><div><div class="page-title">@(isDirector ? "KOL/KOC toàn công ty" : "Cơ sở dữ liệu KOL/KOC")</div><div class="page-sub">Thông tin liên hệ, báo giá, người phụ trách, lịch sử Booking và vòng đời hợp tác</div></div></div>
@if(isDirector){<div class="module-tabs"><a class="module-tab" href="/Campaigns">Chiến dịch</a><a class="module-tab active" href="/Kols">KOL/KOC</a></div>}
@if(TempData["SuccessMessage"] is string success){<div class="message success">@success</div>}@if(TempData["ErrorMessage"] is string error){<div class="message error">@error</div>}
<div class="card"><div class="toolbar"><form method="get" action="/Kols" class="filters">
<input class="form-control" style="width:245px" name="search" value="@Model.Search" placeholder="Tìm tên, niche, địa bàn...">
<select class="form-control" name="platform"><option value="">Tất cả nền tảng</option>@foreach(var platform in KolPlatforms.All){if(platform==Model.Platform){<option value="@platform" selected>@platform</option>}else{<option value="@platform">@platform</option>}}</select>
<select class="form-control" name="status"><option value="">Tất cả trạng thái</option>@foreach(var status in KolStatuses.All){if(status==Model.Status){<option value="@status" selected>@KolStatuses.GetLabel(status)</option>}else{<option value="@status">@KolStatuses.GetLabel(status)</option>}}</select>
<button class="btn-mini" type="submit"><i class="ti ti-search"></i> Lọc</button></form>
@if(Model.CanCreate){<button class="btn-mini approve" type="button" onclick="openModal('createKolModal')"><i class="ti ti-plus"></i> Thêm KOL/KOC</button>}</div>
<div style="overflow-x:auto"><table><thead><tr><th>KOL/KOC</th><th>Nền tảng</th><th>Followers / ER</th><th>Niche</th><th>Giá Booking</th><th>Phụ trách</th><th>Đánh giá</th><th>Trạng thái</th><th>Hành động</th></tr></thead><tbody>
@if(Model.Kols.Count==0){<tr><td colspan="9" class="empty">Chưa có KOL/KOC phù hợp.</td></tr>}
@foreach(var item in Model.Kols){<tr><td class="kol-name"><strong>@item.Name</strong><small>@item.Location</small></td><td>@item.Platform<br><a class="profile-link" href="@item.ProfileLink" target="_blank" rel="noopener"><i class="ti ti-external-link"></i> Hồ sơ</a></td><td>@item.FollowersCount.ToString("N0")<br><small>@item.EngagementRate.ToString("0.##")%</small></td><td>@item.Niche</td><td>@item.BookingPrice.ToString("N0") đ</td><td>@item.ResponsibleStaffName</td><td><span class="stars">@(item.RatingScore.HasValue ? new string('★', item.RatingScore.Value) : "Chưa có")</span></td><td><span class="status-chip status-@item.Status">@item.StatusLabel</span></td><td><div class="actions"><button class="btn-mini" type="button" onclick="openModal('detail-@item.Id')">Chi tiết</button>@if(item.CanEdit){<button type="button" class="btn-mini approve edit-kol" data-id="@item.Id" data-name="@item.Name" data-platform="@item.Platform" data-link="@item.ProfileLink" data-followers="@item.FollowersCount" data-engagement="@item.EngagementRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-niche="@item.Niche" data-price="@item.BookingPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-location="@item.Location" data-contact="@item.ContactInfo" data-staff="@item.ResponsibleStaffId" data-rating="@item.RatingScore" data-status="@item.Status" data-version="@item.RowVersion">Cập nhật</button>}@if(Model.CanManageAll){<form method="post" action="/Kols/Delete" onsubmit="return confirm('Xóa KOL/KOC này?')">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@item.Id"><input type="hidden" name="RowVersion" value="@item.RowVersion"><button class="btn-mini reject" type="submit" disabled="@(!item.CanDelete)">Xóa</button></form>}</div></td></tr>}
</tbody></table></div>@if(Model.TotalPages>1){<div class="pagination">@for(var p=1;p<=Model.TotalPages;p++){<a class="@(p==Model.Page?"active":"")" href="/Kols?search=@Uri.EscapeDataString(Model.Search??"")&platform=@Model.Platform&status=@Model.Status&page=@p">@p</a>}</div>}</div>
<footer>HanaMedia · Module 8 — Database KOL/KOC dùng chung cho Booking</footer></main></div>

@foreach(var item in Model.Kols){<div class="modal-backdrop" id="detail-@item.Id"><div class="modal-card"><div class="modal-header"><div class="modal-title">Hồ sơ @item.Name</div><button class="modal-close" type="button" onclick="closeModal('detail-@item.Id')">&times;</button></div><div class="modal-body"><div class="detail-grid"><div><div class="info-label">Nền tảng &amp; tài khoản</div><div class="info-val">@item.Platform · <a class="profile-link" href="@item.ProfileLink" target="_blank" rel="noopener">Mở hồ sơ</a></div></div><div><div class="info-label">Followers / Engagement</div><div class="info-val">@item.FollowersCount.ToString("N0") · @item.EngagementRate.ToString("0.##")%</div></div><div><div class="info-label">Chủ đề/Niche</div><div class="info-val">@item.Niche</div></div><div><div class="info-label">Giá Booking</div><div class="info-val">@item.BookingPrice.ToString("N0") đ</div></div><div><div class="info-label">Địa bàn</div><div class="info-val">@item.Location</div></div><div><div class="info-label">Liên hệ</div><div class="info-val">@item.ContactInfo</div></div><div><div class="info-label">Người phụ trách</div><div class="info-val">@item.ResponsibleStaffName</div></div><div><div class="info-label">Đánh giá</div><div class="info-val stars">@(item.RatingScore.HasValue ? $"{item.RatingScore}/5 ★" : "Chưa đánh giá")</div></div></div><div style="border-top:1px solid var(--line);padding-top:15px"><div class="card-title">Lịch sử Booking (@item.BookingHistory.Count)</div>@if(item.BookingHistory.Count==0){<div class="empty">KOL/KOC chưa có Booking.</div>}else{<div style="overflow-x:auto"><table class="history-table"><thead><tr><th>Campaign</th><th>Client</th><th>Giá</th><th>Deadline</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var history in item.BookingHistory){<tr><td>@history.CampaignName</td><td>@history.ClientName</td><td>@history.BookingPrice.ToString("N0") đ</td><td>@history.Deadline.ToString("dd/MM/yyyy")</td><td>@history.StatusLabel</td></tr>}</tbody></table></div>}</div></div><div class="modal-footer"><button class="btn-mini approve" type="button" onclick="closeModal('detail-@item.Id')">Đóng</button></div></div></div>}

@if(Model.CanCreate){<div class="modal-backdrop" id="createKolModal"><div class="modal-card"><form method="post" action="/Kols/Create">@Html.AntiForgeryToken()<div class="modal-header"><div class="modal-title">Thêm KOL/KOC vào database</div><button class="modal-close" type="button" onclick="closeModal('createKolModal')">&times;</button></div><div class="modal-body"><div class="form-grid">
<div class="form-group"><label>Tên KOL/KOC *</label><input class="form-control" name="Name" minlength="2" maxlength="100" required></div><div class="form-group"><label>Nền tảng *</label><select class="form-control" name="Platform">@foreach(var platform in KolPlatforms.All){<option value="@platform">@platform</option>}</select></div><div class="form-group full"><label>Link tài khoản *</label><input class="form-control" type="url" name="ProfileLink" placeholder="https://..." maxlength="255" required></div><div class="form-group"><label>Followers *</label><input class="form-control" type="number" name="FollowersCount" min="0" value="0" required></div><div class="form-group"><label>Engagement (%) *</label><input class="form-control" type="number" name="EngagementRate" min="0" max="100" step="0.01" value="0" required></div><div class="form-group"><label>Chủ đề/Niche *</label><input class="form-control" name="Niche" maxlength="100" required></div><div class="form-group"><label>Giá Booking (VND) *</label><input class="form-control" type="number" name="BookingPrice" min="0" step="1000" value="0" required></div><div class="form-group"><label>Địa bàn *</label><input class="form-control" name="Location" maxlength="100" required></div><div class="form-group"><label>Liên hệ *</label><input class="form-control" name="ContactInfo" maxlength="255" required></div>
@if(Model.CanManageAll){<div class="form-group"><label>Người phụ trách *</label><select class="form-control" name="ResponsibleStaffId" required><option value="">-- Chọn nhân sự Booking --</option>@foreach(var staff in Model.ResponsibleStaff){<option value="@staff.Id">@staff.Name</option>}</select></div><div class="form-group"><label>Đánh giá</label><select class="form-control" name="RatingScore"><option value="">Chưa đánh giá</option>@for(var score=1;score<=5;score++){<option value="@score">@score sao</option>}</select></div>}
<div class="form-group"><label>Trạng thái</label><select class="form-control" name="Status">@foreach(var status in KolStatuses.All){<option value="@status">@KolStatuses.GetLabel(status)</option>}</select></div></div></div><div class="modal-footer"><button class="btn-mini" type="button" onclick="closeModal('createKolModal')">Hủy</button><button class="btn-mini approve" type="submit">Thêm KOL/KOC</button></div></form></div></div>}

@if(Model.CanCreate){<div class="modal-backdrop" id="editKolModal"><div class="modal-card"><form method="post" action="/Kols/Update">@Html.AntiForgeryToken()<input type="hidden" name="Id" id="editId"><input type="hidden" name="RowVersion" id="editVersion"><div class="modal-header"><div class="modal-title">Cập nhật KOL/KOC</div><button class="modal-close" type="button" onclick="closeModal('editKolModal')">&times;</button></div><div class="modal-body"><div class="form-grid">
<div class="form-group"><label>Tên KOL/KOC *</label><input class="form-control" name="Name" id="editName" minlength="2" maxlength="100" required></div><div class="form-group"><label>Nền tảng *</label><select class="form-control" name="Platform" id="editPlatform">@foreach(var platform in KolPlatforms.All){<option value="@platform">@platform</option>}</select></div><div class="form-group full"><label>Link tài khoản *</label><input class="form-control" type="url" name="ProfileLink" id="editLink" maxlength="255" required></div><div class="form-group"><label>Followers *</label><input class="form-control" type="number" name="FollowersCount" id="editFollowers" min="0" required></div><div class="form-group"><label>Engagement (%) *</label><input class="form-control" type="number" name="EngagementRate" id="editEngagement" min="0" max="100" step="0.01" required></div><div class="form-group"><label>Chủ đề/Niche *</label><input class="form-control" name="Niche" id="editNiche" maxlength="100" required></div><div class="form-group"><label>Giá Booking *</label><input class="form-control" type="number" name="BookingPrice" id="editPrice" min="0" step="1000" required></div><div class="form-group"><label>Địa bàn *</label><input class="form-control" name="Location" id="editLocation" maxlength="100" required></div><div class="form-group"><label>Liên hệ *</label><input class="form-control" name="ContactInfo" id="editContact" maxlength="255" required></div>
@if(Model.CanManageAll){<div class="form-group"><label>Người phụ trách *</label><select class="form-control" name="ResponsibleStaffId" id="editStaff" required>@foreach(var staff in Model.ResponsibleStaff){<option value="@staff.Id">@staff.Name</option>}</select></div><div class="form-group"><label>Đánh giá</label><select class="form-control" name="RatingScore" id="editRating"><option value="">Chưa đánh giá</option>@for(var score=1;score<=5;score++){<option value="@score">@score sao</option>}</select></div>}
<div class="form-group"><label>Trạng thái</label><select class="form-control" name="Status" id="editStatus">@foreach(var status in KolStatuses.All){<option value="@status">@KolStatuses.GetLabel(status)</option>}</select></div></div></div><div class="modal-footer"><button class="btn-mini" type="button" onclick="closeModal('editKolModal')">Hủy</button><button class="btn-mini approve" type="submit">Lưu thay đổi</button></div></form></div></div>}
<script>
function openModal(id){document.getElementById(id)?.classList.add('active')}function closeModal(id){document.getElementById(id)?.classList.remove('active')}
document.querySelectorAll('.edit-kol').forEach(button=>button.addEventListener('click',()=>{for(const key of ['Id','Name','Platform','Link','Followers','Engagement','Niche','Price','Location','Contact','Staff','Rating','Status','Version']){const input=document.getElementById('edit'+key);if(input)input.value=button.dataset[key.toLowerCase()]??''}openModal('editKolModal')}));document.querySelectorAll('.modal-backdrop').forEach(item=>item.addEventListener('click',event=>{if(event.target===item)item.classList.remove('active')}));
</script></body></html>
