@model HanaMedia.Models.Booking
@using HanaMedia.Models
@using System.Globalization
@*
  Phân bổ thù lao theo công thức mới (50/10/40):
   - 50% lợi nhuận công ty
   - 10% hoa hồng QL Booking (hiển thị trong card "PHÂN BỔ GIÁ TRỊ BOOKING")
   - 40% cát-xê chia đều cho các KOL/KOC (hiển thị trong bảng "KOL / KOC THAM GIA")
  Phần này không còn picker "Chọn nhân viên" — chỉ lưu thông tin tham khảo về các nhân viên cũ (nếu có).
*@
@{
  var hasLegacyWages = Model.BookingWages.Any();
}
@if (hasLegacyWages)
{
  <section class="enterprise-card" style="border-left: 4px solid var(--warning-color);">
    <div class="card-header-clean">
      <h2 class="card-title-text"><i class="ti ti-archive" style="color: var(--warning);"></i> PHÂN BỔ NHÂN VIÊN (CŨ - CHỈ THAM KHẢO)</h2>
      <span class="card-subtitle-text">Booking này được tạo trước khi áp dụng quy tắc 50/10/40. Phân bổ dưới đây chỉ lưu lại, không còn hiệu lực tính tiền.</span>
    </div>
    <table class="kol-table">
      <thead><tr><th>Nhân viên</th><th class="num">Thù lao (lịch sử)</th></tr></thead>
      <tbody>
        @foreach (var wage in Model.BookingWages)
        {
          <tr>
            <td>@wage.Employee?.FullName</td>
            <td class="num">@wage.AllocatedWage.ToString("N0") đ</td>
          </tr>
        }
      </tbody>
    </table>
    <p style="margin-top:8px; color: var(--text-muted); font-size: 12.5px;">
      <i class="ti ti-info-circle"></i> Quy tắc hiện hành: chỉ KOL/KOC được chia cát-xê (40%). Không còn chọn nhân viên cho Booking mới.
    </p>
  </section>
}
else
{
  <section class="enterprise-card" style="background: linear-gradient(135deg,#f0fdf4 0%,#ecfdf5 100%); border-left: 4px solid var(--success-color);">
    <h2 class="card-title-text" style="color: var(--success);"><i class="ti ti-shield-check"></i> QUY TẮC PHÂN BỔ MỚI</h2>
    <p style="margin: 6px 0 0; color: var(--text-color); font-size: 14px;">
      Theo quy tắc hiện hành, Booking này chỉ chia cát-xê cho KOL/KOC đã chọn — không chọn nhân viên tham gia. Toàn bộ quy tắc phân bổ được hiển thị chi tiết trong các thẻ "PHÂN BỔ GIÁ TRỊ BOOKING" và "KOL / KOC THAM GIA" phía trên.
    </p>
  </section>
}
