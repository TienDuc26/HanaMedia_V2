@model HanaMedia.ViewModels.IdeaPageViewModel
@using System.Text.Json
@using HanaMedia.Constants
@{
  Layout = null;
  var controllerName = Model.IsManager ? "ManageIdea" : "IdeaStaff";
  var pageAction = "/" + controllerName + "/Idea";
  var ideasJson = JsonSerializer.Serialize(Model.Items);
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Quản lý Ý tưởng</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabler-icons/2.44.0/iconfont/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css"><link rel="stylesheet" href="~/css/layout.css"><link rel="stylesheet" href="~/css/components.css">
  <style>
    .idea-toolbar{display:flex;justify-content:space-between;gap:14px;align-items:end;flex-wrap:wrap}.idea-filters{display:flex;gap:10px;flex-wrap:wrap;flex:1}.idea-filters .form-control{min-width:190px}
    .idea-title{font-weight:700;color:var(--navy);max-width:260px}.idea-sub{font-size:12px;color:var(--muted);margin-top:4px}.idea-actions{display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap}.idea-actions form{display:inline}
    .idea-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 18px}.idea-grid .wide{grid-column:1/-1}.status-idea{background:#eef2ff;color:#4f46e5}.status-review{background:#fff7df;color:#b46b00}.status-revision{background:#ffe9e9;color:#c73535}.status-approved{background:#e5f7ee;color:#15945c}.status-progress{background:#e5f1ff;color:#1769aa}.status-done{background:#dff5e8;color:#087a43}
    .message{padding:11px 14px;border-radius:8px;margin-bottom:14px}.message-ok{background:#e5f7ee;color:#087a43}.message-error{background:#ffe9e9;color:#b42318}.comment{padding:10px 0;border-bottom:1px solid var(--line)}.comment:last-child{border:0}.comment-meta{font-size:12px;color:var(--muted);margin-bottom:3px}.file-link{display:inline-flex;align-items:center;gap:5px;color:var(--blue-600);text-decoration:none}.moodboard-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;margin-top:8px}.moodboard-item{position:relative;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#f5f7fb}.moodboard-item img{display:block;width:100%;height:110px;object-fit:cover}.moodboard-remove{position:absolute;right:5px;top:5px;border:0;border-radius:50%;width:26px;height:26px;background:rgba(180,35,24,.9);color:#fff;cursor:pointer}.pagination{display:flex;justify-content:center;gap:6px;margin-top:18px}.pagination a,.pagination span{padding:7px 11px;border:1px solid var(--line);border-radius:7px;text-decoration:none}.pagination .current{background:var(--blue-600);color:#fff}.empty{text-align:center;padding:40px 16px;color:var(--muted)}
    @@media(max-width:900px){.idea-grid{grid-template-columns:1fr}.idea-grid .wide{grid-column:auto}.table-wrap{overflow-x:auto}}
  </style>
</head>
<body><div class="layout"><partial name="_SidebarPartial" /><main class="main">
  <div class="topbar"><div><div class="page-title">Kịch bản &amp; Ý tưởng</div><div class="page-sub">Tạo ý tưởng → Review → Chỉnh sửa → Duyệt → Triển khai → Hoàn thành</div></div></div>
  @if (TempData["SuccessMessage"] is string success){<div class="message message-ok"><i class="ti ti-circle-check"></i> @success</div>}
  @if (TempData["ErrorMessage"] is string error){<div class="message message-error"><i class="ti ti-alert-circle"></i> @error</div>}
  @if (Model.Reviewers.Count == 0){<div class="message message-error"><i class="ti ti-user-exclamation"></i> Chưa có tài khoản Quản lý Ý tưởng liên kết với hồ sơ nhân sự đang hoạt động. Cần hoàn thiện dữ liệu Module 5 trước khi gửi review.</div>}
  @if (Model.Campaigns.Count == 0){<div class="message message-error"><i class="ti ti-rocket-off"></i> Chưa có chiến dịch đang hoạt động. Cần tạo Campaign trước khi tạo ý tưởng.</div>}
  <div class="card"><form method="get" action="@pageAction" class="idea-toolbar"><div class="idea-filters">
    <input class="form-control" name="search" value="@Model.Search" placeholder="Tìm tên ý tưởng, client, chiến dịch...">
    <select class="form-control" name="status"><option value="">Tất cả trạng thái</option>@foreach(var item in IdeaStatuses.All){<option value="@item" selected="@(Model.Status == item)">@IdeaStatuses.GetLabel(item)</option>}</select>
    <button class="btn-mini" type="submit"><i class="ti ti-search"></i> Tìm</button></div><button class="btn-mini approve" type="button" onclick="openModal('createIdeaModal')" disabled="@(Model.Reviewers.Count == 0 || Model.Campaigns.Count == 0)"><i class="ti ti-plus"></i> Tạo ý tưởng</button>
  </form></div>
  <div class="card table-wrap"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px"><strong>@Model.TotalItems ý tưởng</strong><span class="idea-sub">20 ý tưởng / trang</span></div>
    <table><thead><tr><th>Ý tưởng</th><th>Client &amp; chiến dịch</th><th>Phụ trách / Review</th><th>Deadline</th><th>Trạng thái</th><th style="text-align:right">Hành động</th></tr></thead><tbody>
    @foreach(var idea in Model.Items){var statusClass=idea.Status switch{IdeaStatuses.Review=>"status-review",IdeaStatuses.NeedRevision=>"status-revision",IdeaStatuses.Approved=>"status-approved",IdeaStatuses.InProgress=>"status-progress",IdeaStatuses.Done=>"status-done",_=>"status-idea"};<tr id="idea-row-@idea.Id">
      <td><div class="idea-title">@idea.Title</div><div class="idea-sub">Tạo bởi @idea.CreatorName</div></td><td><strong>@idea.ClientName</strong><div class="idea-sub">@idea.CampaignName</div></td><td>@idea.PrimaryStaffName<div class="idea-sub">Review: @idea.ReviewerName</div></td><td>@idea.Deadline.ToString("dd/MM/yyyy")</td><td><span class="status-chip @statusClass">@idea.StatusLabel</span></td>
      <td><div class="idea-actions"><button class="btn-mini" type="button" onclick="openIdea(@idea.Id)">Chi tiết</button>@if(idea.CanSubmit){<form asp-controller="@controllerName" asp-action="SubmitIdea" method="post"><input type="hidden" name="id" value="@idea.Id"><button class="btn-mini approve" type="submit">Gửi review</button></form>}@if(idea.CanAdvance){<form asp-controller="@controllerName" asp-action="AdvanceIdea" method="post"><input type="hidden" name="id" value="@idea.Id"><button class="btn-mini approve" type="submit">@(idea.Status==IdeaStatuses.Approved?"Triển khai":"Hoàn thành")</button></form>}</div></td>
    </tr>}</tbody></table>
    @if(Model.Items.Count==0){<div class="empty"><i class="ti ti-bulb-off"></i><br>Chưa có ý tưởng phù hợp.</div>}
    @if(Model.TotalPages>1){<div class="pagination">@for(var p=1;p<=Model.TotalPages;p++){if(p==Model.Page){<span class="current">@p</span>}else{<a href="@pageAction?search=@Uri.EscapeDataString(Model.Search??"")&status=@Model.Status&page=@p">@p</a>}}</div>}
  </div><footer>HanaMedia · Module 13 — Quản lý Ý tưởng lõi</footer>
</main></div>

<div class="modal-backdrop" id="createIdeaModal"><div class="modal-card" style="width:760px;max-width:96%"><form asp-controller="@controllerName" asp-action="CreateIdea" method="post" enctype="multipart/form-data">
  <div class="modal-header"><div class="modal-title">Tạo ý tưởng mới</div><button class="modal-close" type="button" onclick="closeModal('createIdeaModal')">&times;</button></div><div class="modal-body" style="max-height:68vh;overflow-y:auto"><div class="idea-grid">
    <div class="form-group"><label>Tên ý tưởng *</label><input class="form-control" name="Title" maxlength="150" required></div>
    <div class="form-group"><label>Campaign *</label><select class="form-control" name="CampaignId" required><option value="">-- Chọn chiến dịch --</option>@foreach(var c in Model.Campaigns){<option value="@c.Id">@c.Client — @c.Name</option>}</select><div class="idea-sub">Client tự lấy theo Campaign, không nhập trùng.</div></div>
    <div class="form-group"><label>Deadline *</label><input class="form-control" type="date" name="Deadline" min="@DateTime.Today.ToString("yyyy-MM-dd")" required></div>
    @if(Model.IsManager){<div class="form-group"><label>Người phụ trách *</label><select class="form-control" name="PrimaryStaffId" required><option value="">-- Chọn nhân sự --</option>@foreach(var s in Model.Staff){<option value="@s.Id">@s.Name (@s.OpenTaskCount việc mở)</option>}</select></div>}
    <div class="form-group"><label>Người review *</label><select class="form-control" name="ReviewerEmployeeId" required><option value="">-- Chọn QL Ý tưởng --</option>@foreach(var r in Model.Reviewers){<option value="@r.Id">@r.Name</option>}</select></div>
    <div class="form-group wide"><label>Insight</label><textarea class="form-control" name="Insight" rows="2" maxlength="2000"></textarea></div><div class="form-group wide"><label>Concept</label><textarea class="form-control" name="Concept" rows="2" maxlength="4000"></textarea></div><div class="form-group wide"><label>Nội dung</label><textarea class="form-control" name="ContentDetails" rows="3" maxlength="8000"></textarea></div>
    <div class="form-group"><label>Reference link</label><input class="form-control" type="url" name="ReferenceLink" maxlength="255" placeholder="https://..."></div><div class="form-group"><label>Upload reference (tối đa 10 MB)</label><input class="form-control" type="file" name="ReferenceFile" accept=".pdf,.doc,.docx,.ppt,.pptx,.jpg,.jpeg,.png,.webp"></div>
    <div class="form-group"><label>Mô tả moodboard</label><textarea class="form-control" name="MoodboardDesc" rows="2" maxlength="2000"></textarea></div><div class="form-group"><label>Ảnh moodboard @(Model.IsManager ? "(chọn nhiều ảnh)" : "")</label>@if(Model.IsManager){<input class="form-control" type="file" name="MoodboardFiles" accept=".jpg,.jpeg,.png,.webp" multiple><div class="idea-sub">Tối đa 10 ảnh/lần, tổng không quá 30 MB.</div>}else{<input class="form-control" type="file" name="MoodboardFile" accept=".jpg,.jpeg,.png,.webp">}</div><div class="form-group wide"><label>Script</label><textarea class="form-control" name="ScriptText" rows="5" maxlength="12000"></textarea></div>
  </div></div><div class="modal-footer"><button class="btn-mini" type="button" onclick="closeModal('createIdeaModal')">Hủy</button><button class="btn-mini approve" type="submit">Lưu ý tưởng</button></div>
</form></div></div>

<div class="modal-backdrop" id="detailIdeaModal"><div class="modal-card" style="width:820px;max-width:96%"><div class="modal-header"><div class="modal-title" id="detailTitle">Chi tiết ý tưởng</div><button class="modal-close" type="button" onclick="closeModal('detailIdeaModal')">&times;</button></div><div class="modal-body" style="max-height:72vh;overflow-y:auto">
  <form asp-controller="@controllerName" asp-action="UpdateIdea" method="post" enctype="multipart/form-data" id="editIdeaForm"><input type="hidden" name="Id" id="editId"><div class="idea-grid">
    <div class="form-group"><label>Tên ý tưởng *</label><input class="form-control" name="Title" id="editTitle" maxlength="150" required></div><div class="form-group"><label>Campaign *</label><select class="form-control" name="CampaignId" id="editCampaignId" required>@foreach(var c in Model.Campaigns){<option value="@c.Id">@c.Client — @c.Name</option>}</select></div><div class="form-group"><label>Deadline *</label><input class="form-control" type="date" name="Deadline" id="editDeadline" required></div>
    @if(Model.IsManager){<div class="form-group"><label>Người phụ trách *</label><select class="form-control" name="PrimaryStaffId" id="editPrimaryStaffId" required>@foreach(var s in Model.Staff){<option value="@s.Id">@s.Name (@s.OpenTaskCount việc mở)</option>}</select></div>}else{<input type="hidden" name="PrimaryStaffId" id="editPrimaryStaffId">}
    <div class="form-group"><label>Người review *</label><select class="form-control" name="ReviewerEmployeeId" id="editReviewerEmployeeId" required @(!Model.IsManager?"disabled":null)>@foreach(var r in Model.Reviewers){<option value="@r.Id">@r.Name</option>}</select>@if(!Model.IsManager){<input type="hidden" name="ReviewerEmployeeId" id="editReviewerHidden">}</div><div class="form-group"><label>Trạng thái</label><input class="form-control" id="detailStatus" readonly></div>
    <div class="form-group wide"><label>Insight</label><textarea class="form-control" name="Insight" id="editInsight" rows="2" maxlength="2000"></textarea></div><div class="form-group wide"><label>Concept</label><textarea class="form-control" name="Concept" id="editConcept" rows="2" maxlength="4000"></textarea></div><div class="form-group wide"><label>Nội dung</label><textarea class="form-control" name="ContentDetails" id="editContent" rows="3" maxlength="8000"></textarea></div>
    <div class="form-group"><label>Reference link</label><input class="form-control" type="url" name="ReferenceLink" id="editReferenceLink" maxlength="255"><div id="currentReference"></div></div><div class="form-group"><label>Thay tệp reference</label><input class="form-control" type="file" name="ReferenceFile" accept=".pdf,.doc,.docx,.ppt,.pptx,.jpg,.jpeg,.png,.webp"></div><div class="form-group"><label>Mô tả moodboard</label><textarea class="form-control" name="MoodboardDesc" id="editMoodboard" rows="2" maxlength="2000"></textarea><div id="currentMoodboard"></div></div><div class="form-group"><label>@(Model.IsManager ? "Thêm nhiều ảnh moodboard" : "Thay ảnh moodboard")</label>@if(Model.IsManager){<input class="form-control" type="file" name="MoodboardFiles" accept=".jpg,.jpeg,.png,.webp" multiple>}else{<input class="form-control" type="file" name="MoodboardFile" accept=".jpg,.jpeg,.png,.webp">}</div><div class="form-group wide"><label>Kho ảnh moodboard</label><div id="moodboardGallery" class="moodboard-gallery"></div></div><div class="form-group wide"><label>Script</label><textarea class="form-control" name="ScriptText" id="editScript" rows="5" maxlength="12000"></textarea></div>
  </div><div id="feedbackBox" class="message message-error" style="display:none"></div><div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px" id="editActions"><button class="btn-mini approve" type="submit">Lưu thay đổi</button></div></form>
  @if(Model.IsManager){<form asp-controller="ManageIdea" asp-action="ReviewIdea" method="post" id="reviewForm" style="display:none;border-top:1px solid var(--line);margin-top:18px;padding-top:16px"><input type="hidden" name="id" id="reviewId"><div class="form-group"><label>Nhận xét của Quản lý Ý tưởng</label><textarea class="form-control" name="feedback" rows="3" maxlength="2000" placeholder="Bắt buộc khi yêu cầu chỉnh sửa"></textarea></div><div style="display:flex;justify-content:flex-end;gap:8px"><button class="btn-mini reject" name="decision" value="revision" type="submit">Yêu cầu sửa</button><button class="btn-mini approve" name="decision" value="approve" type="submit">Duyệt ý tưởng</button></div></form>}
  <div style="border-top:1px solid var(--line);margin-top:18px;padding-top:16px"><strong>Trao đổi</strong><div id="commentList"></div><form asp-controller="@controllerName" asp-action="AddComment" method="post" style="margin-top:10px"><input type="hidden" name="id" id="commentIdeaId"><div style="display:flex;gap:8px"><textarea class="form-control" name="content" maxlength="2000" rows="2" required placeholder="Nhập bình luận hoặc phản hồi..."></textarea><button class="btn-mini approve" type="submit">Gửi</button></div></form></div>
  @if(Model.IsManager){<form asp-controller="ManageIdea" asp-action="DeleteMoodboardImage" method="post" id="deleteMoodboardForm" onsubmit="return confirm('Xóa ảnh moodboard này?')"><input type="hidden" name="imageId" id="deleteMoodboardImageId"><input type="hidden" name="ideaId" id="deleteMoodboardIdeaId"></form><div style="border-top:1px solid var(--line);margin-top:18px;padding-top:16px;display:flex;justify-content:space-between"><a class="btn-mini" id="assignTaskLink" href="/Tasks?module=Y_Tuong&create=true">Giao task liên quan</a><form asp-controller="ManageIdea" asp-action="DeleteIdea" method="post" onsubmit="return confirm('Xóa ý tưởng này?')"><input type="hidden" name="id" id="deleteIdeaId"><button class="btn-mini reject" type="submit">Xóa ý tưởng</button></form></div>}
</div><div class="modal-footer"><button class="btn-mini" type="button" onclick="closeModal('detailIdeaModal')">Đóng</button></div></div></div>

<script id="ideaData" type="application/json">@Html.Raw(ideasJson)</script><script>
  const ideas=JSON.parse(document.getElementById('ideaData').textContent);function openModal(id){document.getElementById(id)?.classList.add('active')}function closeModal(id){document.getElementById(id)?.classList.remove('active')}function setValue(id,value){const e=document.getElementById(id);if(e)e.value=value??''}function fileLink(path,label){return path?`<a class="file-link" href="${encodeURI(path)}" target="_blank"><i class="ti ti-paperclip"></i>${label}</a>`:''}function escapeHtml(value){const e=document.createElement('div');e.textContent=value??'';return e.innerHTML}
  function openIdea(id){const idea=ideas.find(x=>x.Id===id);if(!idea)return;document.getElementById('detailTitle').textContent=idea.Title;setValue('editId',idea.Id);setValue('editTitle',idea.Title);setValue('editCampaignId',idea.CampaignId);setValue('editDeadline',idea.Deadline);setValue('editPrimaryStaffId',idea.PrimaryStaffId);setValue('editReviewerEmployeeId',idea.ReviewerEmployeeId);setValue('editReviewerHidden',idea.ReviewerEmployeeId);setValue('detailStatus',idea.StatusLabel);setValue('editInsight',idea.Insight);setValue('editConcept',idea.Concept);setValue('editContent',idea.ContentDetails);setValue('editReferenceLink',idea.ReferenceLink);setValue('editMoodboard',idea.MoodboardDesc);setValue('editScript',idea.ScriptText);document.getElementById('currentReference').innerHTML=fileLink(idea.ReferenceFilePath,'Tệp reference hiện tại');document.getElementById('currentMoodboard').innerHTML=fileLink(idea.MoodboardFilePath,'Moodboard cũ');const gallery=document.getElementById('moodboardGallery');gallery.innerHTML=idea.MoodboardImages.length?idea.MoodboardImages.map(img=>`<div class="moodboard-item"><a href="${encodeURI(img.FileUrl)}" target="_blank"><img src="${encodeURI(img.FileUrl)}" alt="Moodboard"></a>@if(Model.IsManager){<button class="moodboard-remove" type="button" onclick="deleteMoodboard(${img.Id},${idea.Id})" title="Xóa ảnh">×</button>}</div>`).join(''):'<div class="idea-sub">Chưa có ảnh trong kho.</div>';document.querySelectorAll('#editIdeaForm input:not([type=hidden]):not([type=file]),#editIdeaForm textarea,#editIdeaForm select').forEach(e=>e.disabled=!idea.CanEdit);document.querySelectorAll('#editIdeaForm input[type=file]').forEach(e=>e.disabled=!idea.CanEdit);document.getElementById('editActions').style.display=idea.CanEdit?'flex':'none';const fb=document.getElementById('feedbackBox');fb.style.display=idea.FeedbackComment?'block':'none';fb.textContent=idea.FeedbackComment?`Phản hồi gần nhất: ${idea.FeedbackComment}`:'';const review=document.getElementById('reviewForm');if(review){review.style.display=idea.CanReview?'block':'none';setValue('reviewId',idea.Id)}setValue('commentIdeaId',idea.Id);setValue('deleteIdeaId',idea.Id);const task=document.getElementById('assignTaskLink');if(task)task.href=`/Tasks?module=Y_Tuong&employeeId=${idea.PrimaryStaffId??''}&create=true&relatedType=Idea&relatedId=${idea.Id}`;document.getElementById('commentList').innerHTML=idea.Comments.length?idea.Comments.map(c=>`<div class="comment"><div class="comment-meta"><strong>${escapeHtml(c.AuthorName)}</strong> · ${escapeHtml(c.AuthorRole)} · ${new Date(c.CreatedAt).toLocaleString('vi-VN')}</div><div>${escapeHtml(c.Content)}</div></div>`).join(''):'<div class="idea-sub" style="padding:10px 0">Chưa có trao đổi.</div>';openModal('detailIdeaModal')}
  function deleteMoodboard(imageId,ideaId){setValue('deleteMoodboardImageId',imageId);setValue('deleteMoodboardIdeaId',ideaId);document.getElementById('deleteMoodboardForm')?.requestSubmit()}
document.addEventListener('DOMContentLoaded',()=>{const focus=Number(new URLSearchParams(location.search).get('focus'));if(focus)openIdea(focus)});
</script></body></html>
