@using System.Security.Claims
@using HanaMedia.Constants
@{
    var role = User.FindFirstValue(ClaimTypes.Role) ?? string.Empty;
    var currentPath = (ViewContext?.HttpContext?.Request?.Path.Value ?? string.Empty).TrimEnd('/').ToLowerInvariant();

    bool IsActive(string url)
    {
        var path = (url ?? string.Empty).TrimEnd('/').ToLowerInvariant();
        if (string.IsNullOrEmpty(path)) return false;
        if (string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase)) return true;
        return currentPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
    }

    string ActiveClass(string url) => IsActive(url) ? "nav-item active" : "nav-item";
}

<link rel="stylesheet" href="~/css/tabler-icons/tabler-icons.min.css" />

<aside class="sidebar">
  <div class="brand">
    <div class="brand-mark">HM</div>
    <div>
      <div class="brand-name">HanaMedia</div>
      <div class="brand-sub">Hệ thống Quản lý Nhân sự</div>
    </div>
  </div>

  <div class="sidebar-nav">

  @if (role == AppRoles.Director)
  {
    <div class="nav-section">Tổng quan</div>
    <a href="/Director/Dashboard" class="@ActiveClass("/Director/Dashboard")"><i class="ti ti-layout-dashboard"></i>Dashboard</a>
    <a href="/Tasks" class="@ActiveClass("/Tasks")"><i class="ti ti-checklist"></i>Phân công &amp; Duyệt việc</a>
    <a href="/Director/Report" class="@ActiveClass("/Director/Report")"><i class="ti ti-report-analytics"></i>Báo cáo</a>

    <div class="nav-section">Nghiệp vụ</div>
    <a href="/Director/HumanResources" class="@ActiveClass("/Director/HumanResources")"><i class="ti ti-users"></i>Nhân sự</a>
