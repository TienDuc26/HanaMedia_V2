    <a href="/Campaigns" class="@ActiveClass("/Campaigns")"><i class="ti ti-rocket"></i>Chiến dịch</a>
    <a href="/Kols" class="@ActiveClass("/Kols")"><i class="ti ti-users-group"></i>Cơ sở dữ liệu KOL</a>
    <a href="/Bookings" class="@ActiveClass("/Bookings")"><i class="ti ti-checklist"></i>Giám sát Booking</a>
