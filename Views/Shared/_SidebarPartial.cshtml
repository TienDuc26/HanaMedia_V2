    <a href="/IdeaStaff/Reported" class="@ActiveClass("/IdeaStaff/Reported")"><i class="ti ti-report-analytics"></i>Báo cáo hiệu suất</a>
  }
  else
  {
    <div class="nav-section">Điều hướng</div>
    <a href="/" class="@ActiveClass("/")"><i class="ti ti-layout-dashboard"></i>Trang chủ</a>
  }
  </div>

  <div class="sidebar-user">
  <partial name="_UserMenuPartial" />
  </div>
</aside>
