<div class="sidebar-footer">
  <div class="role-pill user-menu-trigger" onclick="toggleUserMenu(event)">
    <div class="avatar">@avatar</div>
    <div>
      <div class="role-name">@username</div>
      <div class="role-title">@roleDisplay</div>
    </div>
    <i class="fa-solid fa-chevron-down user-menu-chevron" id="userMenuChevron"></i>
  </div>

  <div class="user-menu-dropdown" id="userMenuDropdown" style="display:none;">
    <button type="button" class="user-menu-item" onclick="openChangePasswordModal()">
      <i class="fa-solid fa-key"></i>
      <span>Đổi mật khẩu</span>
    </button>
    <a href="/Logout" class="user-menu-item user-menu-logout" id="logoutLink">
      <i class="fa-solid fa-right-from-bracket"></i>
      <span>Đăng xuất</span>
    </a>
  </div>
</div>

<div id="changePasswordModal" style="display:none;">
  <div class="cp-overlay" onclick="if(event.target===this) closeChangePasswordModal()">
    <div class="cp-box" role="dialog" aria-labelledby="cp-title">
      <div class="cp-head">
        <div>
          <div class="cp-title" id="cp-title">Đổi mật khẩu</div>
          <p class="cp-sub">Vui lòng nhập đầy đủ thông tin bên dưới</p>
        </div>
        <button type="button" class="cp-close" onclick="closeChangePasswordModal()" aria-label="Đóng">&times;</button>
      </div>

      <form id="changePasswordForm" onsubmit="return submitChangePassword(event)">
        <div class="cp-field">
          <label class="cp-label" for="cp_current">Mật khẩu hiện tại</label>
          <input type="password" id="cp_current" name="currentPassword" class="cp-input" placeholder="Nhập mật khẩu hiện tại..." required />
        </div>

        <div class="cp-field">
          <label class="cp-label" for="cp_new">Mật khẩu mới</label>
          <input type="password" id="cp_new" name="newPassword" class="cp-input" placeholder="Nhập mật khẩu mới (tối thiểu 8 ký tự)..." required minlength="8" />
        </div>

        <div class="cp-field">
          <label class="cp-label" for="cp_confirm">Xác nhận mật khẩu mới</label>
          <input type="password" id="cp_confirm" name="confirmPassword" class="cp-input" placeholder="Nhập lại mật khẩu mới..." required minlength="8" />
        </div>

        <div id="cp_error" class="cp-error"></div>
        <div id="cp_success" class="cp-success"></div>

        <div class="cp-actions">
          <button type="button" class="cp-btn cp-btn-secondary" onclick="closeChangePasswordModal()">Hủy</button>
          <button type="submit" class="cp-btn cp-btn-primary" id="cp_submit_btn">Đổi mật khẩu</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function toggleUserMenu(e) {
  e.stopPropagation();
  var dd = document.getElementById('userMenuDropdown');
  var chev = document.getElementById('userMenuChevron');
  if (!dd) return;
  var open = dd.style.display === 'block';
  dd.style.display = open ? 'none' : 'block';
  if (chev) chev.style.transform = open ? '' : 'rotate(180deg)';
}
document.addEventListener('click', function(e) {
  var dd = document.getElementById('userMenuDropdown');
  var trigger = e.target.closest('.user-menu-trigger');
  if (!trigger && dd && dd.style.display === 'block') {
    dd.style.display = 'none';
    var chev = document.getElementById('userMenuChevron');
    if (chev) chev.style.transform = '';
  }
});

function openChangePasswordModal() {
  var dd = document.getElementById('userMenuDropdown');
  if (dd) dd.style.display = 'none';
  var chev = document.getElementById('userMenuChevron');
  if (chev) chev.style.transform = '';
  document.getElementById('changePasswordModal').style.display = 'block';
  var f = document.getElementById('cp_current');
  if (f) setTimeout(function() { f.focus(); }, 50);
}

function closeChangePasswordModal() {
  var m = document.getElementById('changePasswordModal');
  if (m) m.style.display = 'none';
  var form = document.getElementById('changePasswordForm');
  if (form) form.reset();
  var err = document.getElementById('cp_error');
  if (err) err.style.display = 'none';
  var ok = document.getElementById('cp_success');
  if (ok) ok.style.display = 'none';
  var btn = document.getElementById('cp_submit_btn');
  if (btn) { btn.disabled = false; btn.textContent = 'Đổi mật khẩu'; }
}

async function submitChangePassword(e) {
  e.preventDefault();
  var currentPassword = document.getElementById('cp_current').value;
  var newPassword = document.getElementById('cp_new').value;
  var confirmPassword = document.getElementById('cp_confirm').value;

  var errBox = document.getElementById('cp_error');
  var okBox = document.getElementById('cp_success');
  errBox.style.display = 'none';
  okBox.style.display = 'none';

  if (!currentPassword || !newPassword || !confirmPassword) {
    errBox.textContent = 'Vui lòng nhập đầy đủ cả 3 trường.';
    errBox.style.display = 'block';
    return false;
  }
  if (newPassword.length < 8) {
    errBox.textContent = 'Mật khẩu mới phải có ít nhất 8 ký tự.';
    errBox.style.display = 'block';
    return false;
  }
  if (newPassword !== confirmPassword) {
    errBox.textContent = 'Mật khẩu mới và Xác nhận mật khẩu không khớp nhau.';
    errBox.style.display = 'block';
    return false;
  }
  if (newPassword === currentPassword) {
    errBox.textContent = 'Mật khẩu mới phải khác mật khẩu hiện tại.';
    errBox.style.display = 'block';
    return false;
  }

  var btn = document.getElementById('cp_submit_btn');
  btn.disabled = true;
  btn.textContent = 'Đang xử lý...';

  try {
    // TODO: nối API đổi mật khẩu thật khi backend sẵn sàng
    var result = await mockChangePassword(currentPassword, newPassword);
    if (result.success) {
      okBox.textContent = 'Đổi mật khẩu thành công! (Mock — backend chưa nối)';
      okBox.style.display = 'block';
      setTimeout(closeChangePasswordModal, 1500);
    } else {
      errBox.textContent = result.message || 'Đổi mật khẩu thất bại.';
      errBox.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Đổi mật khẩu';
    }
  } catch (ex) {
    errBox.textContent = 'Lỗi: ' + ex.message;
    errBox.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Đổi mật khẩu';
  }
  return false;
}

// TODO: nối API đổi mật khẩu thật khi backend sẵn sàng
async function mockChangePassword(currentPassword, newPassword) {
  console.log('[ChangePassword] Mock — current:', currentPassword, 'new:', newPassword);
  await new Promise(function(r) { setTimeout(r, 500); });
  return { success: true, message: 'OK (mock)' };
}

document.addEventListener('DOMContentLoaded', function() {
  // Move modal ra document.body để thoát khỏi stacking context của sidebar
  var modal = document.getElementById('changePasswordModal');
  if (modal && modal.parentElement !== document.body) {
    document.body.appendChild(modal);
  }

  var link = document.getElementById('logoutLink');
  if (link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      try { window.history.replaceState(null, '', '/Login'); } catch (err) {}
      window.location.replace('/Logout');
    });
  }
});
</script>
