  border-radius: 8px;
  font-size: 13.5px;
  margin-top: 8px;
  font-weight: 500;
  display: none;
}
#changePasswordModal .cp-error { color: #b42318; background: #fef3f2; border: 1px solid rgba(180, 35, 24, .2); }
#changePasswordModal .cp-success { color: #1ca36b; background: #e6f7ee; border: 1px solid rgba(28, 163, 107, .2); }
#changePasswordModal .cp-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 22px;
}
